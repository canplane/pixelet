{
  // Deno takes nothing at the root. Each tree is a root of its own with its
  // own config (ts/, script/, xpute/), and what lies outside them, the
  // documents and the data, is formatted by no one. Without this, deno fmt or
  // deno lint run here, or an editor's Deno on save, would take the whole
  // repository at Deno's defaults, the trees' configs unread. A config under
  // a tree is its own, never this one's member.
  "exclude": ["./"],
  "lock": false
}
