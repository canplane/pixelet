{
  "description": "A droplet fades. A pixelet remains.",

  // Routes only. Each tree is a root of its own: ts/ the TypeScript
  // workspace (ts/deno.jsonc), script/ the repository's own scripts, rust/
  // Cargo's, and xpute/ a project of its own (xpute/Makefile). Here are the
  // tasks that run over them, and the format of what is no tree's: the
  // documents, spec/, infra/ and asset/.
  "workspace": [],
  "lock": false,

  "exclude": ["ts/", "script/", "rust/", "xpute/", "out/", "infra/geo/elevation/warped/"],

  "tasks": {
    // Run here. Where the tiles come from, a bakery's three: `dev` has them
    // delivered, every route the published deployment's, so not for bake work,
    // its tile prefix frozen; `dev:oven` bakes each on demand; `dev:shelf`
    // takes each kind's set under ./out. The two local ones run the three
    // servers beside the client.
    "dev": { "command": "deno task --cwd ts/app/web dev", "dependencies": ["sync:build-number"] },
    "dev:oven": { "command": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tile) & (deno task --cwd ts/app/web dev:oven) & wait\"", "dependencies": ["sync:build-number"] },
    "dev:shelf": {
      "command": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tile --shelf ./out) & (deno task --cwd ts/app/web dev:shelf) & wait\"",
      "dependencies": ["sync:build-number"]
    },
    // The `server` profile: a debug build's rasterizer is felt on every page.
    "dev:geo": "./script/tool.ts serve geo",
    "dev:api": "./script/tool.ts serve api",
    "dev:tile": "./script/tool.ts serve tile",
    "dev:native": "deno task --cwd ts/app/native start",
    // Measure the client here: the dev server's unbundled modules are not what ships.
    "preview": "deno task --cwd ts/app/web preview",
    "preview:oven": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tile) & (deno task --cwd ts/app/web preview:oven) & wait\"",
    "preview:shelf": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tile --shelf ./out) & (deno task --cwd ts/app/web preview:shelf) & wait\"",
    // A purge by command, after a re-ingest or a bake change: the oven's cache
    // whole; the shelf's sets, each kind named or all three, with what is staged.
    "clear:oven": "rm -rf out/oven",
    "clear:shelf": "sh -c '[ $# -gt 0 ] || set -- terrain place division; for k; do rm -rf \"out/$k\" \"out/$k.stage\" \"out/$k.publish\"; done' --",

    // What makes the repository's data, a binary each (script/tool.ts):
    // `bake <terrain|place|division|earth|star|geoid>`, `download <pack|moon|earth|star>`.
    // A tile bake takes the shards it is told (--shard; every one when none is).
    "bake": "./script/tool.ts bake",
    "download": "./script/tool.ts download",
    // After any change under asset/content/:
    "ingest:asset": "cd rust && cargo run -p pxl-tool --bin ingest_asset",
    // By hand, when ts/client/brand's symbol changes: its outline, which both
    // apps bundle. The page's icons are made by its build (ts/app/web build:brand).
    "render:brand": "cd rust && cargo run -p pxl-tool --bin render_brand -- --symbol",

    // Made from the tree: the code generated from spec/, the kernel's module.
    "spec": "cd rust && cargo spec --write",
    "build:wasm": "deno task --cwd ts/app/web build:wasm",

    // `check` is everything, and with `test` what passes before a push to
    // deploy, since CI checks nothing (.agents/skills/deploy/SKILL.md).
    // `check:ship` is what ships: it type-checks, lints, builds (the client's
    // bundle and the Worker's, as a deploy makes them) and is what its JSON
    // writes, and the scripts a deploy runs type-check.
    "check": "deno task check:style && deno task check:ship && deno task check:native && deno task check:host && deno task check:xpute",
    "check:ship": "deno task check:web && deno task check:script && deno task check:rust && deno task check:spec && deno task --cwd ts/server/edge check:build",
    "check:style": "deno task check:fmt && deno task check:rules && deno task lint",
    "check:diff": "./script/check-diff.ts",
    "check:fmt": "deno fmt --check && deno task --cwd ts fmt --check && deno task --cwd script fmt --check && cd rust && cargo fmt --all --check",
    "check:web": "deno task --cwd ts/app/web check",
    // The tree's own scripts, which `deno run` runs unchecked.
    "check:script": "deno task --cwd script check && deno check --config ts/deno.jsonc ts/app/web/script/*.ts ts/server/edge/script/*.ts",
    // check:web never reaches the device's own modules.
    "check:native": "deno task --cwd ts/app/native check && cd rust && cargo lint-ios && cargo lint-android",
    "check:xpute": "make -C xpute -j8 check",
    // What ships: the kernel's module in both builds, and the servers with their tests' code.
    "check:rust": "cd rust && cargo lint-guest && cargo lint-guest-published && cargo lint-server",
    // What runs here alone: the tests' code, the bakes (the tile server's
    // feature with them, which only adds) and the tools.
    "check:host": "cd rust && cargo lint-host",
    "check:rules": "./script/check-rules.ts",
    "check:spec": "cd rust && cargo spec",
    "test": "deno task test:client && deno task test:xpute && deno task test:rust",
    "test:client": "deno task --cwd ts/client test",
    "test:xpute": "make -C xpute -j8 test",
    // pxl-tool holds every model to the committed table, which has been wrong by hand before.
    "test:rust": "cd rust && cargo test-host && cargo test-kernel-published && cargo test-bake-serve",
    "lint": "deno task --cwd ts lint && deno task --cwd script lint",
    "fmt": "deno fmt && deno task --cwd ts fmt && deno task --cwd script fmt",

    // The deployment. Does not upload what the bucket holds.
    "deploy": "deno task --cwd ts/server/edge deploy",
    // Against a running deployment, not a checkout.
    "smoke": "./ts/app/web/script/smoke.ts",
    // Reads with wrangler's login and hcloud's context.
    "usage": "./script/usage.ts",
    // A bake's publish stage into the bucket under a new name; deploy after.
    "publish": "./ts/app/web/script/publish.ts",

    // The rest.
    "export:xpute": "./xpute/script/export.ts",
    // ts/client/.build_number is written by any read of the build log, so it is refreshed before vite reads it.
    "sync:build-number": "sh -c './script/build-log.ts >/dev/null || echo \"[build-number] not synced: this build is labeled from the cached number\" >&2'"
  },

  "fmt": {
    "lineWidth": 200,
    "proseWrap": "preserve",

    // Carto's symbols stay as Carto ships them.
    "exclude": ["asset/raw/place/symbol/"]
  }
}
