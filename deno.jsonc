{
  "description": "A droplet fades. A pixelet remains.",

  // The format of what is no tree's: the documents, spec/, infra/ and asset/.
  // The routes are the Makefile's; each tree is a root of its own, ts/ and
  // script/ with their own configs. A root lists no members, so a config
  // under it is never taken for one.
  "workspace": [],
  "lock": false,

  "exclude": ["ts/", "script/", "rust/", "xpute/", "out/", "infra/geo/elevation/warped/"],

  "fmt": {
    "lineWidth": 200,
    "proseWrap": "preserve",

    // Carto's symbols stay as Carto ships them.
    "exclude": ["asset/raw/place/symbol/"]
  }
}
