{
  "description": "A droplet fades. A pixelet remains.",

  "workspace": [
    "apps/web",

    "packages/xpute/core",
    "packages/xpute/runtime"
  ],
  "nodeModulesDir": "auto",

  // Keeps Deno's config-tree walker (LSP + CLI) from wandering into build
  // caches that carry their own package.json — Vite's deps optimizer cache
  // in particular gets misread as a rogue workspace member ("Config file
  // must be a member of the workspace") since it's nested under apps/web.
  //
  // `out/` is the bake's, and nothing in it is this repository's source: a
  // bare `deno check` walked as far as a JavaScript file pip had vendored
  // inside the Overture ingest's Python virtual environment. .gitignore
  // already says the tree is output, but that is git's list and not this
  // one, and the two have to be told separately.
  "exclude": ["**/.vite/", "**/dist/", "**/node_modules/", "out/"],

  "tasks": {
    // ── Run it locally ──
    // The `server` profile, not a debug build: the rasterizer under one is
    // slow enough to be felt on every page.
    // The client alone, every route answered by the published deployment: no
    // Docker, no database, no server process. Not usable for bake work — a
    // published tile prefix is frozen.
    "dev": { "command": "deno task --cwd apps/web dev", "dependencies": ["sync:build-number"] },
    // The whole stack on this machine instead.
    "dev:local": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tiles) & (deno task dev:web) & wait\"",
    "dev:geo": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server -p pxl-geo -- \"$@\"' --",
    "dev:api": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server -p pxl-api -- \"$@\"' --",
    "dev:tiles": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server --features serve --bin serve_tiles -- \"$@\"' --",
    "dev:web": { "command": "deno task --cwd apps/web dev:local", "dependencies": ["sync:build-number"] },
    // The number a dev build labels itself after is the last published one
    // this checkout has seen, cached in apps/web/.build_number — and
    // vite.config.ts reads it once, as it starts. Nothing else writes it but
    // a hand deploy, so a checkout that ships through CI alone drifts behind
    // by however many builds went out. Reading the log writes the cache
    // (script/build-log.ts), so the read goes before the server starts.
    // It is a bucket read: it needs the network and wrangler's credentials,
    // and where it cannot have them the server still starts on the cached
    // number and says so.
    "sync:build-number": "sh -c './script/build-log.ts >/dev/null || echo \"[build-number] not synced: this build is labelled from the cached number\" >&2'",
    // The production bundle at localhost:4173 on the same data: what to
    // measure the client against, since the dev server's unbundled modules
    // and hooks are not in it.
    "preview": "deno task --cwd apps/web preview",

    // ── Fill the bucket ──
    // Terrain and geocode resume; POI writes one immutable summary snapshot.
    "bake:tiles": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server --bin bake_tiles -- \"$@\"' --",
    "bake:poi": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server --bin bake_poi_tiles -- \"$@\"' --",
    "bake:geocode": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server --bin bake_geocode_tiles -- \"$@\"' --",

    // ── Ship it ──
    "build:wasm": "deno task --cwd apps/web build:wasm",
    "build:web": "deno task --cwd apps/web build",
    // Does not upload what the bucket holds.
    "deploy": "deno task --cwd apps/web deploy",
    // Against a running deployment, not a checkout.
    "smoke": "./script/smoke.ts",

    // ── The gate ──
    "check": "deno task check:fmt && deno task check:toolchain && deno task check:web && deno task check:xpute && deno task check:rust && deno task check:spec",
    // What check:rust's own `cargo fmt --check` does for the Rust: everything
    // Deno formats — TypeScript, JSON, JSONC, Markdown — held to one shape.
    // Without it the two languages were gated unevenly, and the half nothing
    // ran was where a config broke and sat broken.
    "check:fmt": "deno fmt --check",
    "check:web": "deno task --cwd apps/web check",
    "check:xpute": "deno check packages/xpute/core/src/**/*.ts && deno check packages/xpute/runtime/src/**/*.ts",
    // The wasm32 pass builds libraries only, so a broken `.test.rs` still
    // passes it; the host pass is what compiles those. geo-bake runs twice
    // because `serve` gates the dev tile server, and pxl-wasm twice because
    // the published module is built without `dev` (build-wasm.ts).
    "check:rust": "cargo fmt --manifest-path crates/Cargo.toml --all --check && cargo clippy --manifest-path crates/Cargo.toml --target wasm32-unknown-unknown -p xpute-core -p xpute-runtime -p pxl-spec -p pxl-render -p pxl-kernel -p pxl-wasm -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --all-targets -p pxl-geo-spec -p pxl-server -p pxl-geo -p pxl-geo-bake -p pxl-api -- -D warnings && cargo clippy --manifest-path asset/script/Cargo.toml --all-targets -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --all-targets -p pxl-geo-bake --features serve -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --all-targets -p xpute-core -p xpute-runtime -p pxl-spec -p pxl-render -p pxl-kernel -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --target wasm32-unknown-unknown -p pxl-wasm --no-default-features -- -D warnings",
    // Before anything compiles: a Rust version written twice is a binary
    // built on a compiler the gate never ran.
    "check:toolchain": "./script/check-toolchain.ts",
    "check:spec": "./script/spec.ts",
    // The write half of it: the same generator, allowed to touch the tree.
    "spec": "./script/spec.ts --write",

    "test": "deno task test:web && deno task test:xpute && deno task test:rust && deno task test:asset",
    "test:web": "deno task --cwd apps/web test",
    "test:xpute": "deno test -A packages/xpute/core/src && deno test -A packages/xpute/runtime/src",
    "test:rust": "cargo test --manifest-path crates/Cargo.toml -p xpute-core -p xpute-runtime -p pxl-spec -p pxl-render -p pxl-kernel -p pxl-geo-spec -p pxl-server -p pxl-geo -p pxl-geo-bake -p pxl-api && cargo test --manifest-path crates/Cargo.toml -p pxl-kernel --no-default-features && cargo test --manifest-path crates/Cargo.toml -p pxl-geo-bake --features serve",
    // Every shipped model measured from its file and held against the table the
    // ingest wrote. The table is committed, and it has been wrong by hand before.
    "test:asset": "cargo test --manifest-path asset/script/Cargo.toml",

    "lint": "deno lint",

    // xpute is developed here and copied out whole; see script/export-xpute.ts.
    "export:xpute": "./script/export-xpute.ts",
    "fmt": "deno fmt",

    // ── Start over ──
    // Named paths only; nothing is found by name and deleted.
    "reset": "rm -rf node_modules apps/web/node_modules apps/web/dist && deno task check"
  },

  "compilerOptions": {
    "lib": ["deno.window", "deno.ns", "deno.unstable", "esnext"],
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "checkJs": false
    // "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,
  },

  "imports": {
    "@xpute/core/": "./packages/xpute/core/src/",
    "@xpute/runtime/": "./packages/xpute/runtime/src/",

    // testing
    "@std/assert": "jsr:@std/assert@^1",

    // script/spec.ts, apps/web/script/locale.ts
    "@std/path": "jsr:@std/path@^1",

    // build tools
    "vite": "npm:vite@^8.3.0",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",

    // internationalization
    "i18next": "npm:i18next@^26.4.2"
  },

  "fmt": {
    "lineWidth": 200,
    "proseWrap": "preserve",

    // The golden records are committed as they were written and read byte
    // for byte by the tests; formatting them would break that.
    "exclude": ["node_modules/", "dist/", "crates/**/golden/"]
  },

  "lint": {
    "rules": { "tags": ["recommended"] },

    "exclude": ["node_modules/", "dist/"]
  }
}
