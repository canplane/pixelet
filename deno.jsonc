{
  "description": "A droplet fades. A pixelet remains.",

  "workspace": [
    "apps/web",
    // A package.json member: Expo and Metro find packages the npm way.
    "apps/native",

    "packages/xpute/core",
    "packages/xpute/runtime",
    "packages/xpute/conformance"
  ],
  "nodeModulesDir": "auto",

  // Vite's deps cache and the Python venv under `out/` would be read as this workspace's.
  "exclude": ["**/.vite/", "**/dist/", "**/node_modules/", "out/"],

  "tasks": {
    // Every route is the published deployment's, so not for bake work: its tile prefix is frozen.
    "dev": { "command": "deno task --cwd apps/web dev", "dependencies": ["sync:build-number"] },
    "dev:local": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tiles) & (deno task dev:web) & wait\"",
    // The `server` profile: a debug build's rasterizer is felt on every page.
    "dev:geo": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server -p pxl-geo -- \"$@\"' --",
    "dev:api": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server -p pxl-api -- \"$@\"' --",
    "dev:tiles": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server --features serve --bin serve_tiles -- \"$@\"' --",
    "dev:web": { "command": "deno task --cwd apps/web dev:local", "dependencies": ["sync:build-number"] },
    "dev:web:baked": { "command": "deno task --cwd apps/web dev:baked", "dependencies": ["sync:build-number"] },
    "dev:baked": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tiles --baked ./out) & (deno task dev:web:baked) & wait\"",
    "dev:native": "deno task --cwd apps/native start",
    // Only a hand deploy writes apps/web/.build_number, so it is refreshed before vite reads it.
    "sync:build-number": "sh -c './script/build-log.ts >/dev/null || echo \"[build-number] not synced: this build is labeled from the cached number\" >&2'",
    // Measure the client here: the dev server's unbundled modules are not what ships.
    "preview": "deno task --cwd apps/web preview",
    "preview:local": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tiles) & (deno task preview:web) & wait\"",
    "preview:baked": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tiles --baked ./out) & (deno task preview:web) & wait\"",
    "preview:web": "deno task --cwd apps/web preview:local",

    // Terrain and geocode resume; POI writes one immutable snapshot.
    "bake:tiles": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server --bin bake_tiles -- \"$@\"' --",
    "bake:poi": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server --bin bake_poi_tiles -- \"$@\"' --",
    "bake:geocode": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server --bin bake_geocode_tiles -- \"$@\"' --",

    // After any change under asset/.
    "ingest:asset": "cargo run --manifest-path crates/Cargo.toml -p pxl-tool --bin ingest_asset",
    // By hand, when a source outside the repository or under apps/web/brand changes.
    "download:pack": "cargo run --manifest-path crates/Cargo.toml -p pxl-tool --bin download_texture_pack",
    "download:moon": "cargo run --manifest-path crates/Cargo.toml -p pxl-tool --bin download_moon",
    "download:earth": "cargo run --manifest-path crates/Cargo.toml -p pxl-tool --bin download_earth",
    "bake:stars": "cargo run --manifest-path crates/Cargo.toml -p pxl-tool --bin bake_stars --",
    "render:brand": "cargo run --manifest-path crates/Cargo.toml -p pxl-tool --bin render_brand",

    "build:wasm": "deno task --cwd apps/web build:wasm",
    "build:web": "deno task --cwd apps/web build",
    // Does not upload what the bucket holds.
    "deploy": "deno task --cwd apps/web deploy",
    // Against a running deployment, not a checkout.
    "smoke": "./script/smoke.ts",
    // Reads with wrangler's login and hcloud's context.
    "usage": "./script/usage.ts",

    "check": "deno task check:fmt && deno task check:toolchain && deno task check:rules && deno task check:web && deno task check:native && deno task check:xpute && deno task check:rust && deno task check:cpp && deno task check:spec",
    "check:diff": "./script/check-diff.ts",
    "check:fmt": "deno fmt --check",
    "check:web": "deno task --cwd apps/web check",
    // check:web never reaches the device's own modules.
    "check:native": "deno check apps/native/src",
    "check:xpute": "deno check packages/xpute/core/src/**/*.ts && deno check packages/xpute/runtime/src/**/*.ts && deno check packages/xpute/conformance/src/**/*.ts",
    "check:cpp": "./script/cpp.ts check",
    // The wasm32 pass builds no `.test.rs`; the host pass does.
    "check:rust": "cargo fmt --manifest-path crates/Cargo.toml --all --check && cargo clippy --manifest-path crates/Cargo.toml --target aarch64-apple-ios -p pxl-native -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --target aarch64-linux-android -p pxl-native --no-default-features -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --target wasm32-unknown-unknown -p xpute-core -p xpute-runtime -p xpute-conformance -p pxl-spec -p pxl-render -p pxl-kernel -p pxl-wasm -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --all-targets -p pxl-geo-spec -p pxl-server -p pxl-geo -p pxl-geo-bake -p pxl-api -p pxl-tool -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --all-targets -p pxl-geo-bake --features serve -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --all-targets -p xpute-core -p xpute-runtime -p xpute-conformance -p pxl-spec -p pxl-render -p pxl-kernel -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --target wasm32-unknown-unknown -p pxl-wasm --no-default-features -- -D warnings",
    // A Rust version written twice is a binary built on a compiler the gate never ran.
    "check:toolchain": "./script/check-toolchain.ts",
    "check:rules": "./script/check-rules.ts",
    "check:spec": "cargo run -q --manifest-path crates/Cargo.toml -p pxl-tool --bin spec",
    "spec": "cargo run -q --manifest-path crates/Cargo.toml -p pxl-tool --bin spec -- --write",

    "test": "deno task test:web && deno task test:xpute && deno task test:rust && deno task test:cpp",
    "test:web": "deno task --cwd apps/web test",
    "test:xpute": "deno test -A packages/xpute/core/src && deno test -A packages/xpute/runtime/src && cargo build --manifest-path crates/Cargo.toml -p xpute-conformance && cargo build --manifest-path crates/Cargo.toml -p xpute-conformance --target wasm32-unknown-unknown && ./script/cpp.ts guest && ./script/cpp.ts wasm && deno test -A packages/xpute/conformance/src",
    "test:cpp": "./script/cpp.ts test",
    // pxl-tool holds every model to the committed table, which has been wrong by hand before.
    "test:rust": "cargo test --manifest-path crates/Cargo.toml -p xpute-core -p xpute-runtime -p pxl-spec -p pxl-render -p pxl-kernel -p pxl-geo-spec -p pxl-server -p pxl-geo -p pxl-geo-bake -p pxl-api -p pxl-tool && cargo test --manifest-path crates/Cargo.toml -p pxl-kernel --no-default-features && cargo test --manifest-path crates/Cargo.toml -p pxl-geo-bake --features serve",

    "lint": "deno lint",

    "export:xpute": "./script/export-xpute.ts",
    "fmt": "deno fmt",

    // Named paths only; nothing is found by name and deleted.
    "reset": "rm -rf node_modules apps/web/node_modules apps/web/dist && deno task check"
  },

  "compilerOptions": {
    "lib": ["deno.window", "deno.ns", "deno.unstable", "esnext"],
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "checkJs": false
    // "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,
  },

  "imports": {
    "@xpute/core/": "./packages/xpute/core/src/",
    "@xpute/runtime/": "./packages/xpute/runtime/src/",
    "@xpute/conformance/": "./packages/xpute/conformance/src/",

    "@std/assert": "jsr:@std/assert@^1",

    "@std/path": "jsr:@std/path@^1",
    "@std/jsonc": "jsr:@std/jsonc@^1",

    "vite": "npm:vite@^8.3.0",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",

    "i18next": "npm:i18next@^26.4.2"
  },

  "fmt": {
    "lineWidth": 200,
    "proseWrap": "preserve",

    // The tests read the golden records byte for byte.
    "exclude": ["node_modules/", "dist/", "crates/**/golden/", "spec/xpute/golden/"]
  },

  "lint": {
    "rules": { "tags": ["recommended"] },

    "exclude": ["node_modules/", "dist/"]
  }
}
