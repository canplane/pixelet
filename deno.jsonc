{
  "description": "A droplet fades. A pixelet remains.",

  "workspace": [
    "apps/web",
    // A package.json member: Expo and Metro find packages the npm way.
    "apps/native"
  ],
  "nodeModulesDir": "auto",

  // Vite's deps cache and the trees of generated or downloaded data are no workspace source;
  // xpute/ is its own workspace, reached through the import map below.
  "exclude": ["xpute/", "**/.vite/", "**/dist/", "**/node_modules/", "out/", "cache/", "infra/geo/elevation/warped/"],

  "tasks": {
    // Run here. Where the tiles come from, a bakery's three: `dev` has them
    // delivered, every route the published deployment's, so not for bake work,
    // its tile prefix frozen; `dev:oven` bakes each on demand; `dev:shelf`
    // takes each kind's set under ./out. The two local ones run the three
    // servers beside the client.
    "dev": { "command": "deno task --cwd apps/web dev", "dependencies": ["sync:build-number"] },
    "dev:oven": { "command": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tile) & (deno task --cwd apps/web dev:oven) & wait\"", "dependencies": ["sync:build-number"] },
    "dev:shelf": {
      "command": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tile --shelf ./out) & (deno task --cwd apps/web dev:shelf) & wait\"",
      "dependencies": ["sync:build-number"]
    },
    // The `server` profile: a debug build's rasterizer is felt on every page.
    "dev:geo": "./script/with-env.sh cargo run --manifest-path crates/Cargo.toml --profile server -p pxl-geo --",
    "dev:api": "./script/with-env.sh cargo run --manifest-path crates/Cargo.toml --profile server -p pxl-api --",
    "dev:tile": "./script/with-env.sh cargo run --manifest-path crates/Cargo.toml --profile server --features serve --bin serve_tiles --",
    "dev:native": "deno task --cwd apps/native start",
    // Measure the client here: the dev server's unbundled modules are not what ships.
    "preview": "deno task --cwd apps/web preview",
    "preview:oven": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tile) & (deno task --cwd apps/web preview:oven) & wait\"",
    "preview:shelf": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tile --shelf ./out) & (deno task --cwd apps/web preview:shelf) & wait\"",
    // A purge by command, after a re-ingest or a bake change: the oven's cache
    // whole; the shelf's sets, each kind named or all three, with what is staged.
    "clear:oven": "rm -rf cache/tile",
    "clear:shelf": "sh -c '[ $# -gt 0 ] || set -- terrain place division; for k; do rm -rf \"out/$k\" \"out/$k.stage\" \"out/$k.publish\"; done' --",

    // Tiles, from db-geo: each bakes the shards it is told (--shard; every one
    // when none is) into its set.
    "bake:terrain": "./script/with-env.sh cargo run --manifest-path crates/Cargo.toml --profile server --bin bake_terrain --",
    "bake:place": "./script/with-env.sh cargo run --manifest-path crates/Cargo.toml --profile server --bin bake_place --",
    "bake:division": "./script/with-env.sh cargo run --manifest-path crates/Cargo.toml --profile server --bin bake_division --",
    "bake:earth": "cargo run --manifest-path crates/Cargo.toml --profile server -p pxl-geo-bake --bin bake_earth",

    // Assets. After any change under asset/:
    "ingest:asset": "cargo run --manifest-path crates/Cargo.toml -p pxl-tool --bin ingest_asset",
    // By hand, when a source outside the repository or under apps/web/brand changes.
    "download:pack": "cargo run --manifest-path crates/Cargo.toml -p pxl-tool --bin download_texture_pack",
    "download:moon": "cargo run --manifest-path crates/Cargo.toml -p pxl-tool --bin download_moon",
    "bake:star": "cargo run --manifest-path crates/Cargo.toml -p pxl-tool --bin bake_star --",
    "bake:geoid": "cargo run --release --manifest-path crates/Cargo.toml -p pxl-tool --bin bake_geoid --",
    "render:brand": "cargo run --manifest-path crates/Cargo.toml -p pxl-tool --bin render_brand",

    // Made from the tree: the code generated from spec/, the kernel's module.
    "spec": "cargo run -q --manifest-path crates/Cargo.toml -p pxl-tool --bin spec -- --write",
    "build:wasm": "deno task --cwd apps/web build:wasm",

    // `check` is everything; `check:ship` is what a deploy waits on — what it
    // ships compiles, lints and is what its JSON writes. Style, the device,
    // the bakes, the tests' own code and xpute's checks are local.
    "check": "deno task check:style && deno task check:ship && deno task check:native && deno task check:host && deno task check:xpute",
    "check:ship": "deno task check:toolchain && deno task check:web && deno task check:rust && deno task check:spec",
    "check:style": "deno task check:fmt && deno task check:rules && deno task lint",
    "check:diff": "./script/check-diff.ts",
    "check:fmt": "deno fmt --check && cargo fmt --manifest-path crates/Cargo.toml --all --check",
    "check:web": "deno task --cwd apps/web check",
    // check:web never reaches the device's own modules.
    "check:native": "deno check apps/native/src && cargo clippy --manifest-path crates/Cargo.toml --target aarch64-apple-ios -p pxl-native -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --target aarch64-linux-android -p pxl-native --no-default-features -- -D warnings",
    "check:xpute": "deno task --cwd xpute check",
    // What ships: the kernel's module in both builds, and the servers.
    "check:rust": "cargo clippy --manifest-path crates/Cargo.toml --target wasm32-unknown-unknown -p pxl-spec -p pxl-render -p pxl-kernel -p pxl-wasm -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --target wasm32-unknown-unknown -p pxl-wasm --no-default-features -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml -p pxl-geo-spec -p pxl-server -p pxl-geo -p pxl-api -- -D warnings",
    // What runs here alone: the tests' code, the bakes and the tools.
    "check:host": "cargo clippy --manifest-path crates/Cargo.toml --all-targets -p pxl-spec -p pxl-render -p pxl-kernel -p pxl-geo-spec -p pxl-server -p pxl-geo -p pxl-geo-bake -p pxl-api -p pxl-tool -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --all-targets -p pxl-geo-bake --features serve -- -D warnings",
    // A Rust version written twice is a binary built on a compiler the gate never ran.
    "check:toolchain": "./script/check-toolchain.ts",
    "check:rules": "./script/check-rules.ts",
    "check:spec": "cargo run -q --manifest-path crates/Cargo.toml -p pxl-tool --bin spec",
    "test": "deno task test:web && deno task test:xpute && deno task test:rust",
    "test:web": "deno task --cwd apps/web test",
    "test:xpute": "deno task --cwd xpute test",
    // pxl-tool holds every model to the committed table, which has been wrong by hand before.
    "test:rust": "cargo test --manifest-path crates/Cargo.toml -p pxl-spec -p pxl-render -p pxl-kernel -p pxl-geo-spec -p pxl-server -p pxl-geo -p pxl-geo-bake -p pxl-api -p pxl-tool && cargo test --manifest-path crates/Cargo.toml -p pxl-kernel --no-default-features && cargo test --manifest-path crates/Cargo.toml -p pxl-geo-bake --features serve",
    "lint": "deno lint",
    "fmt": "deno fmt",

    // The deployment. Does not upload what the bucket holds.
    "deploy": "deno task --cwd apps/web deploy",
    // Against a running deployment, not a checkout.
    "smoke": "./script/smoke.ts",
    // Reads with wrangler's login and hcloud's context.
    "usage": "./script/usage.ts",
    // A bake's publish stage into the bucket under a new name; deploy after.
    "publish": "./script/publish.ts",

    // The rest.
    "export:xpute": "./xpute/script/export.ts",
    // apps/web/.build_number is written by any read of the build log, so it is refreshed before vite reads it.
    "sync:build-number": "sh -c './script/build-log.ts >/dev/null || echo \"[build-number] not synced: this build is labeled from the cached number\" >&2'"
  },

  "compilerOptions": {
    "lib": ["deno.window", "deno.ns", "deno.unstable", "esnext"],
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "checkJs": false
    // "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,
  },

  "imports": {
    "@xpute/kit/": "./xpute/ts/kit/src/",
    "@xpute/host/": "./xpute/ts/host/src/",
    "@xpute/conformance/": "./xpute/ts/conformance/src/",

    "@std/assert": "jsr:@std/assert@^1",

    "@std/path": "jsr:@std/path@^1",
    "@std/jsonc": "jsr:@std/jsonc@^1",

    "vite": "npm:vite@^8.3.0",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",

    "i18next": "npm:i18next@^26.4.2"
  },

  "fmt": {
    "lineWidth": 200,
    "proseWrap": "preserve",

    // The tests read the golden records byte for byte; Carto's symbols stay as Carto ships them.
    "exclude": ["node_modules/", "dist/", "crates/**/golden/", "asset/place/symbol/"]
  },

  "lint": {
    "rules": { "tags": ["recommended"] },

    "exclude": ["node_modules/", "dist/"]
  }
}
