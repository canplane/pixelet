{
  "compilerOptions": {
    /* 모듈 상호 호환성 및 엄격 구문 */
    "verbatimModuleSyntax": true, // 런타임 코드와 타입을 엄격히 분리
    "esModuleInterop": true, // CommonJS 모듈을 ESM처럼 사용하도록 허용
    "forceConsistentCasingInFileNames": true, // OS별 파일명 대소문자 차이로 인한 참조 에러 방지

    /* 상호 운용성 및 기타 */
    "allowSyntheticDefaultImports": true, // 디폴트 익스포트가 없는 모듈도 임포트 허용
    "resolveJsonModule": true, // JSON 파일 임포트 허용
    "isolatedModules": true, // 각 파일을 독립적으로 트랜스파일 가능하게 함

    /* 엄격한 타입 검사 및 린팅 규칙 */
    "strict": true, // 모든 엄격한 타입 검사 옵션 활성화
    "noUnusedLocals": false, // 사용하지 않는 지역 변수에 대한 에러 보고 여부
    "noUnusedParameters": false, // 사용하지 않는 함수 파라미터에 대한 에러 보고 여부
    "noFallthroughCasesInSwitch": true, // switch 문에서 break 누락 방지

    /* 경로 별칭 */
    "baseUrl": ".",
    "paths": {
      "@pixelet/core/*": ["packages/core/src/*"] // 이 경로 설정이 있어야 Webpack이 실제 소스 위치를 찾습니다.
    }
  },
  "files": [], // 루트 자체에는 소스 코드가 없음을 명시
  "references": [
    { "path": "packages/core" },
    { "path": "apps/api" },
    { "path": "apps/web" }
  ]
}
