  "pack": {
    "name": "pixelet-ms2-inspired-original",
    "description": "Original individual 64x64 terrain and object textures for pixelet. The converted subset uses a cute, hand-painted fantasy-game material style with broad rounded forms and restrained detail. It is an original design and does not copy MapleStory 2 or any other game.",
    "tileSize": 64,
    "format": "PNG",
    "filesAreIndividual": true,
    "activeAssetCount": 60,
    "cutePaintedActiveCount": 45,
    "legacyActiveCount": 15,
    "allActiveAssetsUseCutePaintedStyle": false,
    "sourcePalette": {
      "terrain": "pixelet terrain/carto.json",
      "objects": "pixelet objects/default.json"
    },
    "note": "Download each active source image as an individual file and normalize it to exactly 64x64 RGBA PNG. For these hand-painted assets, use high-quality Lanczos or bicubic downsampling when the source is larger than 64x64; do not use nearest-neighbor on the painted set because it can reintroduce visible pixelation. Do not make a sprite sheet. The cute-painted set currently covers all 17 land/water top materials, all 5 structure tops, all 10 transport tops, and all 13 terrain sides (45 active assets total). The 15 wool block textures remain the earlier legacy-style assets for now (15 active assets total). Preserve distinct-per-type mappings and do not collapse types. The old sourceCreation 28 exposed-soil image is intentionally excluded and must not be assigned to any terrain type.",
    "conversion": {
      "status": "partial",
      "cutePaintedGroups": [
        "terrain.top.land",
        "terrain.top.water",
        "terrain.top.structure",
        "terrain.top.transport",
        "terrain.side"
      ],
      "legacyGroups": [
        "objects.block"
      ],
      "cutePaintedAssetCount": 45,
      "legacyAssetCount": 15,
      "remainingForCutePaintedConversion": 15,
      "fullPackComplete": false,
      "note": "The pack is not yet fully converted to the new cute-painted style. This manifest now activates all land/water, structure, transport, and side textures in the cute-painted-fantasy-v1 style. The 15 wool block textures remain legacy until they are regenerated."
