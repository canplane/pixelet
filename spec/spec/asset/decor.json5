{
  $description: "A decor's id is its place in `decors`, over the decor kind (id.json5). A\nplaced one is stored as that id, so a decor already here keeps its place\nand a new one goes at the end.\n\nEach decor is said here once: its models, and how the ground generates it\non its own. A decor's `seed` names its scatter, so changing it reshuffles\nevery one the ground generates; `density` is the chance a cell of its holds\none, the mean of a tree of hashes of the cells (pxl-content scatter.rs);\n`on` the ground asset ids it may stand on; `orient` a random heading, or\nalong the road or rail its cell lies on. `packs` are the model packs it is\ndrawn from, in the order its variants are numbered: a pack's `skin` is its\none colormap, kept outside the glb, and its `variants` its models.\n\nA variant's `size` is the box it claims, in its decor's cells: every cell\nof it is the decor's. Its model is drawn as made, a glb unit a unit, its\norigin at the middle of the box's base, where it stands: no origin is\nmoved, and glTF fixes none, so a model must be made with it there. It may\nreach a little past the box. A decor's cell is a unit, a z24 cell. The\nground generates a decor only on its own ground asset ids, and no two decors share one, so\ntwo decors' boxes never meet.\n\nA decor thing carries `meta`, the fields its id gives it beside where it\nstands: which variant of its decor and its heading in quarter turns (an\nodd one swaps its box's sides). The ground evaluates them from its cell; a\nplaced one's are the placement's.",
  meta: { variant: { $value: "u32" }, turn: { $value: "u32" } },
  decors: {
    tree: {
      label: { $value: "Tree" },
      $description: "Trees on green and bare land. Bare is the fallback type for untagged land\nand this pack draws it as grass; sports fields are left out as maintained,\nnot natural, ground. Sparse: a hillside with some trees, not a forest wall\nat 1u spacing.",
      seed: { $value: 0x7902530c, $type: "u32" },
      density: { $value: 0.025 },
      orient: { $value: "random" },
      on: { $value: ["park", "forest", "land"] },
      packs: {
        $value: [
          {
            $type: "file",
            skin: "decor/kenney_fantasy_town/colormap.png",
            variants: [
              { model: "decor/kenney_fantasy_town/tree.glb", size: [1, 1, 3] },
              {
                model: "decor/kenney_fantasy_town/tree-high.glb",
                size: [1, 1, 3],
              },
              {
                model: "decor/kenney_fantasy_town/tree-crooked.glb",
                size: [1, 1, 3],
              },
              {
                model: "decor/kenney_fantasy_town/tree-high-round.glb",
                size: [1, 1, 3],
              },
              {
                model: "decor/kenney_fantasy_town/tree-high-crooked.glb",
                size: [1, 1, 3],
              },
            ],
          },
          {
            $type: "file",
            skin: "decor/kenney_graveyard_kit/colormap.png",
            variants: [
              { model: "decor/kenney_graveyard_kit/pine.glb", size: [1, 1, 2] },
              {
                model: "decor/kenney_graveyard_kit/pine-crooked.glb",
                size: [1, 1, 2],
              },
              {
                model: "decor/kenney_graveyard_kit/pine-fall.glb",
                size: [1, 1, 2],
              },
              {
                model: "decor/kenney_graveyard_kit/pine-fall-crooked.glb",
                size: [1, 1, 2],
              },
            ],
          },
        ],
      },
    },
    boat: {
      label: { $value: "Boat" },
      $description: "Boats on open water: rivers, lakes and the sea near a coast; wetland is\ntoo shallow. The sea is the same `water` ground, and boats stand on it\nnear a coast alone: a tile of open sea is left out of the bake and drawn\nfrom a coarser one, at whose cells no boat stands (pxl-content\n`scatter::stands_at`), so the clip levels a boat stands at hold sea only in\nthe tiles a coast crosses. Rivers are a few cells wide, so the same per-cell\nrate reads far denser than on land.",
      seed: { $value: 0xb0a5802d, $type: "u32" },
      density: { $value: 0.001 },
      orient: { $value: "random" },
      on: { $value: ["water"] },
      packs: {
        $value: [
          {
            $type: "file",
            skin: "decor/kenney_watercraft_pack/colormap.png",
            variants: [
              {
                model: "decor/kenney_watercraft_pack/boat-row-small.glb",
                size: [3, 2, 1],
              },
              {
                model: "decor/kenney_watercraft_pack/boat-fishing-small.glb",
                size: [2, 4, 3],
              },
              {
                model: "decor/kenney_watercraft_pack/boat-sail-a.glb",
                size: [2, 4, 5],
              },
              {
                model: "decor/kenney_watercraft_pack/boat-speed-a.glb",
                size: [2, 3, 2],
              },
            ],
          },
        ],
      },
    },
    car: {
      label: { $value: "Car" },
      $description: "Cars on major roads only: neighborhood streets and pedestrian ways are\nwhere users build, and a car there reads as in the way. Aligned to the\nroad, since a random heading reads as a crash. Sparse: a car every couple\nof cells reads as gridlock.",
      seed: { $value: 0x0ca63010, $type: "u32" },
      density: { $value: 0.003 },
      orient: { $value: "along_transport" },
      on: {
        $value: [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "residential_road",
        ],
      },
      packs: {
        $value: [
          {
            $type: "file",
            skin: "decor/kenney_car_kit/colormap.png",
            variants: [
              { model: "decor/kenney_car_kit/sedan.glb", size: [1, 3, 1] },
              { model: "decor/kenney_car_kit/suv.glb", size: [1, 3, 1] },
              { model: "decor/kenney_car_kit/van.glb", size: [1, 3, 1] },
              {
                model: "decor/kenney_car_kit/hatchback-sports.glb",
                size: [1, 3, 1],
              },
              { model: "decor/kenney_car_kit/taxi.glb", size: [1, 3, 1] },
            ],
          },
        ],
      },
    },
    train: {
      label: { $value: "Train" },
      $description: "Trains on rail lines the ground shows (a tunnel's is not painted), aligned\nto the rail, since one lying across it reads as derailed. Very sparse:\ntrains should read as occasional.",
      seed: { $value: 0x7ba5802d, $type: "u32" },
      density: { $value: 0.0015 },
      orient: { $value: "along_transport" },
      on: { $value: ["tram", "light_rail", "subway", "monorail", "rail"] },
      packs: {
        $value: [
          {
            $type: "file",
            skin: "decor/kenney_train_kit/colormap.png",
            variants: [
              {
                model: "decor/kenney_train_kit/train-locomotive-a.glb",
                size: [1, 3, 2],
