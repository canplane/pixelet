{
  $description: "How the marker kind is shown: its one shape, the pin, the marker someone\nputs up at a place (id.json5). A pin's cell is the camera grid's at its\nscale, as a place's icon is, its own apart from the places' since a\npin is drawn as its own design (pxl-spec asset/marker.rs\n`marker_cell_zoom`).",
  PIN_LABEL: {
    $value: "Pin",
    $description: "The pin's name, the one every locale shows: an item has one name.",
  },
  MARKER_TEXT_CHARS: {
    $value: 40,
    $type: "u32",
    $description: "The most a marker's text may be, in code points: a product choice, a short line put up at a place. Bytes follow, four to a code point at most.",
  },
  MARKER_SHOWN_FROM: {
    $value: 19,
    $type: "u8",
    $description: "The coarsest camera grid cell a scene marker of these shows at: z19, 32 of them across\na z14 tile, the zoom OpenMapTiles' `poi` layer holds every point at\n(layers/poi/poi.yaml). What someone puts up, by the cells of the brick\nit is read from (pxl-core domain/scene/marker/pin.rs); a chat line's\nbubble, which no brick holds, by the cell where its speaker stands,\nwhich its speaker judges (pxl-core\ndomain/scene/character/companion.rs `line_hangs`).",
  },
  MARKER_SCALE_STEP: {
    $value: -1,
    $type: "i8",
    $description: "A pin's cell on the camera grid, in zooms: −1 spans two of the grid's\ncells, as a place's icon does. A cell shows one pin: where more than\none stands in it, they are one, their count on a pin's pill in its\ncolors turned over, at the cell's middle over what is drawn there\n(pxl-core domain/scene/marker/pin.rs).",
  },
}
