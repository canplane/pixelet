{
  pack: {
    $type: "file",
    $value: "cube/pack.webp",
    $description: "The texture pack, the file the cube kind's cubes are drawn from: one image\nof every tile under asset/content/cube/, which the asset ingest composes\nand ships as the table's file at this path, with which tile each cube\nwears on which face (pxl-tool bin/asset.rs, ingest.json5). In Rust it is\nthe slot the catalog fills with it.",
  },
  BASE: {
    $description: "What a cell shows when nothing painted it: a cell with nothing on it is\nstill land, as Carto's background is.",
    $type: "Ground",
    $value: "land",
  },
  sentinel: {
    $type: "enum",
    $description: "The value space's own: what no ground cube or placed color is (pxl-spec value.rs).",
    $value: [
      {
        $extensions: { xpute: { number: 0 } },
        name: "void",
        $description: "Nothing is painted: the ground before a bake writes it, and an object cell no leaf holds.",
      },
      {
        $extensions: { xpute: { number: 255 } },
        name: "unknown",
        $description: "Bedrock, where the world holds no more: the floor under the ground and the wall just inside the service area (`pxl-content strata.rs`). A cell past the area or the coverage, which no source here describes, reads as it. It is solid and drawn as the bedrock's layer (pxl-render paint/palette.rs `SENTINELS`). Nothing is placed on it or taken from it.",
      },
      {
        $extensions: { xpute: { number: 256 } },
        name: "air",
        $description: "Explicit air: the leaf stays and erases the layers under it.",
      },
    ],
    $extensions: { xpute: { repr: "u16" } },
  },
  ground: {
    $type: "enum",
    $description: "The ground: one byte a cell, its asset id, a ground cube numbered in\nthe order OpenStreetMap Carto paints.\n`transport` marks a way: decor faces along it and no pier stands on it.\nWhatever the cube, a cell's top is the height sampled from the\nelevation; no cube raises or lowers it. The byte's values are these: 1 to 63\nare cubes in Carto's colors, in its paint order; from 64 on are pixelet's own,\nthe underground, of which Carto paints nothing; 0 and 255 are the sentinels.",
    $value: [
      {
        $extensions: { xpute: { number: 1 } },
        name: "land",
        label: "Land",
        section: "landcover",
        transport: false,
        $description: "Land no feature covers, and what Carto draws no fill for, takes Carto's background, @land-color.",
      },
      {
        $extensions: { xpute: { number: 2 } },
        name: "bare_ground",
        label: "Bare Ground",
        section: "landcover",
        transport: false,
        $description: "Bare rock, scree and shingle take Carto's @bare_ground.",
      },
      {
        $extensions: { xpute: { number: 3 } },
        name: "sand",
        label: "Sand",
        section: "landcover",
        transport: false,
        $description: "Sand takes Carto's @sand.",
      },
      {
        $extensions: { xpute: { number: 4 } },
        name: "beach",
        label: "Beach",
        section: "landcover",
        transport: false,
        $description: "Beach and shoal take Carto's @beach.",
      },
      {
