    residential: { rgb: { $value: 0xe0dfdf, $type: "u32" } },
    garages: { rgb: { $value: 0xdfddce, $type: "u32" } },
    retail: { rgb: { $value: 0xffd6d1, $type: "u32" } },
    commercial: { rgb: { $value: 0xf2dad9, $type: "u32" } },
    industrial: { rgb: { $value: 0xebdbe8, $type: "u32" } },
    power: { rgb: { $value: 0xe2cbde, $type: "u32" } },
    landfill: { rgb: { $value: 0xb6b592, $type: "u32" } },
    quarry: { rgb: { $value: 0xc5c3c3, $type: "u32" } },
    societal_amenities: { rgb: { $value: 0xffffe5, $type: "u32" } },
    place_of_worship: { rgb: { $value: 0xd0d0d0, $type: "u32" } },
    transportation_area: { rgb: { $value: 0xe9e7e2, $type: "u32" } },
    parking: { rgb: { $value: 0xeeeeee, $type: "u32" } },
    apron: { rgb: { $value: 0xdadae0, $type: "u32" } },
    glacier: { rgb: { $value: 0xddecec, $type: "u32" } },
    water: { rgb: { $value: 0xaad3df, $type: "u32" } },
    dam: { rgb: { $value: 0xadadad, $type: "u32" } },
    breakwater: { rgb: { $value: 0xaaaaaa, $type: "u32" } },
    building: { rgb: { $value: 0xd9d0c9, $type: "u32" } },
    building_major: { rgb: { $value: 0xc4b6ab, $type: "u32" } },
    footway: { rgb: { $value: 0xfa8072, $type: "u32" } },
    cycleway: { rgb: { $value: 0x0000ff, $type: "u32" } },
    bridleway: { rgb: { $value: 0x008000, $type: "u32" } },
    track: { rgb: { $value: 0x996600, $type: "u32" } },
