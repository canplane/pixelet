    soil: {
      rgb: { $value: 0x976d4d, $type: "u32" },
      $description: "Minecraft's map color DIRT (minecraft.wiki Map_item_format): Carto paints nothing under the ground.",
    },
    sandstone: {
      rgb: { $value: 0xf7e9a3, $type: "u32" },
      $description: "Minecraft's map color SAND, which sandstone is drawn as on a map.",
    },
    stone: {
      rgb: { $value: 0x707070, $type: "u32" },
      $description: "Minecraft's map color STONE.",
    },
  },
  object: {
    white: { rgb: { $value: 0xf7f7f7, $type: "u32" } },
    grey: { rgb: { $value: 0x8d8d8d, $type: "u32" } },
    dark_grey: { rgb: { $value: 0x3f3f3f, $type: "u32" } },
    black: { rgb: { $value: 0x191919, $type: "u32" } },
    red: { rgb: { $value: 0xb01313, $type: "u32" } },
    pink: { rgb: { $value: 0xff8787, $type: "u32" } },
    brown: { rgb: { $value: 0x572b00, $type: "u32" } },
    orange: { rgb: { $value: 0xd44e14, $type: "u32" } },
    yellow: { rgb: { $value: 0xffe611, $type: "u32" } },
    green: { rgb: { $value: 0x60dc1e, $type: "u32" } },
