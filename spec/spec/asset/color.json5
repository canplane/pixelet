{
  $description: "The ground's colors are OpenStreetMap Carto's (gravitystorm/openstreetmap-carto, style/*.mss): each is the value its key names, a derived one is computed (darken, lighten, an rgba over @land-color), and a literal is named for the feature it paints. A building takes its color at z16 and finer, as a cell is z16. The objects' colors are hand-picked. Every value is 0xrrggbb.",
  sentinel: {
    unknown: {
      rgb: { $value: 0x565656, $type: "u32" },
      $description: "Bedrock, where the world holds no more: a dark gray, so it reads as the world's end against the night's black and the day's haze past it alike, rather than as whatever drew last.",
    },
  },
  ground: {
    land: { rgb: { $value: 0xf2efe9, $type: "u32" } },
    bare_ground: { rgb: { $value: 0xeee5dc, $type: "u32" } },
    sand: { rgb: { $value: 0xf5e9c6, $type: "u32" } },
    beach: { rgb: { $value: 0xfff1ba, $type: "u32" } },
    heath: { rgb: { $value: 0xd6d99f, $type: "u32" } },
    scrub: { rgb: { $value: 0xc8d7ab, $type: "u32" } },
    grass: { rgb: { $value: 0xcdebb0, $type: "u32" } },
    park: { rgb: { $value: 0xc8facc, $type: "u32" } },
    leisure: { rgb: { $value: 0xdffce2, $type: "u32" } },
    pitch: { rgb: { $value: 0x88e0be, $type: "u32" } },
    forest: { rgb: { $value: 0xadd19e, $type: "u32" } },
    orchard: { rgb: { $value: 0xaedfa3, $type: "u32" } },
