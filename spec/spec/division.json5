{
  $description: "A division's subtype, Overture's, broadest first (pxl-spec division.rs\n`Subtype`): a name is a division and its ancestors, and the client picks\nhow deep to read it. The numbers are stored, so a subtype is appended,\nnever inserted.",
  DIVISION_NAME: {
    $type: "u32",
    BYTES: {
      $value: 128,
      $description: "The most bytes of a division's name in UTF-8 that the overlay's snapshot carries. A tile holds its names whole, and the snapshot cuts a longer one at a character's boundary; it carries at most DIVISION_SUBTYPE's count of a chain's names, the narrowest (pxl-core ui.rs `division_parts`).",
    },
  },
  DIVISION_SUBTYPE: {
    $type: "u8",
    COUNTRY: { $value: 0 },
    DEPENDENCY: { $value: 1 },
    MACROREGION: { $value: 2 },
    REGION: { $value: 3 },
    MACROCOUNTY: { $value: 4 },
    COUNTY: { $value: 5 },
    LOCALADMIN: { $value: 6 },
    LOCALITY: { $value: 7 },
    BOROUGH: { $value: 8 },
    MACROHOOD: { $value: 9 },
    NEIGHBORHOOD: { $value: 10 },
    MICROHOOD: { $value: 11 },
  },
}
