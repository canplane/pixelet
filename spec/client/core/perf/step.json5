{
  $description: "The frame's vocabulary, the core's and the UI's: the steps a tick runs, as frame.rs\nregisters them, and the phase each runs in, the effects a frame runs before them, the parts of the stage it runs after them and the requests' pump, and the reasons a frame is asked for. The profiler records and\nreports them by these names (spec/client/core/perf/perf.json5).",
  $extensions: {
    xpute: { uses: ["spec/client/core/sys/sched/phase.json5"] },
  },
  STEP_NAME: {
    $type: "enum",
    $value: [
      "input",
      "camera",
      "edit",
      "ghost",
      "location",
      "environment",
      "companion",
      "demand",
      "scene",
    ],
    $extensions: { xpute: { names: true } },
  },
  STEP_PHASE: {
    $description: "The phase each step runs in, in STEP_NAME's order (pxl-core frame.rs `tick`).",
    $type: "Phase",
    $value: [
      "interaction",
      "interaction",
      "interaction",
      "interaction",
      "interaction",
      "interaction",
      "interaction",
      "visible",
      "visible",
    ],
  },
  EFFECT_NAME: {
    $type: "enum",
    $value: [
      "navigation",
      "decor",
      "object",
      "setting",
    ],
    $extensions: { xpute: { names: true } },
  },
  STAGE_PART_NAME: {
    $description: "The parts of a frame's stage, in the order they start (pxl-core domain/scene/stage.rs `stage_render`): `assemble` what the renderer's frame is made from, the eye's cast among it; `upload` the ground's bricks and the imagery's tiles handed to the renderer, which asks for them as it encodes; `encode` the renderer's frame, less those uploads; `judge` what the frame leaves, the images it took given back and the drawn resolution judged.",
    $type: "enum",
    $value: ["assemble", "upload", "encode", "judge"],
    $extensions: { xpute: { names: true } },
  },
  INVALIDATION_REASON: {
    $description: "Why a frame is asked for (pxl-core sys/sched.rs `invalidate`): `method` a method from outside applied (the UI's, a surface's among them), `view` the camera moved or the ratio the world is drawn at changed, `scene` what is shown changed, `completion` something outside the frame finished and a frame takes it (a read, a parse, a write, the GPU's), `pending` a frame stopped short of its work or put it off and a later one goes on, `animation` an animation's step or a frame of its motion.",
    $type: "enum",
    $value: ["method", "view", "scene", "completion", "pending", "animation"],
    $extensions: { xpute: { names: true } },
  },
}
