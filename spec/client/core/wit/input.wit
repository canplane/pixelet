package pxl:core@0.1.0;

// What the hand does to the view, as the UI recognizes it from its pointers:
// each a change since the last, in the view's logical pixels and radians.
interface input {
  // A drag of `dx`, `dy` pixels, which the ground under the hand follows.
  pan: func(dx: f64, dy: f64);
  // A turn of the view about the up axis, by `rad` radians.
  turn: func(rad: f64);
  // A tilt of the view by `rad` radians, toward the horizon as it grows.
  tilt: func(rad: f64);
  // A spread of the hands by `scale`; the view comes closer as it grows.
  zoom: func(scale: f64);
  // Whether a hand drags the view, from its press to its release.
  drag: func(dragging: bool);
  // A tap at (`x`, `y`), in the view's logical pixels.
  tap: func(x: f64, y: f64);
  // A pointer over the world at (`x`, `y`) that holds nothing, and its leaving.
  hover: func(x: f64, y: f64);
  out: func();
  // The held movement keys: each axis -1, 0 or 1, x to the right and y down.
  move: func(x: s32, y: s32);
  // Reserved for a headset's UI (ts/xr) and kept on purpose, though nothing
  // sends it yet: the head's
  // pose in the world, a position and a rotation's quaternion, and its end.
  xr-pose: func(x: f64, y: f64, z: f64, qx: f64, qy: f64, qz: f64, qw: f64);
  xr-pose-end: func();
}
