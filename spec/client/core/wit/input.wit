package pxl:core@0.1.0;

interface input {
  enum pointer-phase {
    down,
    move,
    up,
    out,
    // The pointer's gesture ends with no tap: the platform took it, or the UI
    // spent it on something of its own.
    cancel,
  }
  // What a press that is not a finger's drags, by the button the UI gives
  // it.
  enum drag { none, pan, rotate }

  // `touch`: the pointer is a finger on a screen, which pans and pinches by
  // how many are down; any other pointer drags as its `drag` says.
  pointer: func(phase: pointer-phase, touch: bool, id: s32, drag: drag, x: f64, y: f64);
  wheel: func(delta-y: f64);
  pinch: func(scale: f64);
  move: func(x: s32, y: s32);
  // Reserved for a headset's UI (ts/xr), which sends nothing yet: the head's
  // pose in the world, a position and a rotation's quaternion, and its end.
  xr-pose: func(x: f64, y: f64, z: f64, qx: f64, qy: f64, qz: f64, qw: f64);
  xr-pose-end: func();
}
