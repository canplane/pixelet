package pxl:core@0.1.0;

// What is drawn over the world: the core's state, told when it changes and
// whole to a UI that attaches (xpute's `life.attached`).
interface overlay {
  use types.{location-mode};

  // A message the core raises and the UI shows in its own words.
  enum message {
    // Reads reach the server and fail; they are tried again.
    world-read-failing,
    // Reads failed past every retry; the world is not coming.
    world-unavailable,
  }

  record lon-lat {
    lon: f64,
    lat: f64,
  }

  record pivot-state {
    // A frame has reached the screen over a view whose ground tiles all
    // show, some perhaps at a coarser zoom.
    ground-shown: bool,
    lon-lat: option<lon-lat>,
    outside: bool,
  }

  record division-part {
    subtype: u8,
    name: string,
    shown: bool,
    area: bool,
  }

  // What the camera is doing. It does one at a time: on an animation no
  // gesture is taken, and during a gesture no animation starts.
  enum camera-state {
    // Neither: any input is taken, and the camera mode can be changed.
    idle,
    // A hand holds the view, or a key is held. What a gesture left to ease
    // goes on while idle.
    gesture,
    // The camera's own way to a place it was sent to.
    animation,
  }

  // What the UI shows of the core, replaced whole when it changes.
  record snapshot {
    pivot: pivot-state,
    camera: camera-state,
    // The person and the pet the player chose are both loaded.
    companion-ready: bool,
    // A marker's draft is open, its text told apart (`draft`).
    drafting: bool,
    location-mode: location-mode,
    // The pointer is over a scene marker a tap would act on.
    over-marker: bool,
    // Every setting's value by its number; none until the core has read its
    // storage.
    settings: list<u32>,
    // The division the pivot is in and every one above it, broad to narrow.
    division: list<division-part>,
    // The surfaces a character is drawn on.
    character-surfaces: list<u32>,
    // Why the server does not answer the world's reads now.
    stall: option<message>,
    // How much of what the renderer makes before its first frame is made, 0
    // to 1.
    renderer-progress: f64,
    // How much of the view's ground shows, 0 to 1.
    area-progress: f64,
  }

  show: async func(snapshot: snapshot);
  // The text of a marker's draft, told as the draft opens and to a UI that
  // attaches while one is open, before the snapshot that shows it open; the
  // UI owns the text from then on and sends each change (pxl:core edit
  // `marker-text`).
  draft: async func(text: string);
  // The view's azimuth, and the meters a logical pixel spans at the pivot, 0
  // where the camera stands there.
  view: async func(azimuth: f64, m-per-px: f64);
}
