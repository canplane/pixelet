package pxl:core@0.1.0;

// What is drawn over the world: the core's state, told when it changes.
interface overlay {
  use xpute:link/types@0.1.0.{token};

  enum ground-status { idle, loading, success }
  enum sensor-status { idle, loading, ready, error, unavailable }
  // A message the core raises and the UI shows in its own words.
  enum message {
    geolocation-unsupported,
    geolocation-permission-denied,
    geolocation-position-unavailable,
    geolocation-timeout,
    geolocation-generic-error,
    // Reads reach the server and fail; they are tried again.
    world-read-failing,
    // Reads failed past every retry; the world is not coming.
    world-unavailable,
  }

  record lon-lat {
    lon: f64,
    lat: f64,
  }

  record pivot-state {
    status: ground-status,
    is-off-center: bool,
    lon-lat: option<lon-lat>,
    outside: bool,
  }

  record location-state {
    status: sensor-status,
    has-location: bool,
    watching: bool,
    err: option<message>,
  }

  record companion-state {
    person-ready: bool,
    pet-ready: bool,
  }

  record orientation-state {
    status: sensor-status,
  }

  record division-part {
    subtype: u8,
    name: string,
    shown: bool,
    area: bool,
  }

  // A file the core refused, by the path it opened it at.
  record refused-file {
    path: list<token>,
  }

  // What the UI shows of the core, replaced whole when it changes.
  record snapshot {
    pivot: pivot-state,
    location: location-state,
    companion: companion-state,
    // A marker's draft, its text so far, absent where none is open.
    draft: option<string>,
    orient: orientation-state,
    is-follow-mode: bool,
    camera-busy: bool,
    // A zoom is in hand; the scale shows while it is.
    zooming: bool,
    // The pointer is over a scene marker a tap would act on.
    over-marker: bool,
    // Every setting's value by its number; none until the core has read its
    // storage.
    settings: list<u32>,
    // The division the pivot is in and every one above it, broad to narrow.
    division: list<division-part>,
    // The surfaces a character is drawn on.
    character-surfaces: list<u32>,
    refused-files: list<refused-file>,
    // Why the server does not answer the world's reads now.
    stall: option<message>,
    // How much of what the renderer makes before its first frame is made, 0
    // to 1.
    renderer-progress: f64,
    // How much of the view's ground shows, 0 to 1.
    area-progress: f64,
  }

  show: func(snapshot: snapshot);
  // The view's azimuth, and the meters a logical pixel spans at the pivot, 0
  // where the camera stands there.
  view: func(azimuth: f64, m-per-px: f64);
}
