package pxl:core@0.1.0;

interface edit {
  use types.{error-code};

  // What the pointer holds: itself, the eraser, or an item to place, which
  // `val` names.
  enum tool { pointer, item, eraser }

  hold: func(tool: tool, val: u32, scale-step: s32);
  marker-text: func(text: string) -> result<_, error-code>;
  marker-cancel: func();
  marker-commit: func();
}
