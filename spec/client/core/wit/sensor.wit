package pxl:core@0.1.0;

// The three facts of the device's sensors the core reads, each told as it
// changes; the UI runs the sensors themselves.
interface sensor {
  // The location's status: idle until asked, loading until a fix, ready once
  // one came, error where it failed.
  enum location-status { idle, loading, ready, error }

  // A position in degrees, its altitude in meters over the WGS 84 ellipsoid
  // where the device gives one.
  record position {
    lon: f64,
    lat: f64,
    alt: option<f64>,
  }

  // The device's position, absent without a fix.
  pos: func(at: option<position>);
  // The compass heading, 0-360 degrees, absent while there is none.
  heading: func(deg: option<f64>);
  // The location's status, as it changes.
  location: func(status: location-status);
}
