package pxl:core@0.1.0;

interface perf {
  start: func();
  stop: func();
  // STAT's words over `window-ms`, and NOW's (perf.json).
  stats: func(window-ms: option<f64>) -> list<u8>;
  // The records of ring `ring`, in RING_NAMES' order.
  rings: func(ring: u32) -> list<u8>;
  // The string table the tasks' `at_file` names point into.
  strtab: func() -> list<u8>;
}
