package pxl:core@0.1.0;

interface camera {
  use types.{location-mode};

  // Asks for a location mode, as the location button does. Locate puts the
  // camera at the user's location once. Track has the camera track the
  // location; as tracking ends, the view turns back to north.
  set-location-mode: func(mode: location-mode);
  // Goes to (lon, lat), keeping the camera's azimuth and polar; a view farther
  // out than the default comes in to it on the way.
  goto: func(lon: f64, lat: f64);
}
