package pxl:core@0.1.0;

interface camera {
  enum tracking { recenter, follow, unfollow }

  track: func(tracking: tracking);
  north-up: func();
  // Flies to (lon, lat); an absent dist, azimuth or polar keeps the camera's.
  goto: func(lon: f64, lat: f64, dist: option<f64>, azimuth: option<f64>, polar: option<f64>);
}
