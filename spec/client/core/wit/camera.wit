package pxl:core@0.1.0;

interface camera {
  use types.{tracking-mode};

  // Sets the tracking mode, as the tracking button asks. While it tracks,
  // the camera goes after the user's location; as it ends, the view turns
  // back to north.
  track: func(mode: tracking-mode);
  // Goes to (lon, lat), keeping the camera's azimuth and polar; a view farther
  // out than the default comes in to it on the way.
  goto: func(lon: f64, lat: f64);
}
