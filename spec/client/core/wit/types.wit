package pxl:core@0.1.0;

// The types more than one interface takes.
interface types {
  enum sensor { geolocation, orient }

  // Why the core refused what it was asked, as WASI's interfaces answer an
  // `error-code`, each case named as WASI names the same error; `too-long` is
  // the core's own. A caller's bug is refused instead, `EINVAL` in the
  // answer's status.
  enum error-code {
    // The settings are not read yet, and a change would be overwritten.
    would-block,
    // No surface is open there.
    bad-descriptor,
    // The surface draws something else.
    busy,
    // The text is longer than a marker holds.
    too-long,
    // The profiler's setting is off.
    not-permitted,
    // The profiler's window could not be had.
    insufficient-memory,
  }

  // A shard by its name, with the version of each kind it declares of its own,
  // a kind to an entry in publication.json5's order, none where it takes the
  // source's.
  record shard {
    name: string,
    versions: list<option<string>>,
  }

  // What the tile source declares of itself: the coarsest zoom it supplies
  // whole, each kind's format by its bake's number and its version, a kind to
  // an entry in publication.json5's order, and its shards. The core keeps it
  // for its life (source `declare`) and tells it to the UI (overlay
  // `source`).
  record declaration {
    min-zoom: u32,
    formats: list<u32>,
    versions: list<string>,
    shards: list<shard>,
  }
}
