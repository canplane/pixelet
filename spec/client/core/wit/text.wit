package pxl:core@0.1.0;

// The platform's text, which the host implements and the core calls. Each
// reads the UTF-8 text the core lends; a raster writes into the image it lends
// beside it, both spans of the core's memory lent for the call. The core
// breaks its lines itself (pxl-core sys/io/text.rs).
interface text {
  use xpute:link/types@0.1.0.{lent};

  // How wide the text is set at `px`.
  width: func(weight: u32, px: f64, text: lent) -> f64;
  // Draws the text into `image`, `width` by `height` pixels of RGBA.
  raster: func(weight: u32, px: f64, color: u32, image: lent, width: u32, height: u32, x: f64, text: lent) -> u32;
}
