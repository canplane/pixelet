{
  $description: "Every setting the app has, declared once: its default, its kind, and\nwhere it is shown, its `section`: one of the settings sheet's, or\n`perf`, the profiler panel's own. The store reads the defaults from\nhere and the sheet renders rows from here, so adding a setting to the\nsheet is one entry in SETTING plus its two strings in the locale catalog\nunder `settings.<section>.<key>`. A choice may carry `costs` beside its\n`options`, one per option in the same order, for when what an option costs\ndiffers from its neighbors'; an empty string is no badge. A `dev` setting\nis in the core's table in every build and offered only under a\ndevelopment one; the UI's production bundle carries SETTING_PROD,\nthe table without them, in SETTING's place. A setting whose `stored` is\nfalse is the session's alone: the store neither writes it to its kept\nslot nor reads it from there, so every session starts it at its default.\n\nA setting carries its `number` (the core's SettingKey), and a choice's\n`options` names one of the lists below, which numbers each option. The\nnumbers are what crosses and what storage keeps; the names are the\nUI's alone, for its rows and the locale. A number is given out once;\nthe generator refuses one given twice. An `index` is a place in a list\nkept elsewhere — the person and the pet are by theirs in character.json5 — and\ncrosses as itself.",
  RES_MODE: {
    $value: { auto: 0, fixed: 1, low: 2 },
    $type: "u32",
    $description: "How many device pixels the world is drawn at to a CSS pixel, and the rate\nframes go at.\n\n  auto  — a frame each whole number of vsync intervals, from RATE_MAX_HZ\n          to RATE_MIN_HZ;\n          the display's pixels, stepped down to a share of them, while\n          moving frames' GPU time runs over their budget — the frame's\n          target interval — and back up once the step above would fit, a\n          budget control as congestion control is\n          (rust/client/core/src/domain/scene/resolution.rs).\n  fixed — the display's, at its rate to RATE_MAX_HZ, whatever the frames\n          cost.\n  low   — half the display's each way, auto's floor (RES_MIN), at the\n          display's rate to RATE_MAX_HZ.",
  },
  CAMERA_MODE: {
    $value: { orbit: 0, first_person: 1 },
    $type: "u32",
    $description: "Which controller makes the camera's pose.\n\n  orbit        — third person: the camera turns about the pivot, its\n                 radius ahead of the eye, and a drag moves the pivot.\n  first_person — the eye is the pivot and turns in place; a drag\n                 walks it as the orbit's pivot walks, the eye at its\n                 height over where the walk stands.",
  },
  ORBIT_OBSTACLE_MODE: {
    $value: { through: 0, stop: 1, climb: 2 },
    $type: "u32",
    $description: "What terrain does to the camera.\n\n  through — nothing. The eye goes wherever the controls put it, ground\n            included, where its rays start inside what they meet and\n            the scene reads inside out.\n  stop    — a control goes as far as it asked or as far as it can.\n            Nothing moves on its own; a zoom into a hill stops short.\n  climb   — dist is granted and the *view* pitches up instead, as far\n            as straight down, at the cost of an angle nobody asked for.\n            Where its way hits something all the same, a zoom in goes\n            through to the pivot's side and any other control stops.",
  },
  AO_MODE: {
    $value: { off: 0, corner: 1, screen: 2 },
    $type: "u32",
    $description: "Where the ambient occlusion comes from. Either is the sky's visibility\nand darkens only the light from the sky and its bounce, never the direct\nsun or moon, which the shadows are its visibility of; neither tints\n(rust/client/render/src/frame/shader/atmos_light.wgsl `surface_light_in`).\n\n  off    — none.\n  corner — the screen pass's own: the floor along a cube and the inside\n           of a corner, where a neighboring pixel's face rises in front\n           of the pixel's own plane within a cell or two of it\n           (rust/client/render/src/frame/shader/screen_ray.wgsl).\n           A few taps of the rays a pixel, behind a uniform.\n  screen — N8AO\n           (rust/client/render/src/pass/ao.rs): the world's depth drawn\n           once more, the occlusion sampled from it at half resolution,\n           denoised, and read by every lit surface. Five passes and 11\n           bytes a pixel. The corners' too, the darker of the two where\n           both fall (screen_shade.wgsl), as N8AO reads a cube's corner\n           softer at half resolution.",
  },
  SKY_TIME: {
    $value: { real: 0, dawn: 1, morning: 2, noon: 3, afternoon: 4, dusk: 5 },
    $type: "u32",
    $description: "The hour the sky is drawn at, at the place the sky is seen from: the\nwall clock's own, or one held in the place's solar time, so the sun\nstands where it does there at that hour today whatever the clock reads\n(pxl-core domain/scene/environment.rs `shown`). Only the sky's time;\nthe clouds, the frame's step and the storage keep the wall clock.\n\n  real      — the wall clock.\n  dawn      — 7:00, a low sun.\n  morning   — 9:00.\n  noon      — 12:00, the sun highest.\n  afternoon — 15:00.\n  dusk      — 17:00, a low sun.",
  },
  SETTING: {
    texture: {
      number: { $value: 0, $type: "u32" },
      $description: "Ground color from the art pack (a tap of the layer array per\nfragment) instead of the flat per-instance average. The paint shader's\n`frame.low_spec` is this, inverted.\n\nLow because the tap is all of it: fill rate, which scales with\nthe screen and not with the world, and nothing else — no geometry, no\npass of its own, and no work off the GPU past an atlas the client\nalready holds.",
      kind: { $value: "toggle" },
      default: { $value: true },
      section: { $value: "display" },
      cost: { $value: "low" },
    },
    decor: {
      number: { $value: 1, $type: "u32" },
      $description: "Procedurally scattered decor only; what the player placed stays.\n\nMed because it is models rather than a shading term: the GPU generates the\nground's decor where the eye's clip levels are (decor_pose_cs) and the frame draws\neach kind as a model, an impostor or nothing by the angle it\nspans, so what it costs follows what is in view. The badge is an ordering,\nand this is the one to reach for before any shading term.",
      kind: { $value: "toggle" },
      default: { $value: true },
      section: { $value: "display" },
      cost: { $value: "med" },
    },
    cloud: {
      number: { $value: 2, $type: "u32" },
      $description: "The cumulus' models and the altocumulus and cirrus sheets\n(rust/client/core/src/domain/scene/environment/cloud.rs, rust/client/render/src/pass/cloud.rs).\nMed as decor is: models in view, and a pass over the screen for the sheets.",
      kind: { $value: "toggle" },
      default: { $value: true },
      section: { $value: "display" },
      cost: { $value: "med" },
    },
    place: {
      number: { $value: 3, $type: "u32" },
      $description: "The places' markers over the world, from the published places tiles.",
      kind: { $value: "toggle" },
      default: { $value: false },
      section: { $value: "world" },
      cost: { $value: "low" },
      stored: { $value: false },
    },
    tilt_lock: {
      number: { $value: 4, $type: "u32" },
      $description: "Rotate-drag and pinch stop writing polar; azimuth is unaffected.\nOff by default: the tilt is the one control a view from above is expected to\nhave, and locking it reads as the app being stuck.",
      kind: { $value: "toggle" },
      default: { $value: false },
      section: { $value: "camera" },
    },
    camera_mode: {
      number: { $value: 5, $type: "u32" },
      $description: "On a switch to first person the person stands at the pivot, the eye at its\nheight over the ground. On a switch to third person the pivot is laid on the\nground and the eye steps back by the radius.",
      kind: { $value: "choice" },
      default: { $value: "orbit" },
      options: { $value: "CAMERA_MODE" },
      section: { $value: "world" },
      stored: { $value: false },
    },
    surface_follow: {
      number: { $value: 6, $type: "u32" },
      $description: "The pivot stands on what supports it and a pan takes the lowest way over what is in it (control/support.rs). Off, a pan keeps the pivot's height and passes through anything; a tap still stands it on the surface it struck.",
      kind: { $value: "toggle" },
      default: { $value: true },
      section: { $value: "camera" },
      dev: { $value: true },
    },
    orbit_obstacle: {
      number: { $value: 7, $type: "u32" },
      $description: "Only `climb` goes into a tunnel (camera/orbit.rs `dive`), so a shipped build holds it, and the others are a development build's to compare, each session from the default.",
      kind: { $value: "choice" },
      default: { $value: "climb" },
      options: { $value: "ORBIT_OBSTACLE_MODE" },
      section: { $value: "camera" },
      dev: { $value: true },
      stored: { $value: false },
    },
    edge_shade: {
      number: { $value: 8, $type: "u32" },
      $description: "Darkens cube edges that border open air (rust/client/render/src/frame/shader/paint.wgsl).\nA few fragment ops behind a uniform; the shader is the same either way.",
      kind: { $value: "toggle" },
      default: { $value: true },
      section: { $value: "lighting" },
      cost: { $value: "low" },
    },
    rim_light: {
      number: { $value: 9, $type: "u32" },
      $description: "A uniform on an already-compiled shader term; not a pass.",
      kind: { $value: "toggle" },
      default: { $value: true },
      section: { $value: "lighting" },
      cost: { $value: "low" },
    },
    ao: {
      number: { $value: 10, $type: "u32" },
      kind: { $value: "choice" },
      default: { $value: "corner" },
      options: { $value: "AO_MODE" },
      costs: { $value: ["", "low", "high"] },
      section: { $value: "lighting" },
    },
    shadow: {
      number: { $value: 11, $type: "u32" },
      $description: "The shadow map (rust/client/render/src/pass/shadow.rs): the world cast\nonce more from the sun, or the moon where the sun is down, as the eye's\nrays are, none where neither is up; beams and samples on\nthe node cache, the boxes they stop at drawn and a texel's sample\ntaken, the rest walked (pxl-render queue.wgsl), recast only where what it\nreads moves; decor and the characters drawn into it depth only, and a 3x3\ncompare per fragment; 16 MB of map.",
      kind: { $value: "toggle" },
      default: { $value: false },
      cost: { $value: "high" },
      section: { $value: "lighting" },
    },
    res: {
      number: { $value: 12, $type: "u32" },
      $description: "The pixels the world is drawn at: two to a CSS pixel is four times the\nwork done a drawn pixel at a time (span.json5 `GPU_SPAN_PER_PX`), and nothing\nmore; the camera grid's rays and the light's map cost the same at any.\nThe markers and the finish stay at the display's.",
      kind: { $value: "choice" },
      default: { $value: "auto" },
      options: { $value: "RES_MODE" },
      section: { $value: "display" },
    },
    view: {
      number: { $value: 13, $type: "u32" },
      $description: "Where the camera and the pointer are, read live (perf/read.rs, NOW's view section).",
      kind: { $value: "toggle" },
      default: { $value: false },
      section: { $value: "debug" },
    },
    perf: {
      number: { $value: 14, $type: "u32" },
      $description: "The performance panel, recording while it is on (perf/window.rs `perf_follow`).",
      kind: { $value: "toggle" },
      default: { $value: false },
      section: { $value: "debug" },
    },
    world_gizmo: {
      number: { $value: 15, $type: "u32" },
      $description: "Marks for the pivot and the cell it floors to, and rings in the level, the view's upright and the north–south planes (domain/scene/gizmo/frame.rs); and over the ground the eye's windows' bricks by how they stand, their tiles and shards (domain/scene/gizmo/coverage.rs).",
      kind: { $value: "toggle" },
      default: { $value: false },
      section: { $value: "debug" },
    },
    camera_gizmo: {
      number: { $value: 16, $type: "u32" },
      $description: "The camera grid over the screen, the cells the rays are spaced by, and the cells the rays stop on tinted by the share of a grid cell their faces show the eye (rust/client/render/src/frame/shader/camera_grid.wgsl, screen_shade.wgsl `cell_share`), in the looks debug_look.json5 gives them.",
      kind: { $value: "toggle" },
      default: { $value: false },
      section: { $value: "debug" },
    },
    person: {
      number: { $value: 17, $type: "u32" },
      kind: { $value: "index" },
      default: {
        $value: 1,
        $type: "u8",
        $description: "The female-b model, by its row in character.json5's person models.",
      },
      section: { $value: "character" },
    },
    pet: {
      number: { $value: 18, $type: "u32" },
      kind: { $value: "index" },
      default: {
        $value: 5,
        $type: "u8",
        $description: "The chick, by its row in character.json5's pet models.",
      },
      section: { $value: "character" },
    },
    ray_step: {
      number: { $value: 19, $type: "u32" },
      $description: "Each ray's pixel colored by the steps taken on its way from the eye, as the frame casts it, on debug_look.json5's log ramp: the steps of the beam ray its cell starts off (beam::LINE_STEPS) and its own after, or, where it took a voxel or the sky without a walk, those of the sample before it on the camera grid's lattice, counted the same way (beam::SAMPLE_STEPS_SHIFT; rust/client/render/src/frame/shader/cast.wgsl `taken_word`, queue.wgsl `finish`).",
      kind: { $value: "toggle" },
      default: { $value: false },
      section: { $value: "debug" },
    },
    ray_cnt: {
      number: { $value: 20, $type: "u32" },
      $description: "Counts what the eye's cast and the sun's shadow map do: the nodes each pass's walks asked, the pixels or slots that took the visible sample or walked, and the boxes drawn. The GPU counts them and writes them into the profiler's ray lanes of the frame that counted them (rust/client/engine/src/count.rs, rust/client/render/src/ray/count.rs). The counting's atomics run inside the cast's spans, so time the cast with this off.",
      kind: { $value: "toggle" },
      default: { $value: false },
      section: { $value: "perf" },
      dev: { $value: true },
    },
    sky_time: {
      number: { $value: 21, $type: "u32" },
      kind: { $value: "choice" },
      default: { $value: "real" },
      options: { $value: "SKY_TIME" },
      section: { $value: "debug" },
      dev: { $value: true },
      stored: { $value: false },
    },
  },
}
