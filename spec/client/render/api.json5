{
  $description: "pixelet's conventions over the GPU's calls (spec/gpu/api.json5), which\nthe renderer writes through the GPU's encoder (gpu/api.rs): the stream it writes\nthem into, its pipeline records' codes, and what a surface shows.",
  surface_role: {
    $type: "u32",
    $description: "What a canvas the UI hands over shows (gpu/surface.rs): the world, a character alone, or\nnothing yet, as a canvas opens before the UI says what it draws.",
    WORLD: { $value: 0 },
    CHARACTER: { $value: 1 },
    NONE: { $value: 2 },
  },
  stream: {
    $type: "u32",
    $description: "The one place the renderer's calls cross (gpu/api.rs): a stream\n(pxl-gpu-guest stream.rs) in the front of the core's memory, which the\ncore writes its calls into during an entry and the host runs once the entry\nhas returned. Its size is `SZ`.\n\nIts head, past the stream's own words, is what the host writes for the\ncore: the device's block (spec/gpu/api.json5 DEVICE) and the timed spans' reads, three\nof them (gpu/api.rs `READ_CAP`), each its word, then each span's begin and end\nticks. gpu/api.rs lays them out, and the stream says the head's length itself.",
    SZ: {
      $value: 4194304,
      $description: "The stream's room: what one entry may send the device, then at its end the\nencoder's handle table, a product number said rather than derived. The\nstream says its own head.",
    },
    RESERVE: {
      $value: 1048576,
      $description: "What an upload leaves of the range. The records a frame cannot put off — a\nframe's passes and draws, the renderer's pipelines — are never refused, so\nan upload, or a shader module made before the renderer (`MODULE_SZ`),\nwhich can wait a frame, is taken only while this much is left after it.",
    },
    MODULE_SZ: {
      $value: 131072,
      $description: "The WGSL a frame hands the device as shader modules before the renderer is\nmade (gpu/pipeline.rs `PipelineCache::make_modules`): one module a frame, then\nmore while their sources stay within this and `RESERVE` is left. A page\nmakes a module on its main thread, so this bounds the task that makes\nthem, a module larger than it alone in its frame.",
    },
  },
  device: {
    $type: "u32",
    $description: "What the GPU's host runs the renderer's stream by (pxl-gpu-link and @pxl/gpu/link\n`GpuConfig`), the same on a device, where the runtime hands it (pxl-runtime lib.rs `GPU`),\nand on a page, where the page's worker hands it (ts/client runtime/worker.ts).",
    FRAME_LATENCY: {
      $value: 2,
      $description: "The frames drawn and not yet finished on the GPU at once: a frame draws only\nwhile fewer are (pxl-gpu-guest `admit::frame`), and a surface queues as\nmany. Two, as wgpu configures a surface by default\n(`Surface::get_default_config`): one frame's lag behind the input, with the\nGPU kept busy while the next is drawn.",
    },
    UPLOAD_CHUNK_SZ: {
      $value: 1048576,
      $description: "The chunk the host stages buffer writes in, each mapped once and reused: a\nmesh, the largest write a frame makes, is about a MiB, and a larger write\ntakes a chunk of its own.",
    },
    POWER: {
      $value: "high-performance",
      $description: "WebGPU's power preference, which the device is asked with (pxl-gpu-link and\n@pxl/gpu/link `GpuAsk`, pxl-gpu-host `Ask::of`).",
    },
    REQUIRED_FEATURES: {
      $value: ["depth32float-stencil8"],
      $description: "The WebGPU features the device must have: a depth-stencil format the\nrenderer draws with.",
    },
    OPTIONAL_FEATURES: {
      $value: ["timestamp-query"],
      $description: "The WebGPU features the device takes where the adapter has them: timestamps,\nfor the timed spans.",
    },
  },
  record: {
    $type: "u32",
    $description: "A pipeline record's codes (frame/shader/record.rs, expanded into xpute's\ndescriptors by gpu/api.rs), and HDR, the words it opens with before its\nvertex buffers. Then: the topology, the cull mode, the depth compare under\nreversed Z (LESS is plain depth, for a depth-only pass; NO_DEPTH, no\ndepth attachment), the blend, which vertex entry point of\nits shader the pipeline enters, a vertex step and format, and a binding's\nkind (its stages are xpute's SHADER_STAGE) — TEXTURE_UNFILTERED a texture in a\nformat no sampler\nfilters (RGBA32F), read by textureLoad alone; TEXTURE_UINT_ARRAY a u32\ntexture's layers, read by textureLoad; STORAGE_TEXTURE_RW an r32uint\ntexture's layers read and written in place, the one format family WebGPU\nlets a shader do both to; TEXTURE_3D a filtered volume (the air's,\npass/atmosphere.rs); STORAGE_TEXTURE_3D an rgba16float volume a compute\npass writes, STORAGE_TEXTURE_2D an rgba16float texture one writes (the\nexposure's texel, pass/atmosphere.rs); SAMPLER_COMPARISON a sampler that\ncompares a depth texture's texels against a reference (the light's shadow\nmap, pass/shadow.rs).",
    HDR: { $value: 10 },
    TRIANGLES: { $value: 0 },
    STRIP: { $value: 1 },
    CULL_NONE: { $value: 0 },
    CULL_BACK: { $value: 1 },
    ALWAYS: { $value: 0 },
    GREATER: { $value: 1 },
    GREATER_EQUAL: { $value: 2 },
    LESS: { $value: 3 },
    NO_DEPTH: { $value: 4 },
    OPAQUE: { $value: 0 },
    ALPHA: { $value: 1 },
    ADD: { $value: 2 },
    VS: { $value: 0 },
    VS_PLACE: { $value: 1 },
    PER_VERTEX: { $value: 0 },
    PER_INSTANCE: { $value: 1 },
    U32: { $value: 5 },
    U32X2: { $value: 6 },
    F32X2: { $value: 1 },
    F32X3: { $value: 2 },
    F32X4: { $value: 3 },
    U32X4: { $value: 4 },
    UNIFORM: { $value: 0 },
    UNIFORM_DYNAMIC: { $value: 1 },
    STORAGE: { $value: 2 },
    TEXTURE: { $value: 3 },
    TEXTURE_ARRAY: { $value: 4 },
    DEPTH: { $value: 5 },
    SAMPLER: { $value: 6 },
    SAMPLER_COMPARISON: { $value: 7 },
    TEXTURE_UNFILTERED: { $value: 8 },
    STORAGE_RW: { $value: 9 },
    TEXTURE_UINT_ARRAY: { $value: 10 },
    STORAGE_TEXTURE_RW: { $value: 11 },
    TEXTURE_3D: { $value: 12 },
    STORAGE_TEXTURE_3D: { $value: 13 },
    STORAGE_TEXTURE_2D: { $value: 14 },
  },
}
