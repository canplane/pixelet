package pxl:gpu@0.1.0;

// The GPU, which the host implements: it runs the stream's records
// (spec/gpu/api.json5) on a device, which a guest takes from
// `get-device`.
interface gpu {
  use xpute:link/types@0.1.0.{lent};

  // Why a device is not ready.
  enum error-code {
    // The host has no device to give.
    no-device,
  }

  // Runs the records lent on the device, where one is held, and answers once
  // done: until then the records, and the memory they name, are the host's.
  run: async func(recs: lent);

  // The device, a handle the host issues, which the guest lets go of as it
  // drops; named in WASI's `get-` form, as a resource holds the plain name.
  get-device: func() -> device;

  resource device {
    // Lends `block` (spec/gpu/api.json5 DEVICE, which lays it out) for the
    // host to write while a device is held. It answers when the device is
    // lost, and the block is the guest's again.
    lost: async func(block: lent);
    // Asks for a device, and answers once it is ready, its block written.
    ready: async func() -> result<_, error-code>;
    // Answers once a completion a record asked for has landed: a fence, a
    // read or a pipeline the host stored into the guest's memory.
    settled: async func();
  }
}
