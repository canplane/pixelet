package pxl:gpu@0.1.0;

// The display's vsync, which the host implements beside the GPU: a display's
// refresh belongs to whoever holds the surface.
interface vsync {
  use xpute:clocks/monotonic-clock@0.1.0.{mark};

  // Answers at the display's next vsync, with the start of its frame on the
  // host's monotonic clock, the clock `monotonic-clock.now` reads.
  next: async func() -> mark;
}
