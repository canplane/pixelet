{
  $description: "WebGPU's own enumerations. Each one lists its WebGPU spec's strings in order, and a\nmember's number is its place in that list. A host hands the device the string as it\nis, and a guest names a member by its generated constant. Nothing here belongs to any one\nprogram. A value that WebGPU leaves optional is NONE (api.json5) when it is unset.",
  TEXTURE_FORMAT: {
    $type: "enum",
    $description: "GPUTextureFormat: the formats of the core WebGPU spec and of its texture-compression\nfeatures.",
    $value: [
      "r8unorm",
      "r8snorm",
      "r8uint",
      "r8sint",
      "r16uint",
      "r16sint",
      "r16float",
      "rg8unorm",
      "rg8snorm",
      "rg8uint",
      "rg8sint",
      "r32uint",
      "r32sint",
      "r32float",
      "rg16uint",
      "rg16sint",
      "rg16float",
      "rgba8unorm",
      "rgba8unorm-srgb",
      "rgba8snorm",
      "rgba8uint",
      "rgba8sint",
      "bgra8unorm",
      "bgra8unorm-srgb",
      "rgb9e5ufloat",
      "rgb10a2uint",
      "rgb10a2unorm",
      "rg11b10ufloat",
      "rg32uint",
      "rg32sint",
      "rg32float",
      "rgba16uint",
      "rgba16sint",
      "rgba16float",
      "rgba32uint",
      "rgba32sint",
      "rgba32float",
      "stencil8",
      "depth16unorm",
      "depth24plus",
      "depth24plus-stencil8",
      "depth32float",
      "depth32float-stencil8",
      "bc1-rgba-unorm",
      "bc1-rgba-unorm-srgb",
      "bc2-rgba-unorm",
      "bc2-rgba-unorm-srgb",
      "bc3-rgba-unorm",
      "bc3-rgba-unorm-srgb",
      "bc4-r-unorm",
      "bc4-r-snorm",
      "bc5-rg-unorm",
      "bc5-rg-snorm",
      "bc6h-rgb-ufloat",
      "bc6h-rgb-float",
      "bc7-rgba-unorm",
      "bc7-rgba-unorm-srgb",
      "etc2-rgb8unorm",
      "etc2-rgb8unorm-srgb",
      "etc2-rgb8a1unorm",
      "etc2-rgb8a1unorm-srgb",
      "etc2-rgba8unorm",
      "etc2-rgba8unorm-srgb",
      "eac-r11unorm",
      "eac-r11snorm",
      "eac-rg11unorm",
      "eac-rg11snorm",
      "astc-4x4-unorm",
      "astc-4x4-unorm-srgb",
      "astc-5x4-unorm",
      "astc-5x4-unorm-srgb",
      "astc-5x5-unorm",
      "astc-5x5-unorm-srgb",
      "astc-6x5-unorm",
      "astc-6x5-unorm-srgb",
      "astc-6x6-unorm",
      "astc-6x6-unorm-srgb",
      "astc-8x5-unorm",
      "astc-8x5-unorm-srgb",
      "astc-8x6-unorm",
      "astc-8x6-unorm-srgb",
      "astc-8x8-unorm",
      "astc-8x8-unorm-srgb",
      "astc-10x5-unorm",
      "astc-10x5-unorm-srgb",
      "astc-10x6-unorm",
      "astc-10x6-unorm-srgb",
      "astc-10x8-unorm",
      "astc-10x8-unorm-srgb",
      "astc-10x10-unorm",
      "astc-10x10-unorm-srgb",
      "astc-12x10-unorm",
      "astc-12x10-unorm-srgb",
      "astc-12x12-unorm",
      "astc-12x12-unorm-srgb",
    ],
    $extensions: { xpute: { names: true } },
  },
  VERTEX_FORMAT: {
    $type: "enum",
    $description: "These are the members of GPUVertexFormat.",
    $value: [
      "uint8",
      "uint8x2",
      "uint8x4",
      "sint8",
      "sint8x2",
      "sint8x4",
      "unorm8",
      "unorm8x2",
      "unorm8x4",
      "snorm8",
      "snorm8x2",
      "snorm8x4",
      "uint16",
      "uint16x2",
      "uint16x4",
      "sint16",
      "sint16x2",
      "sint16x4",
      "unorm16",
      "unorm16x2",
      "unorm16x4",
      "snorm16",
      "snorm16x2",
      "snorm16x4",
      "float16",
      "float16x2",
      "float16x4",
      "float32",
      "float32x2",
      "float32x3",
      "float32x4",
      "uint32",
      "uint32x2",
      "uint32x3",
      "uint32x4",
      "sint32",
      "sint32x2",
      "sint32x3",
      "sint32x4",
      "unorm10-10-10-2",
      "unorm8x4-bgra",
    ],
    $extensions: { xpute: { names: true } },
  },
  PRIMITIVE_TOPOLOGY: {
    $type: "enum",
    $value: [
      "point-list",
      "line-list",
      "line-strip",
      "triangle-list",
      "triangle-strip",
    ],
    $extensions: { xpute: { names: true } },
  },
  INDEX_FORMAT: {
    $type: "enum",
    $value: ["uint16", "uint32"],
    $extensions: { xpute: { names: true } },
  },
  FRONT_FACE: {
    $type: "enum",
    $value: ["ccw", "cw"],
    $extensions: { xpute: { names: true } },
  },
  CULL_MODE: {
    $type: "enum",
    $value: ["none", "front", "back"],
    $extensions: { xpute: { names: true } },
  },
  COMPARE_FUNCTION: {
    $type: "enum",
    $value: [
      "never",
      "less",
      "equal",
      "less-equal",
      "greater",
      "not-equal",
      "greater-equal",
      "always",
    ],
    $extensions: { xpute: { names: true } },
  },
  STENCIL_OPERATION: {
    $type: "enum",
    $value: [
      "keep",
      "zero",
      "replace",
      "invert",
      "increment-clamp",
      "decrement-clamp",
      "increment-wrap",
      "decrement-wrap",
    ],
    $extensions: { xpute: { names: true } },
  },
  BLEND_OPERATION: {
    $type: "enum",
    $value: ["add", "subtract", "reverse-subtract", "min", "max"],
    $extensions: { xpute: { names: true } },
  },
  BLEND_FACTOR: {
    $type: "enum",
    $value: [
      "zero",
      "one",
      "src",
      "one-minus-src",
      "src-alpha",
      "one-minus-src-alpha",
      "dst",
      "one-minus-dst",
      "dst-alpha",
      "one-minus-dst-alpha",
      "src-alpha-saturated",
      "constant",
      "one-minus-constant",
      "src1",
      "one-minus-src1",
      "src1-alpha",
      "one-minus-src1-alpha",
    ],
    $extensions: { xpute: { names: true } },
  },
  VERTEX_STEP_MODE: {
    $type: "enum",
    $value: ["vertex", "instance"],
    $extensions: { xpute: { names: true } },
  },
  ADDRESS_MODE: {
    $type: "enum",
    $value: ["clamp-to-edge", "repeat", "mirror-repeat"],
    $extensions: { xpute: { names: true } },
  },
  FILTER_MODE: {
    $type: "enum",
    $value: ["nearest", "linear"],
    $extensions: { xpute: { names: true } },
  },
  MIPMAP_FILTER_MODE: {
    $type: "enum",
    $value: ["nearest", "linear"],
    $extensions: { xpute: { names: true } },
  },
  TEXTURE_DIMENSION: {
    $type: "enum",
    $value: ["1d", "2d", "3d"],
    $extensions: { xpute: { names: true } },
  },
  TEXTURE_VIEW_DIMENSION: {
    $type: "enum",
    $value: ["1d", "2d", "2d-array", "cube", "cube-array", "3d"],
    $extensions: { xpute: { names: true } },
  },
  TEXTURE_ASPECT: {
    $type: "enum",
    $value: ["all", "stencil-only", "depth-only"],
    $extensions: { xpute: { names: true } },
  },
  BUFFER_BINDING_TYPE: {
    $type: "enum",
    $value: ["uniform", "storage", "read-only-storage"],
    $extensions: { xpute: { names: true } },
  },
  SAMPLER_BINDING_TYPE: {
    $type: "enum",
    $value: ["filtering", "non-filtering", "comparison"],
    $extensions: { xpute: { names: true } },
  },
  TEXTURE_SAMPLE_TYPE: {
    $type: "enum",
    $value: ["float", "unfilterable-float", "depth", "sint", "uint"],
    $extensions: { xpute: { names: true } },
  },
  STORAGE_TEXTURE_ACCESS: {
    $type: "enum",
    $value: ["write-only", "read-only", "read-write"],
    $extensions: { xpute: { names: true } },
  },
  LOAD_OP: {
    $type: "enum",
    $value: ["load", "clear"],
    $extensions: { xpute: { names: true } },
  },
  STORE_OP: {
    $type: "enum",
    $value: ["store", "discard"],
    $extensions: { xpute: { names: true } },
  },
  QUERY_TYPE: {
    $type: "enum",
    $value: ["occlusion", "timestamp"],
    $extensions: { xpute: { names: true } },
  },
  CANVAS_ALPHA_MODE: {
    $type: "enum",
    $value: ["opaque", "premultiplied"],
    $extensions: { xpute: { names: true } },
  },
  FEATURE_NAME: {
    $type: "enum",
    $description: "GPUFeatureName. The DEVICE block (api.json5) holds a device's features as one bit each,\nat the member's place.",
    $value: [
      "depth-clip-control",
      "depth32float-stencil8",
      "texture-compression-bc",
      "texture-compression-bc-sliced-3d",
      "texture-compression-etc2",
      "texture-compression-astc",
      "texture-compression-astc-sliced-3d",
      "timestamp-query",
      "indirect-first-instance",
      "shader-f16",
      "rg11b10ufloat-renderable",
      "bgra8unorm-storage",
      "float32-filterable",
      "float32-blendable",
      "clip-distances",
      "dual-source-blending",
      "subgroups",
    ],
    $extensions: { xpute: { names: true } },
  },
  LIMIT_NAME: {
    $type: "enum",
    $description: "The members of GPUSupportedLimits. The DEVICE block (api.json5) holds a device's limits\nas one word each, at the member's place.",
    $value: [
      "maxTextureDimension1D",
      "maxTextureDimension2D",
      "maxTextureDimension3D",
      "maxTextureArrayLayers",
      "maxBindGroups",
      "maxBindGroupsPlusVertexBuffers",
      "maxBindingsPerBindGroup",
      "maxDynamicUniformBuffersPerPipelineLayout",
      "maxDynamicStorageBuffersPerPipelineLayout",
      "maxSampledTexturesPerShaderStage",
      "maxSamplersPerShaderStage",
      "maxStorageBuffersPerShaderStage",
      "maxStorageTexturesPerShaderStage",
      "maxUniformBuffersPerShaderStage",
      "maxUniformBufferBindingSize",
      "maxStorageBufferBindingSize",
      "minUniformBufferOffsetAlignment",
      "minStorageBufferOffsetAlignment",
      "maxVertexBuffers",
      "maxBufferSize",
      "maxVertexAttributes",
      "maxVertexBufferArrayStride",
      "maxInterStageShaderVariables",
      "maxColorAttachments",
      "maxColorAttachmentBytesPerSample",
      "maxComputeWorkgroupStorageSize",
      "maxComputeInvocationsPerWorkgroup",
      "maxComputeWorkgroupSizeX",
      "maxComputeWorkgroupSizeY",
      "maxComputeWorkgroupSizeZ",
      "maxComputeWorkgroupsPerDimension",
    ],
    $extensions: { xpute: { names: true } },
  },
}
