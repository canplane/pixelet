{
  "$doc": [
    "The ledger's records and blocks as the kernel lays them out and the shell reads",
    "them in place (sched/ledger/record.rs, apps/web/src/feature/dev/ledger/view.ts):",
    "word offsets, eight bytes a word, and the names the numbers index. Nothing is",
    "built for a read: the kernel writes numbers where they stay, and the words for",
    "them are the shell's."
  ],
  "CENSUS_TAGS": [
    "chunk",
    "decor",
    "ghost_box",
    "ghost_coplanar",
    "ghost_decor",
    "skinned",
    "puck_zone",
    "puck_beacon",
    "badge",
    "debug"
  ],
  "PHASE_NAMES": [
    "interaction",
    "visible",
    "content",
    "cosmetic",
    "report"
  ],
  "CATEGORY_NAMES": [
    "terrain",
    "ocean",
    "poi"
  ],
  "OUTCOME_NAMES": [
