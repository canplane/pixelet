{
  $description: "A frame is one method called across the link, four 32-bit words; TAG, CMD, RESULT and\nPKT are their indices, little-endian. The tag is the request, unique among the sender's\npending ones, and a later answer carries it back. The command is the RES bit, the handle\nthe callee issued above METHOD_BITS, and the method's place among its object's below\nthem. An answer carries 0 or a negative errno, its value in its packet. The method's args, a packet in the Canonical ABI's layout,\nlie right past the words, and PKT says how long they are (link/wit/types.wit). ROOT\nis the handle every side implements, OPEN, CANCEL and OPEN_AT its methods, DROP the method\nevery handle has, NAMED marks an interface's handle, SLOT_BITS splits an issued handle\ninto its slot and its generation, and TRAP and TRAP_AT are a native guest's stop.",
  TAG: {
    $value: 0,
    $type: "u32",
    $description: "The request, which a later answer carries back.",
  },
  CMD: {
    $value: 1,
    $type: "u32",
    $description: "RES, the handle and the method.",
  },
  RESULT: {
    $value: 2,
    $type: "u32",
    $description: "On an answer, 0 or a negative errno: the call refused, by the link or by the method as a caller's bug (EINVAL), or a method's failure where its WIT has no result; on a request, 0.",
  },
  PKT: {
    $value: 3,
    $type: "u32",
    $description: "The length in bytes of the frame's packet, which lies right past its words; 0 when it has none.",
  },
  WORDS: {
    $value: 4,
    $type: "u32",
    $description: "The frame's length in words.",
  },
  RES: {
    $value: 2147483648,
    $type: "u32",
    $description: "The bit of the command that marks an answer.",
  },
  METHOD_BITS: {
    $value: 8,
    $type: "u32",
    $description: "The bits of the command below the handle, which hold the method.",
  },
  ROOT: {
    $value: 0,
    $type: "u32",
    $description: "The root's handle, which every side implements.",
  },
  OPEN: {
    $value: 0,
    $type: "u32",
    $description: "The root's method that opens an object by its URI.",
  },
  CANCEL: {
    $value: 1,
    $type: "u32",
    $description: "The root's method that cancels a call the sender has pending, named by its tag, the one\narg. A call the callee can stop it stops, and answers ECANCELED; any other runs on. Either\nway it settles by its own answer, and what it lent stays lent until then.",
  },
  OPEN_AT: {
    $value: 2,
    $type: "u32",
    $description: "The root's method that opens an object under a handle the sender has issued for it:\nthe handle, which of the receiver's mounted openers opens it, by its place among them, and\nthe URI. A runtime that stands in for a UI on another thread answers the guest's open at\nonce, issuing the handle, and carries the open to the UI's end as this. It takes no\nanswer.",
  },
  DROP: {
    $value: 255,
    $type: "u32",
    $description: "The method every handle has, which lets it go.",
  },
  NAMED: {
    $value: 4194304,
    $type: "u32",
    $description: "The handle's top bit, which marks it named: an interface's, its bits below the hash of\nthe interface's name the generator writes (xpute-link-gen wit.rs). An interface with\nfunctions of its own is mounted under it with no open; one of resources alone names its\nopeners by it. An issued handle has it clear.",
  },
  SLOT_BITS: {
    $value: 20,
    $type: "u32",
    $description: "The bits of a handle that name its slot, below its generation.",
  },
  TRAP: {
    $value: -2147483648,
    $type: "i32",
    $description: "What a native guest's export answers where the guest stopped, caught at the export so nothing leaves into its caller: as a module's trap. The guest is over, and its host enters it no more.",
  },
  TRAP_AT: {
    $value: 4294967295,
    $type: "u64",
    $description: "What a native guest's link_init answers in its layout's place where the guest stopped, as TRAP is for its other exports: an odd address, where no layout lies.",
  },
  LAYOUT: {
    $description: "The words of the link's layout, which a guest's link_init lays and answers the address\nof: the inbox's address, a u64 in two words, its low word first, then a frame's cap, then a\nword unused, so the inbox, which follows the layout's words, lies on 8 bytes. The outbox\nfollows the inbox.",
    $extensions: { xpute: { packed: true } },
    INBOX_AT: { $value: 2 },
    CAP_AT: { $value: 1 },
    PAD_AT: { $value: 1 },
  },
}
