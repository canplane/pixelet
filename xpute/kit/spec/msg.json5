{
  $description: "A message is what a person reads of what xpute tells: of an error, beside its errno and its\nplace; of a bug, beside those and its two numbers; of a log record, beside its level and\nits context. It is bounded text: its maker cuts a longer one at a character boundary\n(status/msg `cut_msg`), so nothing that carries one meets one past the cap. The text told\nbeside it, a place's file and a record's context, is held to the same cap by the same cut.",
  MSG_CAP: {
    $value: 512,
    $type: "u32",
    $description: "The most bytes of UTF-8 a message holds.",
  },
}
