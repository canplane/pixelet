{
  "$doc": ["POSIX/Linux-aligned negative errno"],
  "ERRNO": {
    "$type": "enum",
    "$repr": "i32",
    "OK": { "$number": 0, "text": "Success" },
    "EPERM": { "$number": -1, "text": "Operation not permitted" },
    "ENOENT": { "$number": -2, "text": "No such file or directory / entry not found" },
    "ESRCH": { "$number": -3, "text": "No such process" },
    "EINTR": { "$number": -4, "text": "Interrupted system call" },
    "EIO": { "$number": -5, "text": "I/O error" },
    "ENXIO": { "$number": -6, "text": "No such device or address" },
    "E2BIG": { "$number": -7, "text": "Argument list too long / object too large for fixed local cap" },
    "ENOEXEC": { "$number": -8, "text": "Exec format error" },
    "EBADF": { "$number": -9, "text": "Bad file descriptor / bad handle" },
    "ECHILD": { "$number": -10, "text": "No child processes" },
    "EAGAIN": { "$number": -11, "text": "Try again / Resource temporarily unavailable" },
    "ENOMEM": { "$number": -12, "text": "Out of memory" },
    "EACCES": { "$number": -13, "text": "Permission denied" },
    "EFAULT": { "$number": -14, "text": "Bad address" },
    "EBUSY": { "$number": -16, "text": "Device or resource busy" },
    "EEXIST": { "$number": -17, "text": "File exists / duplicate bind" },
    "EXDEV": { "$number": -18, "text": "Cross-device link" },
    "ENODEV": { "$number": -19, "text": "No such device" },
    "ENOTDIR": { "$number": -20, "text": "Not a directory" },
    "EISDIR": { "$number": -21, "text": "Is a directory" },
    "EINVAL": { "$number": -22, "text": "Invalid argument" },
    "ENFILE": { "$number": -23, "text": "File table overflow (system-wide)" },
    "EMFILE": { "$number": -24, "text": "Too many open files (process)" },
    "ENOTTY": { "$number": -25, "text": "Not a tty" },
    "EFBIG": { "$number": -27, "text": "File too large / payload too large" },
    "ENOSPC": { "$number": -28, "text": "No space left on device / local mailbox full" },
    "ESPIPE": { "$number": -29, "text": "Illegal seek" },
    "EROFS": { "$number": -30, "text": "Read-only file system" },
    "EMLINK": { "$number": -31, "text": "Too many links" },
    "EPIPE": { "$number": -32, "text": "Broken pipe" },
    "EDOM": { "$number": -33, "text": "Math argument out of domain" },
    "ERANGE": { "$number": -34, "text": "Math result not representable" },
    "ENOSYS": { "$number": -38, "text": "Function not implemented" },
    "EPROTO": { "$number": -71, "text": "Protocol error" },
    "EBADMSG": { "$number": -74, "text": "Bad message (protocol/frame/payload invalid)" },
    "EOVERFLOW": { "$number": -75, "text": "Value too large for target type / overflow" },
    "EMSGSIZE": { "$number": -90, "text": "Message too long / packet too large" },
    "ENOTSUP": { "$number": -95, "text": "Operation not supported" },
    "EILSEQ": { "$number": -84, "text": "Illegal byte sequence (decode/encoding failure)" },
    "EADDRINUSE": { "$number": -98, "text": "Address already in use" },
    "EADDRNOTAVAIL": { "$number": -99, "text": "Cannot assign requested address" },
    "ENETDOWN": { "$number": -100, "text": "Network is down" },
    "ENETUNREACH": { "$number": -101, "text": "Network is unreachable" },
    "ENETRESET": { "$number": -102, "text": "Network dropped connection because of reset" },
    "ECONNABORTED": { "$number": -103, "text": "Software caused connection abort" },
    "ECONNRESET": { "$number": -104, "text": "Connection reset by peer" },
    "ENOBUFS": { "$number": -105, "text": "No buffer space available" },
    "EISCONN": { "$number": -106, "text": "Transport endpoint is already connected" },
    "ENOTCONN": { "$number": -107, "text": "Transport endpoint is not connected" },
    "ESHUTDOWN": { "$number": -108, "text": "Cannot send after transport endpoint shutdown" },
    "ETOOMANYREFS": { "$number": -109, "text": "Too many references" },
    "ETIMEDOUT": { "$number": -110, "text": "Connection timed out" },
    "ECONNREFUSED": { "$number": -111, "text": "Connection refused" },
    "EHOSTDOWN": { "$number": -112, "text": "Runtime is down" },
    "EHOSTUNREACH": { "$number": -113, "text": "No route to runtime" },
    "EALREADY": { "$number": -114, "text": "Operation already in progress" },
    "EINPROGRESS": { "$number": -115, "text": "Operation now in progress" },
    "ECANCELED": { "$number": -125, "text": "Operation canceled" },
    "ENOTRECOVERABLE": { "$number": -131, "text": "State not recoverable: an invariant the code stands on does not hold" }
  }
}
