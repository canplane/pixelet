{
  "$doc": ["POSIX/Linux-aligned negative errno"],
  "KIND": {
    "$type": "enum",
    "$doc": [
      "What an errno says happened: the canonical status code of gRPC and Abseil",
      "(absl::StatusCode), by its number there, each errno's as Abseil's",
      "ErrnoToStatusCode maps it, save that ENOTRECOVERABLE is internal, and",
      "EBADMSG and EILSEQ data_loss. It says nothing of whether the error is",
      "fatal: a broken invariant is a bug, which stops the program."
    ],
    "ok": 0,
    "cancelled": 1,
    "unknown": 2,
    "invalid_argument": 3,
    "deadline_exceeded": 4,
    "not_found": 5,
    "already_exists": 6,
    "permission_denied": 7,
    "resource_exhausted": 8,
    "failed_precondition": 9,
    "out_of_range": 11,
    "unimplemented": 12,
    "internal": 13,
    "unavailable": 14,
    "data_loss": 15
  },
  "ERRNO": {
    "$type": "enum",
    "$repr": "i32",
    "$outside": true,
    "OK": { "$number": 0, "text": "Success", "kind": { "$type": "Kind", "$val": "ok" } },
    "EPERM": { "$number": -1, "text": "Operation not permitted", "kind": { "$type": "Kind", "$val": "permission_denied" } },
    "ENOENT": { "$number": -2, "text": "No such file or directory / entry not found", "kind": { "$type": "Kind", "$val": "not_found" } },
    "ESRCH": { "$number": -3, "text": "No such process", "kind": { "$type": "Kind", "$val": "not_found" } },
    "EINTR": { "$number": -4, "text": "Interrupted system call", "kind": { "$type": "Kind", "$val": "unavailable" } },
    "EIO": { "$number": -5, "text": "I/O error", "kind": { "$type": "Kind", "$val": "unknown" } },
    "ENXIO": { "$number": -6, "text": "No such device or address", "kind": { "$type": "Kind", "$val": "not_found" } },
    "E2BIG": { "$number": -7, "text": "Argument list too long / object too large for fixed local cap", "kind": { "$type": "Kind", "$val": "invalid_argument" } },
    "ENOEXEC": { "$number": -8, "text": "Exec format error", "kind": { "$type": "Kind", "$val": "unknown" } },
    "EBADF": { "$number": -9, "text": "Bad file descriptor / bad handle", "kind": { "$type": "Kind", "$val": "failed_precondition" } },
    "ECHILD": { "$number": -10, "text": "No child processes", "kind": { "$type": "Kind", "$val": "failed_precondition" } },
    "EAGAIN": { "$number": -11, "text": "Try again / Resource temporarily unavailable", "kind": { "$type": "Kind", "$val": "unavailable" } },
    "ENOMEM": { "$number": -12, "text": "Out of memory", "kind": { "$type": "Kind", "$val": "resource_exhausted" } },
    "EACCES": { "$number": -13, "text": "Permission denied", "kind": { "$type": "Kind", "$val": "permission_denied" } },
    "EFAULT": { "$number": -14, "text": "Bad address", "kind": { "$type": "Kind", "$val": "invalid_argument" } },
    "EBUSY": { "$number": -16, "text": "Device or resource busy", "kind": { "$type": "Kind", "$val": "failed_precondition" } },
    "EEXIST": { "$number": -17, "text": "File exists / duplicate bind", "kind": { "$type": "Kind", "$val": "already_exists" } },
    "EXDEV": { "$number": -18, "text": "Cross-device link", "kind": { "$type": "Kind", "$val": "unimplemented" } },
    "ENODEV": { "$number": -19, "text": "No such device", "kind": { "$type": "Kind", "$val": "not_found" } },
    "ENOTDIR": { "$number": -20, "text": "Not a directory", "kind": { "$type": "Kind", "$val": "failed_precondition" } },
    "EISDIR": { "$number": -21, "text": "Is a directory", "kind": { "$type": "Kind", "$val": "failed_precondition" } },
    "EINVAL": { "$number": -22, "text": "Invalid argument", "kind": { "$type": "Kind", "$val": "invalid_argument" } },
    "ENFILE": { "$number": -23, "text": "File table overflow (system-wide)", "kind": { "$type": "Kind", "$val": "resource_exhausted" } },
    "EMFILE": { "$number": -24, "text": "Too many open files (process)", "kind": { "$type": "Kind", "$val": "resource_exhausted" } },
    "ENOTTY": { "$number": -25, "text": "Not a tty", "kind": { "$type": "Kind", "$val": "invalid_argument" } },
    "EFBIG": { "$number": -27, "text": "File too large / payload too large", "kind": { "$type": "Kind", "$val": "out_of_range" } },
    "ENOSPC": { "$number": -28, "text": "No space left on device / local mailbox full", "kind": { "$type": "Kind", "$val": "resource_exhausted" } },
    "ESPIPE": { "$number": -29, "text": "Illegal seek", "kind": { "$type": "Kind", "$val": "invalid_argument" } },
    "EROFS": { "$number": -30, "text": "Read-only file system", "kind": { "$type": "Kind", "$val": "permission_denied" } },
    "EMLINK": { "$number": -31, "text": "Too many links", "kind": { "$type": "Kind", "$val": "resource_exhausted" } },
    "EPIPE": { "$number": -32, "text": "Broken pipe", "kind": { "$type": "Kind", "$val": "failed_precondition" } },
    "EDOM": { "$number": -33, "text": "Math argument out of domain", "kind": { "$type": "Kind", "$val": "invalid_argument" } },
    "ERANGE": { "$number": -34, "text": "Math result not representable", "kind": { "$type": "Kind", "$val": "out_of_range" } },
    "ENOSYS": { "$number": -38, "text": "Function not implemented", "kind": { "$type": "Kind", "$val": "unimplemented" } },
    "EPROTO": { "$number": -71, "text": "Protocol error", "kind": { "$type": "Kind", "$val": "unknown" } },
    "EBADMSG": { "$number": -74, "text": "Bad message (protocol/frame/payload invalid)", "kind": { "$type": "Kind", "$val": "data_loss" } },
    "EOVERFLOW": { "$number": -75, "text": "Value too large for target type / overflow", "kind": { "$type": "Kind", "$val": "out_of_range" } },
    "EMSGSIZE": { "$number": -90, "text": "Message too long / packet too large", "kind": { "$type": "Kind", "$val": "unknown" } },
    "ENOTSUP": { "$number": -95, "text": "Operation not supported", "kind": { "$type": "Kind", "$val": "unimplemented" } },
    "EILSEQ": { "$number": -84, "text": "Illegal byte sequence (decode/encoding failure)", "kind": { "$type": "Kind", "$val": "data_loss" } },
    "EADDRINUSE": { "$number": -98, "text": "Address already in use", "kind": { "$type": "Kind", "$val": "failed_precondition" } },
    "EADDRNOTAVAIL": { "$number": -99, "text": "Cannot assign requested address", "kind": { "$type": "Kind", "$val": "already_exists" } },
    "ENETDOWN": { "$number": -100, "text": "Network is down", "kind": { "$type": "Kind", "$val": "unavailable" } },
    "ENETUNREACH": { "$number": -101, "text": "Network is unreachable", "kind": { "$type": "Kind", "$val": "unavailable" } },
    "ENETRESET": { "$number": -102, "text": "Network dropped connection because of reset", "kind": { "$type": "Kind", "$val": "unavailable" } },
    "ECONNABORTED": { "$number": -103, "text": "Software caused connection abort", "kind": { "$type": "Kind", "$val": "unavailable" } },
    "ECONNRESET": { "$number": -104, "text": "Connection reset by peer", "kind": { "$type": "Kind", "$val": "unavailable" } },
    "ENOBUFS": { "$number": -105, "text": "No buffer space available", "kind": { "$type": "Kind", "$val": "resource_exhausted" } },
    "EISCONN": { "$number": -106, "text": "Transport endpoint is already connected", "kind": { "$type": "Kind", "$val": "failed_precondition" } },
    "ENOTCONN": { "$number": -107, "text": "Transport endpoint is not connected", "kind": { "$type": "Kind", "$val": "failed_precondition" } },
    "ESHUTDOWN": { "$number": -108, "text": "Cannot send after transport endpoint shutdown", "kind": { "$type": "Kind", "$val": "failed_precondition" } },
    "ETOOMANYREFS": { "$number": -109, "text": "Too many references", "kind": { "$type": "Kind", "$val": "unknown" } },
    "ETIMEDOUT": { "$number": -110, "text": "Connection timed out", "kind": { "$type": "Kind", "$val": "deadline_exceeded" } },
    "ECONNREFUSED": { "$number": -111, "text": "Connection refused", "kind": { "$type": "Kind", "$val": "unavailable" } },
    "EHOSTDOWN": { "$number": -112, "text": "Runtime is down", "kind": { "$type": "Kind", "$val": "unavailable" } },
    "EHOSTUNREACH": { "$number": -113, "text": "No route to runtime", "kind": { "$type": "Kind", "$val": "unavailable" } },
    "EALREADY": { "$number": -114, "text": "Operation already in progress", "kind": { "$type": "Kind", "$val": "already_exists" } },
    "EINPROGRESS": { "$number": -115, "text": "Operation now in progress", "kind": { "$type": "Kind", "$val": "unknown" } },
    "ECANCELED": { "$number": -125, "text": "Operation canceled", "kind": { "$type": "Kind", "$val": "cancelled" } },
    "ENOTRECOVERABLE": { "$number": -131, "text": "State not recoverable: an invariant the code stands on does not hold", "kind": { "$type": "Kind", "$val": "internal" } }
  }
}
