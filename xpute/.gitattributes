# What is generated from spec/, kept out of the language stats.
*.spec.rs linguist-generated=true
*.spec.ts linguist-generated=true
*.spec.hpp linguist-generated=true

# Tests and the golden records are not the product: out of the stats too.
*.test.rs linguist-detectable=false
*.test.ts linguist-detectable=false
*.test.cpp linguist-detectable=false
spec/golden/** linguist-generated=true
