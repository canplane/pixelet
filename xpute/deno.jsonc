{
  "description": "A kit, and a guest and a host end over it, for a program run inside another.",

  // Routes only. Each tree is a root of its own: ts/ and script/ as Deno's,
  // rust/ as Cargo's, its commands as aliases in rust/.cargo/config.toml, and
  // cpp/ built by script/cpp.ts. What is here is the documents and the spec,
  // formatted below, and the order of a test: the traces run against the
  // guests build:guests makes first.
  "workspace": [],
  "exclude": ["ts/", "script/"],

  "tasks": {
    "check": "deno fmt --check && deno task --cwd script check && deno task --cwd ts check && ./script/cpp.ts check && cd rust && cargo fmt --all --check && cargo lint",
    "test": "deno task --cwd ts test && ./script/cpp.ts test && cd rust && cargo test --all && cd .. && deno task build:guests && deno task --cwd ts test:conformance",
    // The one thing xpute builds: the guest the contract's traces drive, in
    // Rust and in C++, each a native library and a WebAssembly module.
    "build:guests": "./script/cpp.ts guest && ./script/cpp.ts wasm && cd rust && cargo guest && cargo guest-wasm",
    // What needs a GPU: the native host on wgpu, and the web host in Chrome (script/web-gpu.ts).
    "test:gpu": "./script/web-gpu.ts && cd rust && cargo test-gpu",
    "fmt": "deno fmt && deno task --cwd script fmt && deno task --cwd ts fmt && cd rust && cargo fmt --all",
    "lint": "deno task --cwd script lint && deno task --cwd ts lint",
    "export": "./script/export.ts"
  },

  "fmt": {
    "lineWidth": 200,
    "proseWrap": "preserve",

    // The golden records are committed as they were written and read byte
    // for byte by the tests; formatting them would break that.
    "exclude": ["spec/golden/", "rust/target/", "target/"]
  }
}
