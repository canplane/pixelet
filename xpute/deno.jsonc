{
  "description": "A kit, and a guest and a host end over it, for a program run inside another.",

  // The formatter's settings for the files that are no one tree's: the
  // documents and the spec. deno fmt is dprint's engine, kept here so it is
  // the same one ts/ formats with. What runs over the trees is the Makefile's.
  "workspace": [],
  "exclude": ["ts/"],
  // It imports nothing, so there is nothing for a lock to pin.
  "lock": false,

  "fmt": {
    "lineWidth": 200,
    "proseWrap": "preserve",

    // The golden records are committed as they were written and read byte
    // for byte by the tests; formatting them would break that.
    "exclude": ["spec/golden/", "rust/target/", "target/"]
  }
}
