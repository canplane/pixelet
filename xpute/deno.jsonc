{
  "description": "A kit, and a guest and a host end over it, for a program run inside another.",

  "workspace": ["ts/kit", "ts/host", "ts/conformance"],
  "nodeModulesDir": "auto",

  "tasks": {
    "check": "deno fmt --check && deno check ts/kit/src/**/*.ts && deno check ts/host/src/**/*.ts && deno check ts/conformance/src/**/*.ts && cargo fmt --manifest-path rust/Cargo.toml --all --check && cargo clippy --manifest-path rust/Cargo.toml --all-targets -- -D warnings && ./script/cpp.ts check",
    "test": "deno test -A ts/kit/src && deno test -A ts/host/src && cargo test --manifest-path rust/Cargo.toml --all && ./script/cpp.ts test && cargo build --manifest-path rust/Cargo.toml -p xpute-conformance && cargo build --manifest-path rust/Cargo.toml -p xpute-conformance --target wasm32-unknown-unknown && ./script/cpp.ts guest && ./script/cpp.ts wasm && deno test -A ts/conformance/src",
    "fmt": "deno fmt && cargo fmt --manifest-path rust/Cargo.toml --all",
    "lint": "deno lint",
    "export": "./script/export.ts"
  },

  "compilerOptions": {
    "lib": ["deno.window", "deno.ns", "deno.unstable", "esnext"],
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "checkJs": false
  },

  "imports": {
    "@xpute/kit/": "./ts/kit/src/",
    "@xpute/host/": "./ts/host/src/",
    "@xpute/conformance/": "./ts/conformance/src/",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1"
  },

  "fmt": {
    "lineWidth": 200,
    "proseWrap": "preserve",

    // The golden records are committed as they were written and read byte
    // for byte by the tests; formatting them would break that.
    "exclude": ["node_modules/", "spec/golden/", "rust/target/", "target/"]
  },

  "lint": { "rules": { "tags": ["recommended"] }, "exclude": ["node_modules/", "rust/target/", "target/"] }
}
