// tsc checks and emits nothing. xpute's packages (`@xpute/kit`,
// `@xpute/link`, `@xpute/host` and the rest)
// resolve as the packages they are (pnpm-workspace.yaml), as vitest resolves
// them. A file a native app has of its own (platform.native.ts) is read under
// tsconfig.native.json.
{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "kit/ts",
    "link/ts",
    "host/ts",
    "runtime/web",
    "expo",
    "golden/ts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["**/node_modules", "target", "**/*.native.ts"]
}
