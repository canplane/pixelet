package xpute:gpu@0.1.0;

// The GPU, which the host serves: it runs the stream's records (gpu/link/spec
// api.json) on a device. A guest opens the device at ("xpute:gpu", "device").
interface gpu {
  use xpute:link/types@0.1.0.{lent};

  // Runs the records lent, and answers once they have run: until then the
  // records, and the memory they name, are the host's.
  run: async func(records: lent);

  resource device {
    // Lends `block` (gpu/link/spec api.json DEVICE) for the host to write
    // while a device is held: its limits, features, unfinished frames and
    // STATUS, each a word of one writer, which the guest loads with acquire.
    // It answers when the device is lost, and the block is the guest's again.
    lost: async func(block: lent);
    // Asks for a device, and answers once it is ready, its block written,
    // with the block's STATUS.
    ready: async func() -> u32;
    // Answers once a completion a record asked for has landed: a fence, a
    // read or a pipeline the host stored into the guest's memory.
    settled: async func();
  }
}
