{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node script/require-pnpm.ts",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck",
    "typecheck": "tsc -p .",
    "test": "vitest run --exclude host/src/conformance.test.ts --exclude example/**",
    "test:conformance": "vitest run host/src/conformance.test.ts",
    "test:example": "vitest run example/",
    "test:gpu:web": "node gpu/script/browser.ts",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@std/assert": "jsr:^1.0.19",
    "@types/node": "^24",
    "@webgpu/types": "~0.1.74",
    "koffi": "^3.3.5",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
