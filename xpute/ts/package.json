{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck",
    "typecheck": "tsc -p . && tsc -p tsconfig.native.json",
    "test": "vitest run --exclude runtime/src/conformance.test.ts --exclude 'dev/example/**'",
    "test:conformance": "vitest run runtime/src/conformance.test.ts",
    "test:example": "vitest run dev/example/",
    "test:gpu:web": "node gpu/script/browser.ts",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@xpute/gpu": "workspace:*",
    "@xpute/runtime": "workspace:*",
    "@xpute/kit": "workspace:*",
    "@types/node": "^24",
    "@webgpu/types": "~0.1.74",
    "koffi": "^3.3.5",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
