{
  // xpute's TypeScript, one workspace as rust/ is one Cargo workspace: kit,
  // host and gpu, what a program links, each to get a name and exports the
  // day it is published. A package's own scripts sit beside its src/
  // (gpu/script/). What runs across the languages is the root's
  // (../Makefile).
  "workspace": ["kit", "host", "gpu"],
  "nodeModulesDir": "auto",

  "tasks": {
    "check": "deno fmt --check && deno lint && deno check kit/src/**/*.ts && deno check host/src/**/*.ts && deno check gpu/src/**/*.ts gpu/script/*.ts",
    "test": "deno test -A kit/src && deno test -A --ignore=host/src/conformance.test.ts host/src",
    // The host's run of the contract's traces against every guest, which the
    // root's test builds first.
    "test:conformance": "deno test -A host/src/conformance.test.ts",
    // The web host's test where it runs, in Chrome (gpu/script/browser.ts).
    "test:gpu:web": "./gpu/script/browser.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },

  "compilerOptions": {
    "lib": ["deno.window", "deno.ns", "deno.unstable", "esnext"],
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "checkJs": false
  },

  "imports": {
    "@xpute/kit/": "./kit/src/",
    "@xpute/host/": "./host/src/",
    "@xpute/gpu/": "./gpu/src/",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1"
  },

  "fmt": {
    "exclude": ["node_modules/"]
  },

  "lint": { "rules": { "tags": ["recommended"] }, "exclude": ["node_modules/"] }
}
