// tsc checks and emits nothing. `@xpute/kit`, `@xpute/runtime` and `@xpute/gpu`
// resolve as the packages they are (pnpm-workspace.yaml), as vitest resolves
// them. A file a native app has of its own (platform.native.ts) is read
// under tsconfig.native.json.
{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node", "@webgpu/types"]
  },
  "include": [
    "kit",
    "runtime",
    "gpu",
    "native",
    "example",
    "script",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["**/node_modules", "target"]
}
