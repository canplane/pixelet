package xpute:core@0.1.0;

// xpute's files, which the runtime serves, each opened by its path's URI.
// An open answers at once; a file that turns out missing answers ENOENT on its
// first size or read. Closing a file cancels what is in flight on it, as closing a
// handle does: a pending method answers ECANCELED.
interface fs {
  use link.{lent};

  resource file {
    // The file's size in bytes, as fstat answers it.
    size: async func() -> u32;
    // Fills `buf` with the file's bytes from where the last read ended, and
    // answers how many it put there, 0 at the file's end.
    read: async func(buf: lent) -> u32;
    // Writes `buf` past what was written before.
    write: async func(buf: lent);
    // Answers when the file changes under its holder.
    changed: async func();
    // Ends the file: 0 where what was written was applied, EIO where it was
    // not, which a release does not report.
    close: async func();
  }
}
