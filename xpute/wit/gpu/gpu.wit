package xpute:gpu@0.1.0;

// The GPU, which the runtime serves: it runs the stream's records (spec/gpu
// api.json) on a device. A core opens the device at ("xpute:gpu", "device").
interface gpu {
  use xpute:core/link@0.1.0.{lent};

  // Runs the records lent, and answers once they have run: until then the
  // records, and the memory they name, are the runtime's.
  run: async func(records: lent);

  resource device {
    // Lends `block` (spec/gpu api.json DEVICE) for the runtime to write while
    // a device is held: its limits, features, unfinished frames and STATUS,
    // each a word of one writer, which the core loads with acquire. It
    // answers when the device is lost, and the block is the core's again.
    lost: async func(block: lent);
    // Asks for a device, and answers once it is ready, its block written,
    // with the block's STATUS.
    ready: async func() -> u32;
    // Answers once a completion a record asked for has landed: a fence, a
    // read or a pipeline the runtime stored into the core's memory.
    settled: async func();
  }
}
