{
  "name": "@pxl/client",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "start": "EXPO_NO_TYPESCRIPT_SETUP=1 expo start",
    "build:wasm": "./script/wasm-build.py",
    "build:wasm:published": "./script/wasm-build.py --published",
    "build:brand": "cd \"$(git rev-parse --show-toplevel)/rust\" && cargo run -q -p pxl-tool --bin brand",
    "web": "pnpm build:wasm && pnpm build:brand && node script/web.ts html && EXPO_NO_TYPESCRIPT_SETUP=1 expo start --web",
    "build:web": "pnpm build:wasm:published && pnpm build:brand && node script/web.ts html && EXPO_NO_TYPESCRIPT_SETUP=1 expo export -p web && node script/web.ts stamp",
    "preview": "pnpm build:web && node script/web.ts serve"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@expo/ui": "~58.0.28",
    "@pxl/gpu": "workspace:*",
    "@xpute/expo": "workspace:*",
    "@xpute/host": "workspace:*",
    "@xpute/kit": "workspace:*",
    "@xpute/link": "workspace:*",
    "@xpute/runtime-web": "workspace:*",
    "expo": "58.0.25",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-sqlite": "~58.0.17",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "i18next": "^27.1.1",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@pxl/build": "workspace:*",
    "@types/babel__core": "^7.20.5"
  },
  "xpute": {
    "guest": {
      "workspace": "../../rust",
      "package": "pxl-core",
      "runtime": "pxl-runtime",
      "profile": {
        "debug": "native-watch",
        "release": "native"
      },
      "args": {
        "release": [
          "--no-default-features"
        ]
      }
    }
  }
}
