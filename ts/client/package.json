{
  "name": "@pxl/client",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "start": "EXPO_NO_TYPESCRIPT_SETUP=1 expo start",
    "build:wasm": "./script/wasm-build.py",
    "build:wasm:published": "./script/wasm-build.py --published",
    "build:brand": "cd \"$(git rev-parse --show-toplevel)/rust\" && cargo run -q -p pxl-tool --bin brand",
    "web": "pnpm build:wasm && pnpm build:brand && node script/web.ts html && EXPO_NO_TYPESCRIPT_SETUP=1 expo start --web",
    "build:web": "pnpm build:wasm:published && pnpm build:brand && node script/web.ts html && EXPO_NO_TYPESCRIPT_SETUP=1 expo export -p web && node script/web.ts stamp",
    "preview": "pnpm build:web && node script/web.ts serve"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@expo/ui": "~57.0.20",
    "@xpute/gpu-link": "workspace:*",
    "@xpute/gpu-web-host": "workspace:*",
    "@xpute/gpu-native-runtime": "workspace:*",
    "@xpute/link": "workspace:*",
    "@xpute/web-host": "workspace:*",
    "@xpute/web-runtime": "workspace:*",
    "@xpute/kit": "workspace:*",
    "@xpute/native-runtime": "workspace:*",
    "expo": "57.0.25",
    "expo-file-system": "~57.0.7",
    "expo-glass-effect": "~57.0.4",
    "expo-location": "~57.0.2",
    "expo-sqlite": "~57.0.4",
    "expo-symbols": "~57.0.3",
    "i18next": "^26.4.2",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@pxl/build": "workspace:*",
    "@types/babel__core": "^7.20.5"
  },
  "xpute": {
    "guest": {
      "workspace": "../../rust",
      "package": "pxl-core",
      "runtime": "pxl-runtime",
      "profile": {
        "debug": "native-watch",
        "release": "native"
      },
      "args": {
        "release": [
          "--no-default-features"
        ]
      }
    }
  }
}
