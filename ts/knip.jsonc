// What knip reads: every package of this workspace, from the entries the
// bundler, the tests and the scripts start at, and xpute's packages, each from
// its package.json `exports`, which are its published API and kept whether
// used here or not. xpute's kit is not listed: all of it is published and
// kept. What a generator writes under abi/, as *.spec.ts and as
// place-symbol.ts is not reported (symbol-path.ts is generated too, but every
// export of it is imported, so knip has nothing to report and it is not
// listed), nor a package knip's plugins infer from a
// configuration that no code imports (ignoreDependencies). A report names
// candidates, each removed only as the code skill's "One owner" says.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/abi/**",
    "**/*.spec.ts",
    "client/src/ui/feature/search/place-symbol.ts",
  ],
  "workspaces": {
    ".": {
      "entry": ["server/edge/index.ts"],
      "ignoreDependencies": ["react"],
    },
    // The client's `exports` name its whole src/ for the workspace's own
    // imports, not as an entry. A platform file (`x.web.ts`, `x.native.ts`,
    // an override `x.ios.tsx`) is an entry of knip's Metro plugin, whose
    // exports knip does not judge; an override's default's are judged through
    // its imports. conform.ts, which tsc alone reads, is no entry: it names
    // every export of each page's file and each default. knip does not
    // resolve an import of `x.ts` to `x.web.ts` or `x.native.ts`, as Metro
    // does (ts/build/path.ts `platform_file`), so the imports of each pair are
    // not reported unresolved (ignoreUnresolved); both type-checks, the page's
    // and the device's, resolve every import.
    "client": {
      "entry": ["src/runtime/worker.ts", "plugin/*.ts", "script/*.ts"],
      "ignoreFiles": ["src/conform.ts"],
      "ignoreUnresolved": [
        "(?:^|/)(?:page|boot|db|device|drive|locale|online|origin|safe-area|sensor|share|storage|viewport|visibility|surface|above-keyboard|backdrop|motion|pan|typeface)\\.tsx?$",
      ],
      "ignoreDependencies": ["expo-updates", "babel-preset-expo"],
      "includeSubpathExports": true,
    },
    "build": {
      "includeSubpathExports": true,
    },
    "xr": {
      "entry": ["plugin/*.ts"],
      "ignoreDependencies": ["expo-updates"],
    },
    "tool/shader": {
      "entry": ["probe.ts"],
    },
    // Its native code builds on xpute's Expo module's.
    "gpu": {
      "entry": ["host/script/*.ts"],
      "ignoreDependencies": ["@xpute/expo"],
    },
    "../xpute/link/ts": {},
    "../xpute/host/ts": {},
    "../xpute/runtime/web": {},
    "../xpute/expo": {},
    "../xpute/golden/ts": {},
  },
}
