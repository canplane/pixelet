// What knip reads: every package of this workspace, from the entries the
// bundler, the tests and the scripts start at, and xpute's packages, each from
// its package.json `exports`, which are its published API and kept whether
// used here or not. xpute's kit is not listed: all of it is published and
// kept. What a generator writes under abi/, as *.spec.ts and as
// place-symbol.ts is not reported, nor a package knip's plugins infer from a
// configuration that no code imports (ignoreDependencies). A report names
// candidates, each removed only as the code skill's "One owner" says.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/abi/**",
    "**/*.spec.ts",
    "client/src/ui/feature/search/place-symbol.ts",
  ],
  "workspaces": {
    ".": {
      "entry": ["server/edge/index.ts"],
      "ignoreDependencies": ["react"],
    },
    // The client's `exports` name its whole src/ for the workspace's own
    // imports, not as an entry. A platform file is an entry of knip's Metro
    // plugin, whose exports knip does not judge; a default's are judged
    // through its imports. conform.ts, which tsc alone reads, is no entry: it
    // names every export of each default.
    "client": {
      "entry": ["src/runtime/worker.ts", "plugin/*.ts", "script/*.ts"],
      "ignoreFiles": ["src/conform.ts"],
      "ignoreDependencies": ["expo-updates", "babel-preset-expo"],
      "includeSubpathExports": true,
    },
    "build": {
      "includeSubpathExports": true,
    },
    "xr": {
      "entry": ["plugin/*.ts"],
      "ignoreDependencies": ["expo-updates", "expo-system-ui"],
    },
    "tool/shader": {
      "entry": ["probe.ts"],
    },
    "../xpute/link/ts": {},
    "../xpute/web/host": {},
    "../xpute/web/runtime": {},
    "../xpute/native/runtime/expo": {},
    "../xpute/gpu/link/ts": {},
    "../xpute/gpu/web/host": {
      "entry": ["script/*.ts"],
    },
    // Its native code builds on the native runtime's.
    "../xpute/gpu/native/runtime/expo": {
      "ignoreDependencies": ["@xpute/native-runtime"],
    },
    "../xpute/dev/golden/ts": {},
  },
}
