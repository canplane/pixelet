{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node build/require-pnpm.ts",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck",
