{
  // @pxl/edge: the Cloudflare Worker that serves the page's bundle, the
  // bucket's objects, and relays /geo and /api to the servers
  // (rust/server/). It runs on the Workers runtime, so it reads none of the
  // client: what it needs of spec/ is generated beside it.
  "name": "@pxl/edge",
  "version": "0.0.0",
  "exports": "./index.ts",

  "tasks": {
    // Without the workspace's import map, as wrangler's bundler resolves it:
    // an alias or a bare specifier the Worker could not be bundled with fails
    // here, before CI's bundle.
    "check": "deno check --no-config index.ts"
  },

  "compilerOptions": {
    "lib": ["esnext", "dom", "deno.ns"]
  }
}
