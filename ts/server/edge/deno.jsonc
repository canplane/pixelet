{
  // @pxl/edge: the Cloudflare Worker that serves the page's bundle, the
  // bucket's objects, and relays /geo and /api to the servers
  // (rust/server/). It runs on the Workers runtime, so it reads none of the
  // client: what it needs of spec/ is generated beside it.
  "name": "@pxl/edge",
  "version": "0.0.0",
  "exports": "./index.ts",

  "tasks": {
    "check": "deno check index.ts",
    // The page built and staged beside the Worker (script/stage.sh), then
    // the Worker as wrangler bundles it beside that, without publishing: a
    // type-check can pass where wrangler's resolver fails, as it did on
    // 10-23. No credentials.
    "check:build": "./script/stage.sh && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    // The Worker published, with the bundle staged beside it: the
    // repository's deploy (script/deploy.py) runs it last. wrangler is a
    // program on the PATH, as git is.
    "deploy": "wrangler deploy"
  },

  "compilerOptions": {
    "lib": ["esnext", "dom", "deno.ns"]
  }
}
