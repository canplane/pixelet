{
  // The Cloudflare Worker that serves both the built app and its baked pages
  // and assets. `make deploy` (script/deploy.py) builds the app, then runs
  // wrangler.
  //
  // `name` becomes the *.workers.dev subdomain. One Worker serves everything
  // from one origin, so there is no CORS to configure.
  "name": "pixelet",
  "main": "index.ts",

  // The app answers on its own hostname, not on *.workers.dev. WAF and
  // rate-limiting rules attach to a zone, and a workers.dev subdomain is not
  // one, so requests per IP could not be bounded there.
  //
  // With `custom_domain: true`, wrangler owns the DNS record and the
  // certificate for this hostname. Neither is made by hand, and an existing
  // record at the same name makes the deploy fail rather than being replaced
  // silently.
  //
  // The hostname is the site's own domain rather than one of xpute's.
  // @xpute/kit carries no pixelet knowledge and is meant to stay portable, and
  // putting this app on xpute.* would spend that name on one of the things
  // built with it. `make spec` writes the host from spec/spec/route.json
  // `origins`.
  "routes": [{ "pattern": "plei.me", "custom_domain": true }],

  // Off, so that pixelet.canplane.workers.dev does not answer. Left up, it
  // would let anyone pass around every WAF rule written against the zone by
  // using that hostname instead. A protected surface and an unprotected one
  // cannot both be kept.
  "workers_dev": false,
  "compatibility_date": "2026-08-16",

  // The origins the Worker relays to (infra/README.md). The relay runs
  // through this Worker so that /geo/* and /api/* stay same-origin with the
  // app, with no CORS policy to configure or get wrong. They are vars rather
  // than literals in index.ts, so that pointing at another machine, or a local
  // one, is a change of config. A hostname names a machine and a root names a
  // service, and the two need not match: both roots reach the same VM, where
  // Caddy sends each to the container that answers it. `make spec` writes both
  // from route.json `origins`.
  "vars": {
    "GEO_ORIGIN": "https://api.plei.me",
    "API_ORIGIN": "https://api.plei.me",
  },

  // The page's bundle, built by the web app and staged here before a deploy
  // (script/deploy.py), so that this config names nothing outside its
  // package.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // The app is a single page. Every path that is not an asset falls back to
    // index.html, or a deep link would be a 404 instead of routing in the
    // client.
    "not_found_handling": "single-page-application",

    // That fallback would also swallow every request meant for a server,
    // answering a page index or a query with index.html. So the Worker runs
    // first for four roots: the world's data, the application, the baked
    // pages and the content-addressed assets. spec/spec/route.json decides
    // them, and `make spec` writes this list from it (pxl-tool's
    // spec/route.rs).
    "run_worker_first": ["/geo/*", "/api/*", "/tile/*", "/asset/*"],
  },

  "r2_buckets": [
    {
      "binding": "BUCKET",
      // This must match the bucket made in the Cloudflare dashboard.
      // Infrastructure takes the project's full name (infra/local/.env.example:
      // pixelet-db-geo, pixelet-network), and `pxl` is for names in code. The
      // name is in kebab case because R2 bucket names accept only lowercase
      // letters, digits and hyphens. The bucket holds the baked pages, the
      // assets and `source` (index.ts `KEY_RE`), so it is named for being the
      // bucket rather than for one of them.
      "bucket_name": "pixelet-bucket",
    },
  ],
}
