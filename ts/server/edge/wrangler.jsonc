{
  // Cloudflare Worker that serves both the built app and its terrain tiles.
  // Deployed by `make deploy` (script/deploy.py): build, then
  // wrangler.
  //
  // `name` becomes the *.workers.dev subdomain; a custom domain is attached
  // in the dashboard afterward. Rationale for this shape — one Worker, one
  // origin, no CORS — is in doc/minutes/20260816-deployment-hosting.md.
  "name": "pixelet",
  "main": "index.ts",

  // The demo answers on its own hostname, not on *.workers.dev. That is not
  // cosmetic: WAF and rate-limiting rules attach to a zone, and a workers.dev
  // subdomain is not one — there is no way to bound requests per IP while the
  // app lives there. See doc/minutes/20260816-deployment-hosting.md.
  //
  // `custom_domain: true` means wrangler owns the DNS record and the
  // certificate for this hostname; neither has to be created by hand, and
  // an existing record at the same name makes the deploy fail rather than
  // being silently replaced.
  //
  // plei.me rather than one of the xpute domains, deliberately: @xpute/kit
  // is a runtime kit that carries no pixelet knowledge and is meant to stay
  // portable, so putting this app on xpute.* would spend that
  // name on one of the things built with it.
  "routes": [{ "pattern": "plei.me", "custom_domain": true }],

  // Takes pixelet.canplane.workers.dev offline on the next deploy, and that
  // is the point. Leaving it up means every WAF rule written against the zone
  // is bypassable by using the other hostname instead — a firewall with the
  // side door propped open. Anything already sharing that URL breaks; there
  // is no version of this that keeps both a protected surface and an
  // unprotected one.
  "workers_dev": false,
  "compatibility_date": "2026-08-16",

  // The origins the Worker relays to (infra/README.md): relayed through this
  // same Worker so /geo/* and /api/* stay same-origin with the app, and no
  // CORS policy exists to configure or get wrong. Vars rather than literals
  // in cloudflare-worker/index.ts, so another box — or a local one — is a
  // config change. A hostname is a box and a root is a service, and the two
  // do not have to match: both roots reach the same VM, where Caddy sends
  // each to the container that answers it.
  "vars": {
    "GEO_ORIGIN": "https://api.plei.me",
    "API_ORIGIN": "https://api.plei.me",
  },

  // The page's bundle, built by the web app and staged here before a deploy
  // (script/deploy.py), so this config names nothing outside its package.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // The app is a single page: every non-asset path has to fall back to
    // index.html, or a deep link 404s instead of routing client-side.
    "not_found_handling": "single-page-application",

    // ...but that fallback would also swallow every request meant for a
    // server, answering a page index or a query with index.html. Four roots
    // are claimed here instead of one: the world's data, the application, the
    // baked pages and the content-addressed assets. spec/route.json is where they are decided
    // and pxl-tool/spec/route.rs fails when this list drifts from it.
    "run_worker_first": ["/geo/*", "/api/*", "/tile/*", "/asset/*"],
  },

  "r2_buckets": [
    {
      "binding": "TILES",
      // Must match the bucket created in the Cloudflare dashboard.
      // Infrastructure resources use the full project name (see .env.example:
      // pixelet-db-geo, pixelet-network); `pxl` is for code-level identifiers.
      // Kebab, not snake, and not by preference: R2 bucket names accept only
      // lowercase letters, digits and hyphens — an underscore is rejected.
      "bucket_name": "pixelet-tiles",
    },
  ],
}
