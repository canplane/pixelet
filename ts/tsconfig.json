// tsc checks and emits nothing: Vite and Metro transform and bundle. Every
// alias is here, and Vite, vitest and Metro read it from here
// (build/paths.ts).
{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client", "@webgpu/types"],

    "paths": {
      "@/*": ["./client/src/*"],
      "@pxl/client/*": ["./client/src/*"],
      "@pxl/build/*": ["./build/*"],
      "@xpute/kit/*": ["../xpute/ts/kit/src/*"],
      "@xpute/host/*": ["../xpute/ts/host/src/*"],
      "@xpute/gpu/*": ["../xpute/ts/gpu/src/*"]
    }
  },
  "include": ["client", "build", "app/web", "vitest.config.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
