// tsc checks and emits nothing: Metro transforms and bundles. Every alias is
// here, and vitest and Metro read it from here (build/paths.ts). This is the
// page's view of the client; the device's is client/tsconfig.native.json.
{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node", "@webgpu/types"],

    "paths": {
      "@/*": ["./client/src/*"],
      "@pxl/client/*": ["./client/src/*"],
      "@pxl/build/*": ["./build/*"]
    }
  },
  "include": ["client", "build", "tool/shader", "vitest.config.ts"],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "client/ios",
    "client/android",
    "**/*.native.ts",
    "**/*.native.tsx"
  ]
}
