// tsc checks and emits nothing; Metro transforms and bundles. Every alias is
// defined here, and vitest and Metro read the aliases from here
// (build/path.ts). This is the web view of the client: x.web.ts where an
// import names x.ts, as Metro takes it for the web. The native view is
// client/tsconfig.native.json.
{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node", "@webgpu/types"],
    "moduleSuffixes": [".web", ""],

    "paths": {
      "@/*": ["./client/src/*"],
      "@pxl/client/*": ["./client/src/*"],
      "@pxl/build/*": ["./build/*"]
    }
  },
  "include": [
    "client",
    "xr",
    "build",
    "tool/shader",
    "gpu",
    "vitest.config.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "client/ios",
    "client/android",
    "**/*.native.ts",
    "**/*.native.tsx",
    "client/src/conform.ts"
  ]
}
