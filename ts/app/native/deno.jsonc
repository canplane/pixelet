{
  // What the device's own files are type-checked against (`check`, which
  // ts/'s check runs): its own `@/`, and the client as `@pxl/client/`. Metro
  // bundles the app and reads none of this (metro.config.ts); its npm
  // packages are package.json's.
  "tasks": {
    "check": "deno check src"
  },

  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["@pxl/client/@types", "npm:@types/react@^19", "npm:@webgpu/types@^0.1.69"]
  },

  "imports": {
    "@/": "./src/"
  }
}
