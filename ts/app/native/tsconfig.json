// The device's own sources, its entry among them, as ../../tsconfig.json
// checks the rest, without Vite's types: Metro bundles the app.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "@webgpu/types"]
  },
  "include": ["index.ts", "src", "../../client/@types"]
}
