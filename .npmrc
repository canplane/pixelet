# .npmrc

# Maintains pnpm's strict isolation while exposing specific infrastructure 
# patterns to the root node_modules for cross-package accessibility.

# ==============================================================================
# 1. TENSORFLOW.JS (Core & Interface)
# Excludes heavy native backends (Node, WebGPU) to ensure build isolation 
# across different environments (CI, Local, Production).
# ==============================================================================
public-hoist-pattern[]=@tensorflow/tfjs-core
public-hoist-pattern[]=@tensorflow/tfjs-core/*
public-hoist-pattern[]=@types/tensorflow__tfjs-core

# ==============================================================================
# 2. INTERNATIONALIZATION (i18n)
# Exposes i18n infrastructure defined in @pixelet/core so that Web/API 
# packages can import them directly without local re-installation.
# ==============================================================================
public-hoist-pattern[]=i18next
public-hoist-pattern[]=react-i18next
public-hoist-pattern[]=i18next-browser-languagedetector

# ==============================================================================
# NOTE: Framework-level dependencies (React, etc.) are intentionally EXCLUDED 
# from hoisting to maintain strict version control and prevent environment 
# contamination between Client and Server packages.
# ==============================================================================