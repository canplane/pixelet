{
  // Cloudflare Worker that serves both the built app and its terrain tiles.
  // Deploy with:  npx wrangler deploy   (from apps/web, after `deno task build`)
  //
  // `name` becomes the *.workers.dev subdomain; a custom domain is attached
  // in the dashboard afterwards. Rationale for this shape — one Worker, one
  // origin, no CORS — is in discussions/20260816-deployment-hosting.md.
  "name": "pixelet",
  "main": "worker/index.ts",

  // The demo answers on its own hostname, not on *.workers.dev. That is not
  // cosmetic: WAF and rate-limiting rules attach to a zone, and a workers.dev
  // subdomain is not one — there is no way to bound requests per IP while the
  // app lives there. See discussions/20260816-deployment-hosting.md.
  //
  // `custom_domain: true` means wrangler owns the DNS record and the
  // certificate for this hostname; neither has to be created by hand, and
  // an existing record at the same name makes the deploy fail rather than
  // being silently replaced.
  //
  // plei.me rather than one of the xpute domains, deliberately: @xpute/core
  // is a runtime kit that carries no pixelet knowledge and is meant to stay
  // portable (see AGENTS.md), so putting this app on xpute.* would spend that
  // name on one of the things built with it.
  "routes": [
    { "pattern": "plei.me", "custom_domain": true }
  ],

  // Takes pixelet.canplane.workers.dev offline on the next deploy, and that
  // is the point. Leaving it up means every WAF rule written against the zone
  // is bypassable by using the other hostname instead — a firewall with the
  // side door propped open. Anything already sharing that URL breaks; there
  // is no version of this that keeps both a protected surface and an
  // unprotected one.
  "workers_dev": false,
  "compatibility_date": "2026-08-16",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // The app is a single page: every non-asset path has to fall back to
    // index.html, or a deep link 404s instead of routing client-side.
    "not_found_handling": "single-page-application",

    // ...but that fallback would also swallow tile requests, handing back
    // index.html for every page_idx. Routing /tiles/* to the Worker first
    // keeps both behaviours: SPA fallback for the app, R2 for tiles.
    "run_worker_first": ["/tiles/*"]
  },

  "r2_buckets": [
    {
      "binding": "TILES",
      // Must match the bucket created in the Cloudflare dashboard.
      // Infrastructure resources use the full project name (see .env.example:
      // pixelet-db-geo, pixelet-network); `pxl` is for code-level identifiers.
      // Kebab, not snake, and not by preference: R2 bucket names accept only
      // lowercase letters, digits and hyphens — an underscore is rejected.
      "bucket_name": "pixelet-tiles"
    }
  ]
}
