# Web App (Vite)
# Only variables prefixed with VITE_ are exposed to the client

# [Web App Configuration]
VITE_API_BASE_URL=http://localhost:3000

# [Service Execution Strategy]
# - 'internal': 내 전용 백엔드(Docker/NestJS)를 데이터 소스로 사용합니다.
# - 'external': 별도 서버 없이 클라이언트 런타임에서 직접 데이터를 생성합니다. (serverless)
VITE_SERVICE_MODE=internal

# 'internal' 모드일 때 타일 데이터를 요청할 대상 주소
# (상대 경로인 경우 VITE_API_BASE_URL 뒤에 붙습니다)
VITE_INTERNAL_OSM_API_ENDPOINT=/api/geo/tile


# [Third-party Service Keys]
VITE_MAPTILER_KEY=8j7wEFB5JJmuKCyBTzze