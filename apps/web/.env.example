# ------------------------------------------------------------------------------
# web app (vite)
# only variables prefixed with VITE_ are exposed to the client
# ------------------------------------------------------------------------------
#
# Route paths and published tile versions are NOT here — they are the same on
# every machine and a version bump has to be reviewable, so they live in
# spec/route.json, from which src/config/route_spec.ts is written. What belongs
# here is what differs per machine.

VITE_APP_ENV=development
# read by the vite dev server only, one per root: the world's data, the tiles a
# deployment reads out of the bucket instead, and the application's own server.
VITE_GEO_BASE_URL=http://127.0.0.1:3000
VITE_TILE_BASE_URL=http://127.0.0.1:3001
VITE_API_BASE_URL=http://127.0.0.1:3002

# the published deployment `deno task dev:remote` reads from
VITE_REMOTE_ORIGIN=https://plei.me
