# ------------------------------------------------------------------------------
# web app (vite)
# only variables prefixed with VITE_ are exposed to the client
# ------------------------------------------------------------------------------

VITE_APP_ENV=development
# read by the vite dev server only, to proxy /api and /io
VITE_API_BASE_URL=http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# tiles — /<path>[/<version>]/<page_idx>. version: published only.
# ------------------------------------------------------------------------------

TILE_PATH_TERRAIN=tiles/terrain
TILE_PATH_POI=tiles/poi
TILE_PATH_GEOCODE=tiles/geocode

PUBLISHED_VERSION_TERRAIN=v2
PUBLISHED_VERSION_POI=v2
PUBLISHED_VERSION_GEOCODE=v1

# ------------------------------------------------------------------------------
# local development against a published deployment
# `deno task dev:remote` only
# ------------------------------------------------------------------------------

VITE_TILE_PROXY_TARGET=https://plei.me
