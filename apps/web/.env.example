# ------------------------------------------------------------------------------
# web app (vite)
# only variables prefixed with VITE_ are exposed to the client
# ------------------------------------------------------------------------------

VITE_APP_ENV=development

# live API server. Only the vite dev server reads this (it proxies /api and
# /io there) — the production bundle never calls it, since the deployed app
# is fully static and reads terrain from VITE_TILE_BASE_URL instead.
VITE_API_BASE_URL=http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# static terrain tiles (serverless deployment)
# ------------------------------------------------------------------------------
#
# Origin the pre-baked tiles are served from, INCLUDING the version prefix:
#   https://<bucket-or-cdn-host>/v1
#
# Tiles are immutable per version, so a re-bake bumps the prefix (v1 -> v2)
# rather than overwriting objects — that invalidates every cache layer
# (CDN edge, browser, any future OPFS cache) at once, with no purge API.
#
# Leave EMPTY for local development: the client then requests
# /api/world/terrain/tiles/:page_idx and the dev proxy forwards it to the
# live API, which bakes on demand.
#
# Populate the bucket with:
#   deno run -A --env=.env apps/api/src/bake/terrain/tools/bake_tiles.ts
# Objects are stored pre-gzipped — upload them with
#   content-type: application/octet-stream
#   content-encoding: gzip
# Open-ocean pages have no object at all (~65% of the coverage bbox); the
# client resolves their 404 to the shared `_ocean` tile in the same bucket.
VITE_TILE_BASE_URL=

# ------------------------------------------------------------------------------
# local development against a published deployment (optional)
# ------------------------------------------------------------------------------
#
# Origin of an already-deployed tile Worker, e.g. https://pixelet.example.workers.dev
# — the origin only, without /tiles.
#
# When set, the dev server proxies /tiles there, so `deno task dev:web` needs
# no Docker, no PostGIS and no API process. Combine with
# VITE_TILE_BASE_URL=/tiles/<version>; it stays relative, so nothing about the
# deployed configuration changes and the Worker needs no CORS headers.
#
# Leave empty to develop against the local API, which is what bake-pipeline
# work requires — a published prefix is frozen and will not reflect changes to
# the baking code.
VITE_TILE_PROXY_TARGET=

# ------------------------------------------------------------------------------
# reverse geocoding
# ------------------------------------------------------------------------------
#
# Origin for reverse geocoding. Defaults to OSM's shared public Nominatim when
# left empty.
#
# That instance's usage policy expects an identifying User-Agent, which a
# browser cannot send — only a Referer goes out — so public demo traffic can be
# throttled or blocked. Point this at a self-hosted Nominatim or a proxy you
# control if location labels start failing after deployment.
VITE_GEOCODE_BASE_URL=
