{
  "files": [],
  "compilerOptions": {
    /* 경로 별칭 (Path Alias) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"], // Web 프로젝트 내부 소스 참조용 별칭
      "@pixelet/shared/*": ["../../packages/shared/src/*"], // 👇 이 경로 설정이 있어야 Webpack이 실제 소스 위치를 찾습니다.
      "three/*": ["./node_modules/@types/three/*"] // Three.js 상세 타입 정의 매핑
    }
  },
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
