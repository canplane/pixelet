{
  "name": "@pxl/web",
  "version": "0.0.0",
  "exports": "./src/main.tsx",

  // no-window/no-window-prefix assume runtime-portable code; this workspace
  // member is browser-only, where `window` is the correct global.
  "lint": {
    "rules": { "exclude": ["no-window", "no-window-prefix"] }
  },

  "tasks": {
    // The guest's module, from crates/, into src/kernel/guest.wasm. Every
    // task that loads it depends on this, so it is never stale or missing.
    "build:wasm": "deno run -A script/build-wasm.ts",
    // The same module in its published shape — without the dev-only settings
    // and with its panic paths blanked — which is what `build` bundles, so a
    // local build and the deploy's are the same bytes (script/build-wasm.ts).
    "build:wasm:published": "deno run -A script/build-wasm.ts --published",

    // Server routes answered by the published deployment: no local server,
    // database or Docker. See vite.config.ts's VITE_DEV_SOURCE comment.
    "dev": { "command": "deno run -A --node-modules-dir=auto npm:vite", "dependencies": ["build:wasm"] },
    // The same client against the servers on this machine.
    "dev:oven": { "command": "VITE_DEV_SOURCE=oven deno run -A --node-modules-dir=auto npm:vite", "dependencies": ["build:wasm"] },
    "dev:shelf": { "command": "VITE_DEV_SOURCE=shelf deno run -A --node-modules-dir=auto npm:vite", "dependencies": ["build:wasm"] },

    "build": { "command": "deno run -A --node-modules-dir=auto npm:vite build", "dependencies": ["build:wasm:published"] },
    "preview": { "command": "deno run -A --node-modules-dir=auto npm:vite preview", "dependencies": ["build"] },
    // A bundle names where its tiles come from when it is built, so each is its own build.
    "preview:oven": {
      "command": "VITE_DEV_SOURCE=oven deno run -A --node-modules-dir=auto npm:vite build && VITE_DEV_SOURCE=oven deno run -A --node-modules-dir=auto npm:vite preview",
      "dependencies": ["build:wasm:published"]
    },
    "preview:shelf": {
      "command": "VITE_DEV_SOURCE=shelf deno run -A --node-modules-dir=auto npm:vite build && VITE_DEV_SOURCE=shelf deno run -A --node-modules-dir=auto npm:vite preview",
      "dependencies": ["build:wasm:published"]
    },

    // Guards the artifact, not the source: a dev surface can be gated
    // correctly and still leave its strings in the bundle. Runs between build
    // and publish so a leak stops the deploy rather than being noticed on the
    // live site.
    // Builds, checks the bundle and publishes the Worker under the build
    // number CI took — see script/deploy.ts. wrangler runs through Deno, not
    // npx, since it wants a newer Node than a system may have.
    "deploy": "deno run -A script/deploy.ts",

    // A catalog entry is a number, an id and a name in every locale; the first
    // two are written from the JSON under spec/, the last is people's.
    "check": "deno check src/main.tsx cloudflare-worker/index.ts",
    // Pure-logic modules: none of them touches the DOM or the GPU, so plain
    // `deno test` works with no browser harness, over the module built for
    // it. What needs a canvas is verified live.
    "test": "deno test -A src"
  },

  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "types": [
      "./@types/index.d.ts",

      "npm:vite/client",
      "npm:@webgpu/types@^0.1.69",
      "npm:@types/react@^19",
      "npm:@types/react-dom@^19"
    ]
  },

  "imports": {
    "@/": "./src/",
    // What differs by platform, behind one name: the web's here, and a
    // native build maps the same prefix to its own directory.
    "@platform/": "./src/platform/web/",

    // build tools
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.1.1",

    // react core
    "react": "npm:react@19.2.3",
    "react-dom": "npm:react-dom@19.2.3",
    "react-router-dom": "npm:react-router-dom@^7.18.4",
    // The shell is written, and type-checked, against React Native's own
    // API; on the web vite.config.ts bundles react-native-web in its place,
    // which renders the same primitives as the DOM.
    "react-native": "npm:react-native@0.86.3",
    "react-native-web": "npm:react-native-web@^0.21.2",

    // state management
    "zustand": "npm:zustand@^5.0.15",

    // icons
    "phosphor-react-native": "npm:phosphor-react-native@^3.0.6",
    "react-native-svg": "npm:react-native-svg@15.15.4",

    // internationalization
    "react-i18next": "npm:react-i18next@^17.0.14"
  }
}
