{
  "extends": "./tsconfig.json", // 부모 설정을 상속받는 경우
  "compilerOptions": {
    /* 프로젝트 참조 및 빌드 최적화 */
    "composite": true, // 프로젝트 참조 기능을 활성화
    "incremental": true, // 변경된 부분만 빌드하여 속도 향상
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo", // 증분 빌드 캐시 파일 경로

    /* 언어 및 런타임 환경 */
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"], // Node.js 환경 타입 정의

    /* 모듈 해석 전략 (Bundler) */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true, // import/export 구문 엄격 적용
    "moduleDetection": "force",
    "noEmit": true, // 파일 생성은 하지 않고 검사만 수행

    /* 엄격한 타입 검사 및 린팅 */
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
