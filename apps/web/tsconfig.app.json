{
  "extends": "./tsconfig.json", // 부모 설정을 상속받는 경우
  "compilerOptions": {
    /* 프로젝트 참조 및 빌드 최적화 */
    "composite": true, // 프로젝트 참조 기능을 활성화
    "incremental": true, // 변경된 부분만 빌드하여 속도 향상
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo", // 증분 빌드 캐시 파일 경로

    /* 언어 및 런타임 환경 */
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "vite-plugin-svgr/client" // SVGR
    ], // Vite 관련 타입 정의

    /* 모듈 해석 전략 (Bundler) */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true, // import/export 구문 엄격 적용
    "moduleDetection": "force",
    "noEmit": true, // Vite가 빌드하므로 tsc는 파일 생성 안 함

    /* 엄격한 타입 검사 및 린팅 */
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* 경로 별칭 (Alias) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}
