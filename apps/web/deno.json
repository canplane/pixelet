{
  "name": "@pxl/web",
  "version": "0.0.0",
  "exports": "./src/main.tsx",

  // no-window/no-window-prefix assume runtime-portable code (the default
  // for tool/ and packages/*, which the root config's own rules target);
  // this workspace member is browser-only, where `window` is the correct
  // global, not a portability footgun.
  "lint": {
    "rules": { "exclude": ["no-window", "no-window-prefix"] }
  },

  "tasks": {
    // The Rust core's module, from crates/, into src/kernel/kernel.wasm. Every
    // task that loads it depends on this, so it is never stale or missing.
    "build:wasm": "deno run -A script/build-wasm.ts",

    // Server routes answered by the published deployment: no local server,
    // database or Docker. See vite.config.ts's VITE_DEV_SOURCE comment.
    "dev": { "command": "deno run -A --node-modules-dir=auto npm:vite", "dependencies": ["build:wasm"] },
    // The same client against the servers on this machine.
    "dev:local": { "command": "VITE_DEV_SOURCE=local deno run -A --node-modules-dir=auto npm:vite", "dependencies": ["build:wasm"] },

    "build": { "command": "deno run -A --node-modules-dir=auto npm:vite build", "dependencies": ["build:wasm"] },
    "preview": { "command": "deno run -A --node-modules-dir=auto npm:vite preview", "dependencies": ["build"] },
    "preview:local": "VITE_DEV_SOURCE=local deno run -A --node-modules-dir=auto npm:vite preview",

    // Build, then publish the Worker (app + R2 tile route). Run through Deno
    // rather than npx: wrangler requires Node >=22 and the system Node may be
    // older, while Deno's compat layer satisfies it — and it keeps the repo on
    // one toolchain. Needs `wrangler login` once.
    // Guards the artifact, not the source: a dev surface can be gated
    // correctly and still leave its strings in the bundle. Runs between build
    // and publish so a leak stops the deploy rather than being noticed on the
    // live site.
    "check:bundle": "deno run -A script/check-bundle.ts",
    // Takes the next build number from the counter in the bucket, then does
    // the three steps above under it — see script/deploy.ts.
    "deploy": "deno run -A script/deploy.ts",

    // Through build:wasm, as dev, build and test are: the module's minified
    // ABI is written beside it (src/kernel/abi/symbol.ts) and the shell imports it,
    // so a checkout that has never built cannot be type-checked without it.
    // A catalog entry is a number, an id and a name in every locale; the first
    // two are written from the JSON under spec/, the last is people's.
    "check:locale": "./script/locale.ts",
    "check": { "command": "deno check src/main.tsx", "dependencies": ["build:wasm", "check:locale"] },
    // Pure-logic modules: none of them touches the DOM or the GPU, so plain
    // `deno test` works with no browser harness, over the module built for
    // it. What needs a canvas is verified live.
    "test": { "command": "deno test -A src", "dependencies": ["build:wasm"] }
  },

  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "types": [
      "./@types/index.d.ts",

      "npm:vite/client",
      "npm:@webgpu/types@^0.1.69",
      "npm:@types/react@^19",
      "npm:@types/react-dom@^19"
    ]
  },

  "imports": {
    "@/": "./src/",

    // build tools
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4.3.4",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.0.0",
    "vite-plugin-svgr": "npm:vite-plugin-svgr@^4.3.0",

    // react core
    "react": "npm:react@^19.2.0",
    "react-dom": "npm:react-dom@^19.2.0",
    "react-router-dom": "npm:react-router-dom@^7.10.1",

    // state management
    "zustand": "npm:zustand@^5.0.9",

    // styling
    "tailwindcss": "npm:tailwindcss@^4.1.18",
    "tw-animate-css": "npm:tw-animate-css@^1.3.0",
    "tailwind-merge": "npm:tailwind-merge@^3.4.0",
    "clsx": "npm:clsx@^2.1.1",
    "class-variance-authority": "npm:class-variance-authority@^0.7.1",

    // UI components & animations
    "framer-motion": "npm:framer-motion@^12.23.26",
    "lucide-react": "npm:lucide-react@^0.561.0",
    "@radix-ui/react-slot": "npm:@radix-ui/react-slot@^1.2.4",
    "@radix-ui/react-separator": "npm:@radix-ui/react-separator@^1.1.8",
    "@radix-ui/react-dialog": "npm:@radix-ui/react-dialog@^1.1.15",
    "@radix-ui/react-switch": "npm:@radix-ui/react-switch@^1.2.6",
    "@radix-ui/react-tabs": "npm:@radix-ui/react-tabs@^1.1.13",

    // internationalization
    "react-i18next": "npm:react-i18next@^16.0.0",
    "i18next-browser-languagedetector": "npm:i18next-browser-languagedetector@^8.0.2"
  }
}
