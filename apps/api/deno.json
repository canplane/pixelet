{
  // No name and no exports: nothing imports this as a package any more. It is
  // a workspace member so that the tools under src/ resolve `@/` and Deno
  // materializes @db/postgres for them — which is all a member has to be.
  "imports": {
    "@/": "./src/",

    // database
    "@db/postgres": "jsr:@db/postgres@^0.19.5"
  }
}
