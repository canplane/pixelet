{
  "name": "@pixelet/server",
  "version": "0.0.0",
  "exports": "./src/index.ts",

  "tasks": {
    "dev": "deno task build:dev && (deno task watch:dev & deno task serve:dev)",

    "build:dev": "deno run -A --node-modules-dir=auto npm:vite build --mode development",
    "watch:dev": "deno run -A --node-modules-dir=auto npm:vite build --watch --mode development",
    "serve:dev": "deno run -A --watch=dist/main/server.js --env=../.env dist/main/server.js",

    "build": "deno run -A --node-modules-dir=auto npm:vite build",

    "check": "deno check src/index.ts"
  },

  "compilerOptions": { "types": ["./@types/index.d.ts"] },

  "imports": {
    "@/": "./src/",

    // server framework
    "@hono/hono": "jsr:@hono/hono@^4.12.2",
    "socket.io": "npm:socket.io@^4",

    // database
    "@db/postgres": "jsr:@db/postgres@^0.19.5"
  }
}
