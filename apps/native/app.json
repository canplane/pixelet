{
  "expo": {
    "name": "pixelet",
    "slug": "pixelet",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "ios": { "bundleIdentifier": "me.plei.pixelet" },
    "android": { "package": "me.plei.pixelet" },
    "plugins": [
      ["expo-location", { "locationWhenInUsePermission": "pixelet shows you where you are on the map, and what you build stands there." }]
    ]
  }
}
