{
  // What the device's own files are type-checked against (root deno.jsonc's
  // check:native): its own `@/`, and the client as `@pxl/client/`. Metro bundles the app and reads none of this (metro.config.ts); its
  // npm packages are package.json's.
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["../client/@types/index.d.ts", "npm:@types/react@^19", "npm:@webgpu/types@^0.1.69"]
  },

  "imports": {
    "@/": "./src/",
    "@pxl/client/": "../client/src/"
  }
}
