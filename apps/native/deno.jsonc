{
  // What the device's own files are type-checked against (root deno.jsonc's
  // check:native): the shell they sit beside, and `@platform/` as this app's
  // own. Metro bundles the app and reads none of this (metro.config.js); its
  // npm packages are package.json's.
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["../web/@types/index.d.ts", "npm:@types/react@^19", "npm:@webgpu/types@^0.1.69"]
  },

  "imports": {
    "@/": "../web/src/",
    "@platform/": "./src/platform/"
  }
}
