{
  // What the device's own files are type-checked against (root deno.jsonc's
  // check:native): the shell they sit beside, and `@platform/` as this app's
  // own. Metro resolves the tree through these same maps (metro.config.ts,
  // apps/client/script/import-map.ts); its npm packages are package.json's.
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["../client/@types/index.d.ts", "npm:@types/react@^19", "npm:@webgpu/types@^0.1.69"]
  },

  "imports": {
    "@/": "../client/src/",
    "@platform/": "./src/platform/"
  }
}
