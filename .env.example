# ------------------------------------------------------------------
# Pixelet Application Environment Variables
# "A droplet fades. A pixelet remains."
# ------------------------------------------------------------------

# [API Server]
NODE_ENV=development
API_HOST=0.0.0.0  # localhost -> 0.0.0.0 변경
API_PORT=3000

# [Main DB - Business Logic]
# NestJS TypeORM 등에서 사용
DATABASE_URL=postgresql://pixelet:pixelet@localhost:5432/pixelet
MAIN_DB_USER=pixelet
MAIN_DB_PASSWORD=pixelet
MAIN_DB_NAME=pixelet
MAIN_DB_PORT=5432
MAIN_DB_HOST=localhost

# [Geo DB - OSM/GIS]
# 쉘 스크립트와 NestJS GIS 모듈에서 참조
GEO_DB_USER=pixelet_geo_admin
GEO_DB_PASSWORD=pixelet_geo_secret
GEO_DB_NAME=pixelet_geo
GEO_DB_PORT=5433
GEO_DB_HOST=localhost

# [OSM Data Config]
COUNTRY_CODE=KR

# [Docker Infra]
PROJECT_NAME=pixelet
DB_GEO_CONTAINER_NAME=pixelet-db-geo
PIXELET_NETWORK=pixelet-network

# [Optional]
# JWT_SECRET=change-me
# LOG_LEVEL=debug