# [Project Meta]
PROJECT_NAME=pixelet
DOCKER_NETWORK=pixelet-network

# [API Server]
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000

# [Core DB - Business Logic]
CORE_DB_USER=pixelet
CORE_DB_PASSWORD=pixelet
CORE_DB_NAME=pixelet
CORE_DB_PORT=5432
CORE_DB_HOST=localhost
CORE_DB_CONTAINER=pixelet-db-core
DATABASE_URL=postgresql://${CORE_DB_USER}:${CORE_DB_PASSWORD}@${CORE_DB_HOST}:${CORE_DB_PORT}/${CORE_DB_NAME}

# [Geo DB - OSM/GIS]
GEO_DB_USER=pixelet_geo_admin
GEO_DB_PASSWORD=pixelet_geo_secret
GEO_DB_NAME=pixelet_geo
GEO_DB_PORT=5433
GEO_DB_HOST=localhost
GEO_DB_CONTAINER=pixelet-db-geo
GEO_DB_HOST_DOCKER=pixelet-db-geo

# [Shell Script Automation]
# psql/osm2pgsql 표준 환경변수 (로컬 & 스크립트 공용)
# 현재 자동화 타겟이 Geo DB이므로 Geo의 비밀번호를 할당합니다.
PGUSER=${GEO_DB_USER}
PGDATABASE=${GEO_DB_NAME}
PGPASSWORD=${GEO_DB_PASSWORD}
PGPORT=${GEO_DB_PORT}

# [OSM Ingestion Config]
OSM_STYLE_NAME=default.style
OSM_CACHE_SIZE=2000

# [Optional]
LOG_LEVEL=debug
# JWT_SECRET=your_jwt_secret_here