# ------------------------------------------------------------------------------
# api server
# ------------------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=3000
MAX_BODY_SZ_MB=10
DB_POOL_SIZE=8
# gates /api/internal/* (cache invalidation, etc.) — generate with e.g. `openssl rand -hex 24`
ADMIN_TOKEN=

# ------------------------------------------------------------------------------
# database: main
# ------------------------------------------------------------------------------

# Nothing reads db-main. The search server and the tile server both take
# DB_GEO_URL alone; the application server that will own this one does not
# exist yet. The container stays up so that the local stack matches
# production's — see issue/20260918-the-server-in-rust-and-the-line-already-drawn.md.
DB_MAIN_USER=pixelet_main
DB_MAIN_PASSWORD=pixelet_main
DB_MAIN_NAME=pixelet_main
DB_MAIN_PORT=5432
DB_MAIN_HOST=localhost
DB_MAIN_CONTAINER=pixelet-db-main
DB_MAIN_URL=postgresql://${DB_MAIN_USER}:${DB_MAIN_PASSWORD}@${DB_MAIN_HOST}:${DB_MAIN_PORT}/${DB_MAIN_NAME}

# ------------------------------------------------------------------------------
# database: geo
# ------------------------------------------------------------------------------

DB_GEO_USER=pixelet_geo
DB_GEO_PASSWORD=pixelet_geo
DB_GEO_NAME=pixelet_geo
DB_GEO_PORT=5433
DB_GEO_HOST=localhost
DB_GEO_CONTAINER=pixelet-db-geo
DB_GEO_URL=postgresql://${DB_GEO_USER}:${DB_GEO_PASSWORD}@${DB_GEO_HOST}:${DB_GEO_PORT}/${DB_GEO_NAME}

# ------------------------------------------------------------------------------
# infra / optional
# ------------------------------------------------------------------------------

DOCKER_NETWORK=pixelet-network