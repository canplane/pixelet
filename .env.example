# [Project Meta]
PROJECT_NAME=pixelet
DOCKER_NETWORK=pixelet-network

# [API Server]
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000

# [Main DB - Business Logic]
DB_MAIN_USER=pixelet
DB_MAIN_PASSWORD=pixelet
DB_MAIN_NAME=pixelet
DB_MAIN_PORT=5432
DB_MAIN_HOST=localhost
DB_MAIN_CONTAINER=pixelet-db-main
DB_MAIN_URL=postgresql://${DB_MAIN_USER}:${DB_MAIN_PASSWORD}@${DB_MAIN_HOST}:${DB_MAIN_PORT}/${DB_MAIN_NAME}

# [Geo DB - OSM/GIS]
DB_GEO_USER=pixelet_geo_admin
DB_GEO_PASSWORD=pixelet_geo_secret
DB_GEO_NAME=pixelet_geo
DB_GEO_PORT=5433
DB_GEO_HOST=localhost
DB_GEO_CONTAINER=pixelet-db-geo
DB_GEO_HOST_DOCKER=pixelet-db-geo

# [Optional]
LOG_LEVEL=debug
# JWT_SECRET=your_jwt_secret_here