{
  "deno": {
    "command": "deno",
    "args": ["run", "-A", "${CLAUDE_PLUGIN_ROOT}/proxy.ts", "ts", "xpute/ts"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".mts": "typescript",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mjs": "javascript"
    },
    "initializationOptions": { "enable": true, "lint": false },
    "workspaceFolder": "${CLAUDE_PROJECT_DIR}"
  }
}
