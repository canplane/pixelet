{
  // The one script here bound to a JS-only library: tint.ts, Tint's compile
  // of the generated shaders through Dawn (npm:webgpu). The rest of script/
  // is Python and sh, each in the language its work takes.
  "workspace": [],

  "imports": {
    // Dawn, the WebGPU Chrome runs, for the generated kernels' compile.
    "webgpu": "npm:webgpu@0.6.2"
  },

  "tasks": {
    "check": "deno fmt --check && deno lint && deno check *.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },

  "fmt": {
    "lineWidth": 200,
    "proseWrap": "preserve"
  }
}
