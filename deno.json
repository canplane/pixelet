{
  "description": "A droplet fades. A pixelet remains.",

  "workspace": [
    "shared",
    "server",
    "client",

    "apps/api",
    "apps/web",
    "packages/pxl/engine",
    "packages/pxl/engine-spare",
    "packages/pxl/bake",
    "packages/pxl/render",
    "packages/pxl/common",
    "packages/pxl/spec",

    "packages/xpute/core",
    "packages/xpute/spec"
  ],
  "nodeModulesDir": "auto",

  "tasks": {
    "dev": "sh -c \"(deno task dev:api) & (deno task dev:web) & wait\"",
    "dev:api": "deno task --cwd apps/api dev",
    "dev:web": "deno task --cwd apps/web dev",

    "build:api": "deno task --cwd apps/api build",
    "build:web": "deno task --cwd apps/web build",

    "check": "deno task check:api && deno task check:web",
    "check:api": "deno task --cwd apps/api check",
    "check:web": "deno task --cwd apps/web check",

    "check:shared": "deno check shared/src/**/*.ts",
    "dev:server-new": "deno task --cwd server dev",
    "check:server-new": "deno task --cwd server check",
    "dev:client-new": "deno task --cwd client dev",
    "check:client-new": "deno task --cwd client check",

    "lint": "deno lint",
    "fmt": "deno fmt"
  },

  "compilerOptions": {
    "lib": ["deno.window", "deno.ns", "deno.unstable", "esnext"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "checkJs": false,
    // "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,

    "types": [
      "npm:@webgpu/types",

      "./packages/xpute/spec/@types/index.d.ts"
    ]
  },
  "unstable": ["webgpu"],

  "imports": {
    // MVP restart (client/server/shared) — see feat/mvp-restart
    "@pixelet/shared/": "./shared/src/",
    "@pixelet/server/": "./server/src/",

    // monorepo packages
    "@pxl/engine/": "./packages/pxl/engine/",
    "@pxl/engine-spare/": "./packages/pxl/engine-spare/",
    "@pxl/bake/": "./packages/pxl/bake/src/",
    "@pxl/render/": "./packages/pxl/render/src/",
    "@pxl/common/": "./packages/pxl/common/src/",
    "@pxl/spec/": "./packages/pxl/spec/src/",

    "@webgpu/types": "npm:@webgpu/types@^0.1.69",

    "@xpute/core/": "./packages/xpute/core/src/",
    "@xpute/spec/": "./packages/xpute/spec/src/",

    "flatbuffers": "npm:flatbuffers@^25.9.23",

    // build tools
    "vite": "npm:vite@^7.2.4",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.6",

    // testing & assertions
    "@std/assert": "jsr:@std/assert@^1.0.19",

    // networking
    "socket.io-client": "npm:socket.io-client@^4",

    // cryptography
    "@noble/curves": "npm:@noble/curves@^2.0.1",
    "@noble/ed25519": "npm:@noble/ed25519@^3.0.0",
    "@noble/hashes": "npm:@noble/hashes@^1.8.0",
    "uuid": "npm:uuid@^13.0.0",

    // status management
    "immer": "npm:immer@^11.1.3",

    // math & utilities
    "gl-matrix": "npm:gl-matrix@^3.4.4",
    "date-fns": "npm:date-fns@^4.1.0",

    // internationalization
    "i18next": "npm:i18next@^25.7.3"
  },

  "fmt": {
    "lineWidth": 200,
    "proseWrap": "preserve",

    "exclude": ["node_modules/", "dist/"]
  },

  "lint": {
    "rules": { "tags": ["recommended"] },

    "exclude": ["node_modules/", "dist/"]
  }
}
