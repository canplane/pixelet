{
  "description": "A droplet fades. A pixelet remains.",

  "workspace": [
    "apps/api",
    "apps/web",

    "packages/pxl/shared",
    "packages/xpute/core"
  ],
  "nodeModulesDir": "auto",

  // Keeps Deno's config-tree walker (LSP + CLI) from wandering into build
  // caches that carry their own package.json — Vite's deps optimizer cache
  // in particular gets misread as a rogue workspace member ("Config file
  // must be a member of the workspace") since it's nested under apps/web.
  "exclude": ["**/.vite/", "**/dist/", "**/node_modules/"],

  "tasks": {
    // Four processes: the client, the two servers a deployment runs — geo for
    // the world's data and api for the application's — and the tile server it
    // does not, since a deployment serves baked tiles out of the bucket and
    // this bakes them on demand instead
    // (issue/20260918-the-server-in-rust-and-the-line-already-drawn.md). The
    // `server` profile rather than a debug build: the rasterizer under one is
    // slow enough to be felt on every page.
    "dev": "sh -c \"(deno task dev:geo) & (deno task dev:api) & (deno task dev:tiles) & (deno task dev:web) & wait\"",
    "dev:geo": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server -p pxl-geo -- \"$@\"' --",
    "dev:api": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server -p pxl-api -- \"$@\"' --",
    "dev:tiles": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server --features serve --bin serve_tiles -- \"$@\"' --",
    "dev:web": "deno task --cwd apps/web dev",
    // Client only, tiles served from the published deployment — no Docker, no
    // database, no API process. Not usable for bake work: a published tile
    // prefix is frozen. See apps/web/vite.config.ts.
    "dev:remote": "deno task --cwd apps/web dev:remote",
    "preview:remote": "deno task --cwd apps/web preview:remote",

    // The three offline bakes, all resumable and all needing the geo DB up.
    // terrain walks the coverage and classifies land against ocean; poi and
    // geocode reuse the land list it writes. Procedure and verification are in
    // .agents/skills/bake-tiles/SKILL.md; uploading is publish-bucket.
    "bake:tiles": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server --bin bake_tiles -- \"$@\"' --",
    "bake:poi": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server --bin bake_poi_tiles -- \"$@\"' --",
    "bake:geocode": "sh -c '[ -f .env ] && set -a && . ./.env && set +a; exec cargo run --manifest-path crates/Cargo.toml --profile server --bin bake_geocode_tiles -- \"$@\"' --",

    // Builds the client and publishes the Cloudflare Worker that serves it
    // along with the R2 tiles. Uploading the tiles themselves is separate —
    // see .agents/skills/publish-bucket/SKILL.md.
    "deploy": "deno task --cwd apps/web deploy",

    // Copies every file under asset/ to ./out/asset/{glb,png}/<sha256> and
    // regenerates the table the shipped palette reads. Uploading is separate
    // — see .agents/skills/publish-bucket/SKILL.md.
    "ingest:asset": "deno run -A apps/api/src/bake/asset/tool/ingest_asset.ts",

    "build:api": "deno task --cwd apps/api build",
    "build:web": "deno task --cwd apps/web build",
    "build:wasm": "deno task --cwd apps/web build:wasm",

    // Drops what Deno and Vite materialize and re-checks from nothing. Named
    // paths only; nothing is found by name and deleted.
    "reset": "rm -rf node_modules apps/api/node_modules apps/web/node_modules apps/api/dist apps/web/dist && deno task check",

    "check": "deno task check:api && deno task check:web && deno task check:shared && deno task check:xpute && deno task check:rust && deno task check:spec && deno task check:locale",
    "check:api": "deno task --cwd apps/api check",
    "check:web": "deno task --cwd apps/web check",
    "check:shared": "deno check packages/pxl/shared/src/**/*.ts",
    "check:xpute": "deno check packages/xpute/core/src/**/*.ts",
    // The Rust, for the targets it ships to. Clippy type-checks as it lints,
    // and a warning fails it, as a type error fails the others. Three passes,
    // because no one run covers all of it.
    //
    // The wasm32 pass lints what the client ships, and names its crates rather
    // than taking the workspace: the server's do not build for wasm32 and are
    // not meant to. It builds the libraries only, so a `.test.rs` —
    // `#[cfg(test)]`, and never compiled for a target whose tests cannot link
    // — can be broken by a type change and every gate here still pass, which
    // happened twice on 09-17; the host pass below is what covers that, and it
    // compiles every target, tests included, and runs none of them. pxl-wasm
    // is `core::arch::wasm32` throughout and has no host build at all, so it
    // appears in the first pass and not the second.
    //
    // The server's own pass is separate because it is a host binary: nothing
    // of it reaches the module, and nothing of the module's targets reaches it.
    // Twice, because the bake crate has a feature: the first pass is what a
    // build of the bake tools compiles, the second adds the dev tile server,
    // and a lint run under only one of them would leave the other's code
    // unlinted until it broke.
    //
    // Formatting is checked first, over the whole workspace, against
    // crates/rustfmt.toml; the generated `.rs` files pass it because
    // script/spec.ts writes them through rustfmt.
    "check:rust": "cargo fmt --manifest-path crates/Cargo.toml --all --check && cargo clippy --manifest-path crates/Cargo.toml --target wasm32-unknown-unknown -p xpute-core -p pxl-spec -p pxl-render -p pxl-kernel -p pxl-wasm -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --all-targets -p pxl-overture -p pxl-geo -p pxl-geo-bake -p pxl-api -- -D warnings && cargo clippy --manifest-path crates/Cargo.toml --all-targets -p pxl-geo-bake --features serve -- -D warnings && cargo check --manifest-path crates/Cargo.toml --all-targets -p xpute-core -p pxl-spec -p pxl-render -p pxl-kernel",
    // The specs are JSON; the TypeScript and the Rust that carry them are
    // written from it (script/spec.ts), and the gate fails on a stale one.
    "check:spec": "deno run -A script/spec.ts",
    "spec": "deno run -A script/spec.ts --write",
    // A catalog entry is a number, an id and a name in every locale; the
    // first two are written from the JSON, the last is people's (script/locale.ts).
    "check:locale": "deno run -A script/locale.ts",

    // What a deployment must answer, against a running one. The gate is what a
    // checkout proves; this is what a deploy proves, and it is the last step of
    // both deploy jobs in .github/workflows/check-and-deploy.yml.
    "smoke": "deno run -A script/smoke.ts",

    "test": "deno task test:web && deno task test:api && deno task test:shared && deno task test:xpute && deno task test:rust",
    "test:web": "deno task --cwd apps/web test",
    "test:api": "deno test -A apps/api/src",
    "test:shared": "deno test -A packages/pxl/shared/src",
    "test:xpute": "deno test -A packages/xpute/core/src",
    // The Rust core natively, where naga compiles every shader and holds
    // each pipeline's record to it (crates/pxl/render/src/frame/shader/record.rs).
    "test:rust": "cargo test --manifest-path crates/Cargo.toml -p xpute-core -p pxl-spec -p pxl-render -p pxl-kernel -p pxl-overture -p pxl-geo -p pxl-geo-bake -p pxl-api",

    "lint": "deno lint",
    "fmt": "deno fmt"
  },

  "compilerOptions": {
    "lib": ["deno.window", "deno.ns", "deno.unstable", "esnext"],
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "checkJs": false
    // "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,
  },

  "imports": {
    "@pxl/api/": "./apps/api/src/",
    "@pxl/shared/": "./packages/pxl/shared/src/",
    "@xpute/core/": "./packages/xpute/core/src/",

    // testing
    "@std/assert": "jsr:@std/assert@^1",

    // script/spec.ts, script/locale.ts
    "@std/path": "jsr:@std/path@^1",

    // build tools
    "vite": "npm:vite@^7.2.4",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.6",

    // state management
    "immer": "npm:immer@^11.1.3",

    // internationalization
    "i18next": "npm:i18next@^25.7.3"
  },

  "fmt": {
    "lineWidth": 200,
    "proseWrap": "preserve",

    // The vectors are committed as they were written and read byte for byte
    // by the Rust tests; formatting them would break that.
    "exclude": ["node_modules/", "dist/", "crates/**/vector/"]
  },

  "lint": {
    "rules": { "tags": ["recommended"] },

    "exclude": ["node_modules/", "dist/"]
  }
}
