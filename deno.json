{
  "description": "A droplet fades. A pixelet remains.",

  "workspace": [
    "apps/api",
    "apps/web",

    "packages/pxl/shared",
    "packages/xpute/core"
  ],
  "nodeModulesDir": "auto",

  // Keeps Deno's config-tree walker (LSP + CLI) from wandering into build
  // caches that carry their own package.json — Vite's deps optimizer cache
  // in particular gets misread as a rogue workspace member ("Config file
  // must be a member of the workspace") since it's nested under apps/web.
  "exclude": ["**/.vite/", "**/dist/", "**/node_modules/"],

  "tasks": {
    "dev": "sh -c \"(deno task dev:api) & (deno task dev:web) & wait\"",
    "dev:api": "deno task --cwd apps/api dev",
    "dev:web": "deno task --cwd apps/web dev",
    // Client only, tiles served from the published deployment — no Docker, no
    // database, no API process. Not usable for bake work: a published tile
    // prefix is frozen. See apps/web/vite.config.ts.
    "dev:remote": "deno task --cwd apps/web dev:remote",
    "preview:remote": "deno task --cwd apps/web preview:remote",

    // Bakes every land page in the geo DB's coverage into ./out/terrain/<version>.
    // Needs the geo DB up; resumable. Procedure and verification are in
    // .agents/skills/bake-tiles/SKILL.md; uploading is publish-bucket.
    "bake:tiles": "deno run -A --env=.env apps/api/src/bake/terrain/tool/bake_tiles.ts",

    // Builds the client and publishes the Cloudflare Worker that serves it
    // along with the R2 tiles. Uploading the tiles themselves is separate —
    // see .agents/skills/publish-bucket/SKILL.md.
    "deploy": "deno task --cwd apps/web deploy",

    // Copies every file under asset/ to ./out/asset/{glb,png}/<sha256> and
    // regenerates the table the shipped palette reads. Uploading is separate
    // — see .agents/skills/publish-bucket/SKILL.md.
    "ingest:asset": "deno run -A apps/api/src/bake/asset/tool/ingest_asset.ts",

    "build:api": "deno task --cwd apps/api build",
    "build:web": "deno task --cwd apps/web build",
    "build:wasm": "deno task --cwd apps/web build:wasm",

    // Drops what Deno and Vite materialize and re-checks from nothing. Named
    // paths only; nothing is found by name and deleted.
    "reset": "rm -rf node_modules apps/api/node_modules apps/web/node_modules apps/api/dist apps/web/dist && deno task check",

    "check": "deno task check:api && deno task check:web && deno task check:shared && deno task check:xpute && deno task check:rust && deno task check:pair",
    "check:api": "deno task --cwd apps/api check",
    "check:web": "deno task --cwd apps/web check",
    "check:shared": "deno check packages/pxl/shared/src/**/*.ts",
    "check:xpute": "deno check packages/xpute/core/src/**/*.ts",
    // The Rust core, for the target it ships to. Clippy type-checks as it
    // lints, and a warning fails it, as a type error fails the others.
    "check:rust": "cargo clippy --manifest-path crates/Cargo.toml --target wasm32-unknown-unknown -- -D warnings",
    // The kits twice: every file, export and test of @xpute/core and of
    // @pxl/shared's space has its pair in the crates, and the vectors the
    // TypeScript writes are what the Rust tests read (script/pair.ts).
    "check:pair": "deno run -A script/pair.ts",
    "vector": "deno run -A script/pair.ts --write",

    "test": "deno task test:web && deno task test:api && deno task test:shared && deno task test:xpute && deno task test:rust",
    "test:web": "deno task --cwd apps/web test",
    "test:api": "deno test -A apps/api/src",
    "test:shared": "deno test -A packages/pxl/shared/src",
    "test:xpute": "deno test -A packages/xpute/core/src",
    // The Rust core natively, where naga compiles every shader and holds
    // each pipeline's record to it (crates/pxl-core/src/shader.rs).
    "test:rust": "cargo test --manifest-path crates/Cargo.toml -p xpute-core -p pxl-shared -p pxl-core",

    "lint": "deno lint",
    "fmt": "deno fmt"
  },

  "compilerOptions": {
    "lib": ["deno.window", "deno.ns", "deno.unstable", "esnext"],
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "checkJs": false
    // "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,
  },

  "imports": {
    "@pxl/api/": "./apps/api/src/",
    "@pxl/shared/": "./packages/pxl/shared/src/",
    "@xpute/core/": "./packages/xpute/core/src/",

    // testing
    "@std/assert": "jsr:@std/assert@^1",

    // script/pair.ts
    "@std/fs": "jsr:@std/fs@^1",
    "@std/path": "jsr:@std/path@^1",

    // build tools
    "vite": "npm:vite@^7.2.4",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.6",

    // state management
    "immer": "npm:immer@^11.1.3",

    // internationalization
    "i18next": "npm:i18next@^25.7.3"
  },

  "fmt": {
    "lineWidth": 200,
    "proseWrap": "preserve",

    // The vectors are what script/pair.ts writes, and are checked byte for
    // byte as written; formatting them would fail that check.
    "exclude": ["node_modules/", "dist/", "crates/**/vector/"]
  },

  "lint": {
    "rules": { "tags": ["recommended"] },

    "exclude": ["node_modules/", "dist/"]
  }
}
