{
  // Only what the editor alone is told: the trees' own configs say how
  // their code is indented, formatted and linted.

  // TypeScript as each tree's tsconfig.json has it, formatted by Prettier.
  "[javascript][typescript][javascriptreact][typescriptreact][json][jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  // An import names another package through its alias, never a counted `../`.
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.updateImportsOnFileMove.enabled": "never",

  // Rust. Cargo's two workspaces, each its own root: rust-analyzer finds only
  // a manifest at most one folder down, which reaches rust/ but not
  // xpute/rust/. The shader's (rust/client/shader) is rust-gpu's, built in its
  // container, and left out.
  "rust-analyzer.linkedProjects": ["rust/Cargo.toml", "xpute/rust/Cargo.toml"]
}
