{
  // Only what the editor alone is told: the trees' own configs say how
  // their code is indented, formatted and linted.

  // Deno. It is the trees' alone; nothing at the root is Deno's, so outside
  // them it neither formats, lints nor types.
  "deno.enablePaths": ["ts", "xpute/ts"],
  // No "deno.config" pin: each workspace member resolves its own import map
  // ("@/" in ts/client, ts/app/web and ts/app/native), and a pin makes every
  // file resolve against one config alone, where "@/" is unknown.
  // The editor's own TypeScript neither checks nor formats what Deno does.
  "js/ts.validate.enabled": false,
  "[javascript][typescript][javascriptreact][typescriptreact][json][jsonc]": { "editor.defaultFormatter": "denoland.vscode-deno" },
  // An import names another package through the map, never a counted `../`.
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.updateImportsOnFileMove.enabled": "never",

  // Rust. Cargo's two workspaces, each its own root: rust-analyzer finds only
  // a manifest at most one folder down, which reaches rust/ but not
  // xpute/rust/. The shader's (rust/client/shader) is rust-gpu's, built in its
  // container, and left out.
  "rust-analyzer.linkedProjects": ["rust/Cargo.toml", "xpute/rust/Cargo.toml"]
}
