#!/bin/bash

# A tool of the ingests', run in this folder's image, built first so it is
# always the Dockerfile's: the repository mounted at its own path and the
# tool run in the caller's directory, so a path means there what it means
# here, and on the host's network, so DB_GEO_URL reaches db-geo as it does
# from the host.
#
#   ./infra/geo/tools/run <tool> [<arg>]…

set -e

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$TOOLS_DIR/../../.." && pwd)"
IMAGE=pixelet-geo-tools

docker build -q -t "$IMAGE" "$TOOLS_DIR" > /dev/null
exec docker run --rm -i --network host -v "$REPO_ROOT:$REPO_ROOT" -w "$PWD" "$IMAGE" "$@"
