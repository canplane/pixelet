# [default.style] - The Iron Wall Edition (Zero Data Loss)

# 1. Naming & identification — preserve every object's identity
node,way   name         text         linear
node,way   place        text         linear    # settlement/neighbourhood place names
node,way   ref          text         linear    # road numbers and route designations

# 2. Mountains & nature — this block is what stopped mountain ranges from going missing
node,way   natural      text         linear    # collects both peak (node) and wood (way)
node,way   landuse      text         linear    # forest, grass, meadow, ...
node,way   ele          text         linear    # elevation — required to generate mountain POIs
node,way   mountain_range text       linear    # large mountain ranges
node,way   ridge        text         linear    # ridges
node,way   peak         text         linear    # summits
node,way   cliff        text         linear    # cliffs
node,way   rock         text         linear    # rocky terrain

# 3. Structures & architecture — numeric inputs for 3D voxel rendering
node,way   building     text         polygon   # buildings must come through as polygons
node,way   building:part text        polygon   # composite building structures
node,way   building:levels text      linear    # floor count, used to derive height
node,way   height       text         linear    # actual height in metres
node,way   min_level    text         linear    # piloti / mid-level rendering
node,way   man_made     text         linear    # piers, bridges, dykes, ...

# 4. Transport & infrastructure — road network integrity
node,way   highway      text         linear    # roads of every class
node,way   railway      text         linear    # all rail: heavy rail, subway, tram
node,way   subway       text         linear    # subway collected explicitly, for the tagging variants that need it
node,way   station      text         linear    # stations
node,way   route        text         linear    # IMPORTANT: routes — subway lines are route=subway; also carries road-network connectivity
node,way   service      text         linear    # depots and connecting lines (rail detail)
node,way   public_transport text     linear    # current standard: platforms, stops, station areas (v2 schema)
node,way   junction     text         linear    # junction shape
node,way   lanes        text         linear    # lane count, for computing road width
node,way   bridge       text         linear    # bridge vertical offset
node,way   tunnel       text         linear    # used to exclude tunnels from rendering
node,way   layer        text         linear    # vertical layering — prevents z-fighting

# 5. Leisure & public — the main determinant of perceived urban density
node,way   leisure      text         linear    # parks, nature reserves, sports grounds
node,way   amenity      text         linear    # car parks, schools, hospitals
node,way   shop         text         linear    # shops
node,way   tourism      text         linear    # tourist sites, viewpoints
node,way   historic     text         linear    # cultural properties and historic sites

# 6. Water system — hydrographic detail
node,way   water        text         linear    # lakes and reservoirs
node,way   waterway     text         linear    # rivers, canals, drains

# 7. Safety net (hstore guard)
# Forces every tag not listed above into the tags column.
# Works together with the --hstore-all option.
node,way   osm_id       text         phstore
node,way   osm_version  text         phstore
node,way   osm_uid      text         phstore

# 8. Geometry classification and terrain that would otherwise be missed
node,way   area         text         linear    # decisive hint for line-vs-polygon classification
node,way   wood         text         linear    # woods that appear under their own key rather than natural=
node,way   forest       text         linear    # second guard for forest data
node,way   aeroway      text         linear    # airports and helipads — large flat infrastructure
node,way   boundary     text         linear    # national park and area boundaries, for extent

# 9. Z-stacking & indoor — vertical structure detail
node,way   level        text         linear    # which floor something is on (not how many) — key to linking indoor and outdoor
node,way   indoor       text         linear    # indoor area classification
node,way   incline      text         linear    # slope of a road or landform — hint for generating voxel slopes

# 10. Bridge & tunnel details — elevated infrastructure
node,way   bridge:structure text     linear    # bridge piers, decks and other sub-structure
node,way   support      text         linear    # structural supports — needed to reconstruct viaducts in mountainous terrain

# 11. Specific terrain and texture
node,way   surface      text         linear    # ground material (dirt, gravel, asphalt) -> finer voxel colouring
node,way   bare_rock    text         linear    # exposed rock on mountainsides
node,way   scree        text         linear    # scree slopes
node,way   wetland      text         linear    # wetlands and marsh — the land/water boundary

# 12. Power & utility — pylons and infrastructure, landmarks in mountain terrain
node,way   power        text         linear    # pylons and poles — prominent POIs on hillsides
node,way   tower:type   text         linear    # tower type (communications, observation, ...)

# 13. Topography details — relief and continuity, key to coherent mountain ranges
node,way   topography   text         linear    # landform features (basins, hills, ...)
node,way   valley       text         linear    # valleys — restores the deep gaps between ranges
node,way   col          text         linear    # cols and saddles — where ranges connect
node,way   gully        text         linear    # gullies and small ravines
node,way   woodland     text         linear    # woodland — used alongside landuse=forest

# 14. Hydraulic details — finer water flow
node,way   intermittent text         linear    # intermittent watercourses that vanish between wet and dry seasons
node,way   stream       text         linear    # streams — stops small watercourses being dropped
node,way   drain        text         linear    # drains — the fine water network of urban infrastructure
node,way   canal        text         linear    # canals

# 15. Urban infrastructure — the complex 3D layout of a city
node,way   embankment   text         linear    # embankments — terrain beside roads at differing heights
node,way   retaining_wall text       linear    # retaining walls — key to representing stepped terrain
node,way   stairs       text         linear    # stairs — relief in the pedestrian layer
node,way   platform     text         linear    # platforms and decks — raised surface data

# 16. Safety & constraints — system keys that keep data intact
node,way   type         text         linear    # the key that determines a relation's type (multipolygon, ...)
# 'route' is declared once, in section 4 above — osm2pgsql (2.x) rejects a
# style file that names the same column twice with 'column "route" specified
# more than once', so it must not be repeated here for road connectivity.

# 17. Micro-infrastructure & environment
node,way   barrier      text         linear    # walls and fences — what makes space feel divided
node,way   fence_type   text         linear    # fence type (wood, wire, ...)
node,way   gate         text         linear    # gates and entrances, linked to POIs
node,way   tree         text         linear    # individual trees — density in mountain terrain
node,way   tree_row     text         linear    # tree rows — roadside detail
node,way   scrub        text         linear    # scrub — texture at the boundary between hill and flat
node,way   shrub        text         linear    # small shrubs
node,way   grass        text         linear    # grass — vegetation detail beyond landuse
node,way   garden       text         linear    # garden detail

# 18. Utility & service — everyday street furniture
node,way   emergency    text         linear    # hydrants and emergency call points — safety POIs
node,way   advertising  text         linear    # billboards and displays — night-scene and street detail
node,way   bench        text         linear    # benches — detail inside parks
node,way   waste_basket text         linear    # waste baskets — micro POIs

# 19. Landform precision — fine terrain texture
node,way   dyke         text         linear    # dykes
node,way   mud          text         linear    # mud and tidal flats — reinforces the water boundary

# 20. Architectural & cultural heritage
node,way   heritage     text         linear    # heritage designation — a target for special modelling
node,way   religion     text         linear    # religious sites — distinguishes architectural styles (mountain temples, churches, ...)
node,way   denomination text         linear    # denomination — a finer hint at architectural style
node,way   shrine       text         linear    # small shrines — detail along trails

# 21. Vertical connectivity — vertical movement, central to a 3D world
node,way   conveying    text         linear    # escalators and moving walkways — the city's vertical transport network
node,way   in_out       text         linear    # entrance connectivity
node,way   ramp         text         linear    # ramps for wheelchairs and vehicles

# 22. Natural textures & hazards
node,way   sinkhole     text         linear    # sinkholes and pits — depressions in the terrain
node,way   cave_entrance text        linear    # cave entrances — hidden points in mountain terrain

# 23. The catch-all — stops any metadata being lost
# Even with --hstore-all, declaring keys in this style file improves indexing efficiency.
node,way   fixme        text         phstore
node,way   source:name  text         phstore