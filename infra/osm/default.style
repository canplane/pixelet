# [default.style] - The Iron Wall Edition (Zero Data Loss)

# 1. Naming & Identification (모든 객체의 정체성 보존)
node,way   name         text         linear
node,way   place        text         linear    # 마을, 동네 단위 지명
node,way   ref          text         linear    # 도로 번호, 노선 정보

# 2. Mountain & Natural (산맥 실종 사건의 핵심 해결)
node,way   natural      text         linear    # peak(node), wood(way) 모두 수집
node,way   landuse      text         linear    # forest, grass, meadow 등
node,way   ele          text         linear    # 고도 정보 (산 POI 생성 필수)
node,way   mountain_range text       linear    # 거대 산맥 정보
node,way   ridge        text         linear    # 능선
node,way   peak         text         linear    # 산 봉우리
node,way   cliff        text         linear    # 절벽
node,way   rock         text         linear    # 암석 지형

# 3. Structure & Architecture (3D 복셀 렌더링 수치 데이터)
node,way   building     text         polygon   # 건물은 확실히 면으로
node,way   building:part text        polygon   # 복합 건물 구조
node,way   building:levels text      linear    # 건물 층수 (높이 연산용)
node,way   height       text         linear    # 실제 높이 (m)
node,way   min_level    text         linear    # 필로티 또는 중간층 렌더링용
node,way   man_made     text         linear    # 부두, 교량, 둑 등

# 4. Transport & Infrastructure (도로망 무결성)
node,way   highway      text         linear    # 모든 등급의 도로
node,way   railway      text         linear    # 철도 및 역사
node,way   junction     text         linear    # 교차로 형태
node,way   lanes        text         linear    # 도로 폭 계산 (width)
node,way   bridge       text         linear    # 교량 오프셋 연산용
node,way   tunnel       text         linear    # 터널 렌더링 제외 로직용
node,way   layer        text         linear    # 수직 층위 (Z-Fighting 방지)

# 5. Leisure & Public (도시 밀도를 결정하는 핵심 요소)
node,way   leisure      text         linear    # 공원, 자연보호구역, 운동장
node,way   amenity      text         linear    # 주차장, 학교, 병원
node,way   shop         text         linear    # 상점
node,way   tourism      text         linear    # 관광지, 전망대
node,way   historic     text         linear    # 문화재, 유적지

# 6. Water System (수계 정밀화)
node,way   water        text         linear    # 호수, 저수지
node,way   waterway     text         linear    # 하천, 운하, 배수구

# 7. Safety Net (hstore 가드)
# 명시되지 않은 모든 기타 태그를 tags 컬럼에 강제로 담습니다.
# --hstore-all 옵션과 함께 사용 시 시너지가 발생합니다.
node,way   osm_id       text         phstore
node,way   osm_version  text         phstore
node,way   osm_uid      text         phstore

# 8. 기하 구조 판정 및 누락 지형 (진짜 빈틈 메우기)
node,way   area         text         linear    # 선/면 판정의 결정적 힌트
node,way   wood         text         linear    # natural 외에 독립 키로 존재하는 숲
node,way   forest       text         linear    # 산림 데이터 이중 가드
node,way   aeroway      text         linear    # 공항, 헬기장 (대형 평지 인프라)
node,way   boundary     text         linear    # 국립공원 및 구역 경계 (범위 파악용)

# 9. [Z-Stacking & Indoor] 수직 구조 정밀화
node,way   level        text         linear    # 층수 구분이 아닌 '현재 층' 위치 (실내외 연결 핵심)
node,way   indoor       text         linear    # 실내 영역 판정
node,way   incline      text         linear    # 도로/지형의 경사도 (복셀 경사면 생성 시 힌트)

# 10. [Bridge & Tunnel Details] 입체 인프라 보강
node,way   bridge:structure text     linear    # 다리의 기둥, 상판 등 세부 구조
node,way   support      text         linear    # 구조물 지지대 (산악 지형 고가도로 복원용)

# 11. [Specific Terrain] 특수 지형 및 텍스처
node,way   surface      text         linear    # 지면 재질 (흙, 자갈, 아스팔트) -> 복셀 색상 정밀화
node,way   bare_rock    text         linear    # 바위산의 맨살 지형
node,way   scree        text         linear    # 산비탈의 너덜지대 (돌무더기)
node,way   wetland      text         linear    # 습지, 늪 (물과 땅의 경계 데이터)

# 12. [Power & Utility] 송전탑 및 인프라 (산악 지형의 랜드마크)
node,way   power        text         linear    # 송전탑, 전신주 (산 중턱에 찍히는 주요 POI)
node,way   tower:type   text         linear    # 타워 종류 (통신탑, 전망대 등)

# 13. [Topography Details] 지형의 입체감과 연속성 (산맥 보강 핵심)
node,way   topography   text         linear    # 지형적 특징 (분지, 언덕 등)
node,way   valley       text         linear    # 계곡 (산맥 사이의 깊은 골짜기 복원)
node,way   col          text         linear    # 산고개, 안부 (산맥의 연결점)
node,way   gully        text         linear    # 도랑, 작은 협곡
node,way   woodland     text         linear    # 삼림 지대 (landuse=forest와 병행 사용)

# 14. [Hydraulic Details] 수계의 정밀한 흐름
node,way   intermittent text         linear    # 간헐천 (건기/우기에 따라 사라지는 물길 보존)
node,way   stream       text         linear    # 시내, 개울 (작은 물길 누락 방지)
node,way   drain        text         linear    # 배수구 (도시 인프라의 미세 수계)
node,way   canal        text         linear    # 운하

# 15. [Urban Infrastructure] 도시의 복잡한 3D 레이아웃
node,way   embankment   text         linear    # 둑, 제방 (고저차가 있는 도로 옆 지형)
node,way   retaining_wall text       linear    # 옹벽 (단차 지형 표현의 핵심)
node,way   stairs       text         linear    # 계단 (보행로 레이어의 입체감)
node,way   platform     text         linear    # 승강장, 데크 (입체적인 면 데이터)

# 16. [Safety & Constraints] 데이터 보존을 위한 시스템 키
node,way   type         text         linear    # Relation의 타입을 결정하는 핵심 키 (multipolygon 등)
node,way   route        text         linear    # 도로망의 논리적 연결성

# 17. [Micro-Infrastructure & Environment] 미세 인프라 및 환경 (최종 봉쇄)
node,way   barrier      text         linear    # 담장, 울타리, 벽 (공간 분리감의 핵심)
node,way   fence_type   text         linear    # 울타리 종류 (나무, 철조망 등)
node,way   gate         text         linear    # 출입구, 게이트 (POI 연동)
node,way   tree         text         linear    # 단일 나무 (산악 지형 밀도 보강)
node,way   tree_row     text         linear    # 가로수길 (도로 옆 디테일)
node,way   scrub        text         linear    # 덤불, 관목 (산과 평지의 경계 텍스처)
node,way   shrub        text         linear    # 작은 관목
node,way   grass        text         linear    # 잔디 (landuse 외에 세부 식생 데이터)
node,way   garden       text         linear    # 정원 세부 데이터

# 18. [Utility & Service] 생활 밀착형 인프라
node,way   emergency    text         linear    # 소화전, 비상벨 (안전 관련 POI)
node,way   advertising  text         linear    # 광고판, 전광판 (도시 야경/디테일 요소)
node,way   bench        text         linear    # 벤치 (공원 내부 디테일)
node,way   waste_basket text         linear    # 쓰레기통 (미세 POI)

# 19. [Landform Precision] 지형의 미세 질감
node,way   dyke         text         linear    # 둑
node,way   mud          text         linear    # 진흙, 갯벌 (수계 경계 보강)

# 20. [Architectural & Cultural Heritage] 문화재 및 특수 건축물 (최종 완성)
node,way   heritage     text         linear    # 문화재 지정 여부 (특수 모델링 타겟)
node,way   religion     text         linear    # 종교 시설 (산속 사찰, 교회 등 건축 양식 구분)
node,way   denomination text         linear    # 종교 파벌 (디테일한 건축 양식 힌트)
node,way   shrine       text         linear    # 작은 사당, 성지 (산책로 디테일)

# 21. [Vertical Connectivity] 수직 이동 및 연결 구조 (3D 월드 핵심)
node,way   conveying    text         linear    # 에스컬레이터, 무빙워크 (도시 입체 이동망)
node,way   in_out       text         linear    # 출입구 연결 상태
node,way   ramp         text         linear    # 휠체어/차량용 경사로

# 22. [Natural Textures & Hazard] 지형의 미세 위험 및 질감
node,way   sinkhole     text         linear    # 싱크홀, 구덩이 (지형 움푹 파인 표현)
node,way   cave_entrance text        linear    # 동굴 입구 (산악 지형의 숨겨진 포인트)

# 23. [The Catch-All] 모든 메타데이터 유실 방지
# --hstore-all 옵션이 있어도 스타일 파일에 선언되어야 인덱싱 효율이 좋아집니다.
node,way   fixme        text         phstore
node,way   source:name  text         phstore