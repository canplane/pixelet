# infra/prod/.env.example — copy to .env on the VM itself, fill in real
# generated values, chmod 600 it. Never commit the real .env; never reuse
# local dev's own DB_MAIN_PASSWORD/DB_GEO_PASSWORD/ADMIN_TOKEN here — these
# are new, production-only secrets.
#
# Generate each with: openssl rand -base64 32

DB_MAIN_USER=pixelet
DB_MAIN_PASSWORD=
DB_MAIN_NAME=pixelet_main

DB_GEO_USER=pixelet
DB_GEO_PASSWORD=
DB_GEO_NAME=pixelet_geo

# Gates /api/internal/* (cache invalidation, etc.) — see
# apps/api/src/lib/admin_auth.ts. Same value the monthly refresh GitHub
# Actions workflow would need if it's ever pointed at this server instead
# of just baking to R2 directly.
ADMIN_TOKEN=
