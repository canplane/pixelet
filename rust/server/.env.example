# rust/server/.env.example — copy to .env beside it. The servers' own numbers;
# their databases' addresses are infra/local/.env's (script/with-env.sh reads
# both).

# One port a server, so both can run at once (`{GEO,API}_{HOST,PORT}`,
# src/config.rs). The tile server takes --port and defaults to 3001.
GEO_HOST=0.0.0.0
GEO_PORT=3000
API_HOST=0.0.0.0
API_PORT=3002
MAX_BODY_SZ_MB=10
DB_POOL_SIZE=8
# Gates the internal prefix on both servers (/geo/internal/*, /api/internal/*):
# generate with e.g. `openssl rand -hex 24`.
ADMIN_TOKEN=
