+async function perfPath(path: string, x: number, y: number): Promise<string> {
+  const pointer = (phase: PointerPhase, at: [f64, f64], button = 0) =>
+    input.pointer(phase, PointerType.Mouse, POINTER_ID, button, at[0], at[1]);
+  await wait(SETTLE_MS);
+  if (path === "zoomin") {
+    for (let n = 0; n < RUN; n++) {
+      input.wheel(WHEEL);
+      await wait(STEP_MS);
+    }
+    await wait(8000);
+  }
+  perf.start();
+  const t0 = performance.now();
+  if (path === "pan") {
+    pointer(PointerPhase.Down, [x, y]);
+    const step = setInterval(() => {
+      const s = (performance.now() - t0) / 1000;
+      pointer(PointerPhase.Move, [x + 30 * s, y]);
+    }, STEP_MS);
+    await wait(DRIVE_S * 1000);
+    clearInterval(step);
+    pointer(PointerPhase.Up, [x + 30 * DRIVE_S, y]);
+  } else if (path === "walk") {
+    input.keys(0, 1);
+    const step = setInterval(() => input.keys(0, 1), 200);
+    await wait(DRIVE_S * 1000);
+    clearInterval(step);
+    input.keys(0, 0);
+  } else if (path === "zoomin") {
+    for (let n = 0; n < RUN; n++) {
+      input.wheel(-WHEEL);
+      await wait(50);
+    }
+    await wait(DRIVE_S * 1000 - RUN * 50);
+  } else if (path === "still") {
+    await wait(DRIVE_S * 1000);
+  }
+  return perfReportText(await perfReportRead());
+}
