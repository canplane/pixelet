+
+/// The query asked, each node counted.
+struct Counting<'a> {
+    q: Asking<'a>,
+    asked: u64,
+}
+
+impl Query for Counting<'_> {
+    type At = <Asking<'static> as Query>::At;
+    fn root(&mut self, node: [i32; 3]) -> Self::At {
+        self.q.root(node)
+    }
+    fn child(&mut self, at: &Self::At, zoom: Zoom, node: [i32; 3]) -> Self::At {
+        self.q.child(at, zoom, node)
+    }
+    fn node(
+        &mut self,
+        at: &mut Self::At,
+        zoom: Zoom,
+        node: [i32; 3],
+        zooms: [Zoom; 2],
+        t0: f32,
+    ) -> answer::In<[u32; 2]> {
+        self.asked += 1;
+        self.q.node(at, zoom, node, zooms, t0)
+    }
+}
+
+/// Every texel of a tile takes, of the boxes its band's cells are listed as, the one its ray
+/// enters first, its depth the one its walk leaves (pxl-engine `list::cells`); and what a list
+/// holds and asks against what the tile's walks ask.
+#[test]
+fn a_tile_listed_answers_as_its_rays() {
+    let built = real_world::build(EYE);
+    let t = light::TILE;
+    let mut failed = Vec::new();
+    for c in cases(&built) {
+        let (s, starts) = box_of(&c);
+        let mut q = Counting {
+            q: Asking {
+                w: built.world(),
+                cuts: c.cuts,
+            },
+            asked: 0,
+        };
+        let (mut texels, mut differ, mut listed, mut list_asked, mut walk_asked) =
+            (0u64, 0u64, 0u64, 0u64, 0u64);
+        let mut shown = 0;
+        for ty in 0..SIZE / t {
+            for tx in 0..SIZE / t {
+                let band = s.band(SIZE, c.range, [tx as i32, ty as i32]);
+                let (o, _) = light::ray(&s, &starts, [tx * t, ty * t]);
+                let reach = (t - 1) as f32;
+                let sweep = Sweep {
+                    first: [0.0; 3],
+                    edges: [
+                        s.across.map(|v| v * reach),
+                        s.down.map(|v| v * reach),
+                        s.dir.map(|v| v * s.t_max),
+                    ],
+                    margin: 4.0 / (1 << FRAC_W) as f32,
+                };
+                let mut cells = Vec::new();
+                q.asked = 0;
+                list::cells(&mut q, o, &sweep, band, &mut |n, i| cells.push((n, i)));
+                list_asked += q.asked;
+                listed += cells.len() as u64;
+                q.asked = 0;
+                for j in 0..t {
+                    for i in 0..t {
+                        let p = [tx * t + i, ty * t + j];
+                        let (op, ray) = light::ray(&s, &starts, p);
+                        let d = Detail {
+                            range: [band, band],
+                            spacing: s.spacing(),
+                        };
+                        let walk = cast::first(&mut q, op, &ray, d, Until::Opaque);
+                        let mut best: Option<(f32, u32, answer::In<[u32; 2]>, cast::Node)> = None;
+                        for &(n, a) in &cells {
+                            let np = n.moved(o, op);
+                            let (lo, hi) = cast::asset_box(op, &np, answer::AIR[0]);
+                            let inside = (0..3).all(|k| lo[k] <= 0.0 && 0.0 < hi[k]);
+                            if inside && a.kind == answer::Kind::Cell {
+                                continue;
+                            }
+                            let (te, axis, enters) = cast::entry(op, &ray, &np, a.asset[0]);
+                            if enters && best.is_none_or(|b| te < b.0) {
+                                best = Some((te, axis, a, np));
+                            }
+                        }
+                        let listed_met = match best {
+                            Some((te, axis, a, np)) => cast::Trace {
+                                ends: if a.kind == answer::Kind::Lacks {
+                                    End::Lacks
+                                } else {
+                                    End::Hit
+                                },
+                                hit: cast::Hit {
+                                    t: te,
+                                    axis,
+                                    node: np,
+                                    at: (),
+                                    asset: a.asset,
+                                },
+                            },
+                            None => cast::Trace {
+                                ends: End::Miss,
+                                hit: cast::Hit {
+                                    t: ray.t_max,
+                                    axis: 0,
+                                    node: np_none(op),
+                                    at: (),
+                                    asset: answer::AIR,
+                                },
+                            },
+                        };
+                        let (w0, w1) = (
+                            light::word(light::depth(&s, &walk)),
+                            light::word(light::depth(&s, &listed_met)),
+                        );
+                        texels += 1;
+                        if w0 != w1 {
+                            differ += 1;
+                            if shown < 4 {
+                                shown += 1;
+                                eprintln!(
+                                    "  {} texel {p:?} band {band}: walk {:?} t {} {:?}, listed {:?} t {} {:?}",
+                                    c.name,
+                                    walk.ends,
+                                    walk.hit.t,
+                                    walk.hit.node,
+                                    listed_met.ends,
+                                    listed_met.hit.t,
+                                    listed_met.hit.node
+                                );
+                            }
+                        }
+                    }
+                }
+                walk_asked += q.asked;
+            }
+        }
+        let tiles = u64::from((SIZE / t) * (SIZE / t));
+        eprintln!(
+            "LIST {:40} tiles {tiles}: cells a tile {:.1}, asked a tile {:.1} listing, {:.1} walking; {differ} of {texels} texels differ",
+            c.name,
+            listed as f64 / tiles as f64,
+            list_asked as f64 / tiles as f64,
+            walk_asked as f64 / tiles as f64
+        );
+        if differ != 0 {
+            failed.push(format!("{}: {differ} of {texels} texels differ", c.name));
+        }
+    }
+    assert!(failed.is_empty(), "{}", failed.join("\n"));
+}
+
+/// A node no walk reached, for a miss's hit, which no depth reads.
+fn np_none(_: [i32; 3]) -> cast::Node {
+    cast::Node::ROOT
+}
