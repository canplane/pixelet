+/// The box a split `n`'s content lies in, in its steps (`answer::box_of` of its asset's
+/// words), in units from the origin at `og`: each step on the grid's own planes (`units`),
+/// as a node's are, the far one the node's own, `hi`. A step's width a whole count of the
+/// finest grid's over a node `BOX_STEPS` or more of them wide; finer, rounded out, as
+/// `e · side` fits a u32 there.
+pub(crate) fn content_bounds(
+    n: &Node,
+    og: [u32; 3],
+    hi: [f32; 3],
+    asset: [u32; 2],
+) -> ([f32; 3], [f32; 3]) {
+    let u = under(n.zoom);
+    let (first, past) = box_of(asset);
+    let step = |a: usize, e: u32, out: u32| {
+        if e >= BOX_STEPS {
+            return hi[a];
+        }
+        let at = if u >= BOX_STEPS - 1 {
+            e * ((u >> BOX_BITS) + 1)
+        } else {
+            (e * (u + 1) + out) >> BOX_BITS
+        };
+        units(n.corner[a].wrapping_add(at), og[a], n.roots[a])
+    };
+    (
+        [
+            step(0, first[0], 0),
+            step(1, first[1], 0),
+            step(2, first[2], 0),
+        ],
+        [
+            step(0, past[0], BOX_STEPS - 1),
+            step(1, past[1], BOX_STEPS - 1),
+            step(2, past[2], BOX_STEPS - 1),
+        ],
+    )
+}
