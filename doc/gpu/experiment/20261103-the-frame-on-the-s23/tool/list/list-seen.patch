+/// The query asked, each node counted.
+struct Counting<'a> {
+    q: Asking<'a>,
+    asked: u64,
+}
+
+impl Query for Counting<'_> {
+    type At = <Asking<'static> as Query>::At;
+    fn root(&mut self, node: [i32; 3]) -> Self::At {
+        self.q.root(node)
+    }
+    fn child(&mut self, at: &Self::At, zoom: Zoom, node: [i32; 3]) -> Self::At {
+        self.q.child(at, zoom, node)
+    }
+    fn node(
+        &mut self,
+        at: &mut Self::At,
+        zoom: Zoom,
+        node: [i32; 3],
+        zooms: [Zoom; 2],
+        t0: f32,
+    ) -> answer::In<[u32; 2]> {
+        self.asked += 1;
+        self.q.node(at, zoom, node, zooms, t0)
+    }
+}
