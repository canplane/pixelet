+/// What a list holds where the cells hidden from the light are left out: a cell at the band
+/// whose three faces toward the light each meet a listed cell of its zoom. A measurement.
+#[test]
+fn a_tile_listed_without_what_is_hidden() {
+    use std::collections::HashSet;
+    let built = real_world::build(EYE);
+    let t = light::TILE;
+    for c in cases(&built) {
+        let (s, starts) = box_of(&c);
+        let mut q = Counting { q: Asking { w: built.world(), cuts: c.cuts }, asked: 0 };
+        let (mut all, mut seen, mut coarse, mut tiles) = (0u64, 0u64, 0u64, 0u64);
+        let mut by = std::collections::BTreeMap::<(i32, &str), u64>::new();
+        for ty in (0..SIZE / t).step_by(4) {
+            for tx in (0..SIZE / t).step_by(4) {
+                let band = s.band(SIZE, c.range, [tx as i32, ty as i32]);
+                let (o, _) = light::ray(&s, &starts, [tx * t, ty * t]);
+                let reach = (t - 1) as f32;
+                let sweep = Sweep {
+                    first: [0.0; 3],
+                    edges: [s.across.map(|v| v * reach), s.down.map(|v| v * reach), s.dir.map(|v| v * s.t_max)],
+                    margin: 4.0 / (1 << FRAC_W) as f32,
+                };
+                let mut cells = Vec::new();
+                list::cells(&mut q, o, &sweep, band, &mut |n, i| cells.push((n, i)));
+                let solid: HashSet<(u32, [i32; 3])> = cells
+                    .iter()
+                    .filter(|(n, _)| n.zoom == band)
+                    .map(|(n, _)| (n.zoom, n.idx(o)))
+                    .collect();
+                // The faces toward the light: against its direction on each axis.
+                let toward = [0, 1, 2].map(|a| if s.dir[a] > 0.0 { -1 } else { 1 });
+                for (n, i) in &cells {
+                    all += 1;
+                    if n.zoom != band {
+                        let k = match i.kind { answer::Kind::Lacks => "lacks", answer::Kind::Cell => "cell", answer::Kind::Split => "split" };
+                        *by.entry((n.zoom as i32 - band as i32, k)).or_default() += 1;
+                        coarse += 1;
+                        seen += 1;
+                        continue;
+                    }
+                    let _ = i;
+                    let x = n.idx(o);
+                    let hidden = (0..3).all(|a| {
+                        if s.dir[a] == 0.0 {
+                            return true;
+                        }
+                        let mut m = x;
+                        m[a] += toward[a];
+                        solid.contains(&(n.zoom, m))
+                    });
+                    if !hidden {
+                        seen += 1;
+                    }
+                }
+                tiles += 1;
+            }
+        }
+        eprintln!(
+            "SEEN {:40} tiles {tiles}: cells a tile {:.1}, of them not hidden {:.1} ({:.1} coarser than the band)",
+            c.name,
+            all as f64 / tiles as f64,
+            seen as f64 / tiles as f64,
+            coarse as f64 / tiles as f64
+        );
+        eprintln!("     off the band (zoom less the band, kind): {:?}", by.iter().map(|(k, v)| (k, v / tiles)).collect::<Vec<_>>());
+    }
+}
