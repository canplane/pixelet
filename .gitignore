# General OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# pnpm
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# # TypeScript build outputs (Project References)
# # 1. Hide JS & Maps: Only within src and only when TS exists
# **/src/**/*.js
# **/src/**/*.js.map

# # 2. Hide Generated Declarations: Target src to preserve root @types
# # This ensures auto-generated artifacts in src are ignored while manual types remain.
# **/src/**/*.d.ts
# **/src/**/*.d.ts.map

# # 4. Global cleanups: Infrastructure & Build artifacts
# # Consolidating build outputs and workspace caches
# *.tsbuildinfo
# dist/
# .turbo/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# AI coding tools
# Assistant-specific directories stay untracked: the committed, vendor-neutral
# content lives in AGENTS.md and .agents/, and these are expected to be local
# symlinks into it.
# NOTE: git has no inline comments in .gitignore — a trailing `# ...` becomes
# part of the pattern, so these must each sit on their own line.
.claude/
.cursor/
.windsurf/
.codex/
.continue/
.aider*

# Personal, uncommitted variants of shared agent content
.agents/skills/.local/
.agents/**/*.local.md

# Rust workspace build output
/target
/crates/target

# The guest's module, built from crates/ by apps/web/script/build-wasm.ts
apps/web/src/kernel/guest.wasm
apps/web/src/kernel/guest.paths.json

# The last build number this checkout published (apps/web/script/deploy.ts)
apps/web/.build_number

# Backup files sometimes created by rustfmt/editor tooling
**/*.rs.bk

# What a tool fetches for itself from where it surely stays, fetched again by running it.
asset/raw/sky/

# A bake set kept beside the current one while the new one is made: `out` is
# already ignored, and this is the same thing with a number on it.
out[0-9]*/

# wrangler's local scratch: its simulated R2/KV, build state and temporaries.
apps/web/.wrangler/

# What a device posts to the dev server's /__console, for reading with tail.
apps/web/.dev-console.log

# Expo's per-machine state for the device app: the dev server's settings and
# the types it generates.
apps/native/.expo/

# A standalone WebGPU repro page is dev-only and not part of the app.
apps/web/public/repro-*.html

# What `expo prebuild` generates, which is made again from app.json and the
# modules rather than kept, and what the platform module's own Gradle build
# leaves beside it.
apps/native/modules/platform/android/build/
apps/native/modules/platform/android/.gradle/
apps/native/ios/
apps/native/android/
