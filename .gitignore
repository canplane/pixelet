# General OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# pnpm
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# # TypeScript build outputs (Project References)
# # 1. Hide JS & Maps: Only within src and only when TS exists
# **/src/**/*.js
# **/src/**/*.js.map

# # 2. Hide Generated Declarations: Target src to preserve root @types
# # This ensures auto-generated artifacts in src are ignored while manual types remain.
# **/src/**/*.d.ts
# **/src/**/*.d.ts.map

# # 4. Global cleanups: Infrastructure & Build artifacts
# # Consolidating build outputs and workspace caches
# *.tsbuildinfo
# dist/
# .turbo/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# AI coding tools
# Assistant-specific directories stay untracked: the committed, vendor-neutral
# content lives in AGENTS.md and .agents/, and these are expected to be local
# symlinks into it.
# NOTE: git has no inline comments in .gitignore — a trailing `# ...` becomes
# part of the pattern, so these must each sit on their own line.
.cursor/
.windsurf/
.codex/
.continue/
.aider*

# .claude is a link to .agents: only the agent files and the skills are
# committed, and what the tool writes there stays local.
.agents/*
!.agents/agents/
!.agents/skills/

# Personal, uncommitted variants of shared agent content
.agents/skills/.local/
.agents/**/*.local.md

# Rust workspace build output
/rust/target

# Scratch: notes, diffs and logs a session keeps while it works.
/tmp/

# The core's module, built from rust/ by ts/client/script/wasm-build.py, and
# the page's template made from ts/client/index.html (ts/client/script/web.ts).
ts/client/public/core.wasm
ts/client/public/index.html
ts/client/core.paths.json
# The page's icons and link preview, made from ts/client/brand by each web
# build (pxl-tool/bin/brand.rs).
ts/client/public/brand/


# Backup files sometimes created by rustfmt/editor tooling
**/*.rs.bk

# What a tool fetches for itself from where it surely stays, fetched again by running it.
asset/raw/sky/

# A bake set kept beside the current one while the new one is made: `out` is
# already ignored, and this is the same thing with a number on it.
out[0-9]*/

# Temporary folders (AGENTS.md).
/cache/

# The number the deployment serves (script/build-number.py), which a dev build of either app is labeled after
ts/client/.build_number

# wrangler's local scratch: its simulated R2/KV, build state and temporaries.
.wrangler/
# The page's bundle, staged beside the Worker that serves it (script/deploy.py).
ts/server/edge/dist/

# What a device posts to the dev server's /__console, for reading with tail.
ts/client/.dev-console.log

# Expo's per-machine state for the app: the dev server's settings, the types
# it generates and the build stamp (metro.config.ts).
ts/client/.expo/

# A standalone WebGPU repro page is dev-only and not part of the app.
ts/client/public/repro-*.html

# What `expo prebuild` generates, which is made again from app.config.ts and the
# modules rather than kept, and what the platform module's own Gradle build
# leaves beside it.
ts/client/modules/platform/android/build/
ts/client/modules/platform/android/.gradle/
ts/client/ios/
ts/client/android/

# What Python compiles of a script it imports.
__pycache__/
