{
  "name": "@pixelet/shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "./index.ts",
  "exports": {
    "./*": "./src/*.ts"
  },
  "files": [
    "index.ts",
    "src",
    "@types"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "clean": "tsc -b --clean && rimraf dist *.tsbuildinfo node_modules/.cache",
    "typecheck": "tsc --noEmit",
    "predev": "pnpm run clean",
    "dev": "tsc -b -w",
    "prebuild": "pnpm run clean",
    "build": "tsc -b"
  },
  "devDependencies": {
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@tensorflow/tfjs-core": "^4.22.0"
  }
}
