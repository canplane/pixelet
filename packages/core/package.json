{
  "name": "@pixelet/core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "./index.ts",
  "exports": {
    "./*": "./src/*.ts"
  },
  "files": [
    "src",
    "@types"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "clean": "tsc -b --clean && rimraf dist *.tsbuildinfo node_modules/.cache",
    "typecheck": "tsc --noEmit",
    "predev": "pnpm run clean",
    "dev": "tsc -b -w",
    "prebuild": "pnpm run clean",
    "build": "tsc -b"
  },
  "dependencies": {
    "@tensorflow/tfjs-core": "^4.22.0",
    "i18next": "^25.7.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-i18next": ">=16"
  },
  "devDependencies": {
    "react": "^19.2.0",
    "react-i18next": "^16.5.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  }
}
