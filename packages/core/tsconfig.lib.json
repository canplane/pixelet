{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* 프로젝트 빌드 및 증분 컴파일 최적화 */
    "composite": true, // 타 프로젝트(web, api)가 참조할 수 있도록 설정
    "incremental": true, // 변경된 부분만 빌드하여 타입 체크 및 빌드 속도 향상
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo", // 증분 빌드 캐시 정보 저장 경로

    /* 런타임 환경 및 언어 사양 */
    "target": "ES2022", // Node.js(Server) 및 Browser(Web) 공통 지원을 위한 타겟
    "lib": ["ES2022", "DOM", "DOM.Iterable"], // 서버/클라이언트 공통 API(fetch, URL 등) 타입 포함
    "useDefineForClassFields": true, // 클래스 필드 초기화 방식을 최신 표준 사양으로 고정
    "module": "ESNext", // 최신 ESM(Import/Export) 시스템 사용
    "moduleResolution": "bundler", // 최신 번들러 및 Node.js 환경에 최적화된 모듈 해석
    "moduleDetection": "force", // 모든 파일을 독립된 모듈로 간주하여 전역 오염 방지

    /* 타입 정의 파일 생성 및 IDE 지원 (Project References 필수) */
    "declaration": true, // 타 프로젝트 참조용 .d.ts 타입 선언 파일 생성
    "declarationMap": true, // IDE에서 타입 클릭 시 원본 소스(.ts)로 이동 가능하게 지원
    "rootDir": "src", // 소스의 뿌리를 src로 고정
    "outDir": "dist",
    "noEmit": false, // composite 모드에서는 선언 파일 출력을 위해 false여야 함

    /* 엄격한 타입 검사 및 린팅 규칙 */
    "skipLibCheck": true, // node_modules 내 외부 라이브러리의 타입 검사 생략

    /* 경로 별칭 (Path Alias) */
    "baseUrl": "."
  },
  "include": ["src", "@types"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.spec.ts" // 테스트 파일 제외
  ]
}
